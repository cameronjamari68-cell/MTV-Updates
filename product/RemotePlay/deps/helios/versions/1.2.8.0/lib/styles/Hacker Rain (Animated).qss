/* =============================================================================
   Hacker Rain (Animated) Theme
   Animated phosphor-green digital rain on black terminal glass.
   ============================================================================= */
/* @token content-padding: 12 */
/* @token wallpaper: assets/hacker_rain_motion.gif */
/* @token wallpaper-mode: fill */
/* @token glass: dark */
/* @token icon-color: #00ff00 */
/* @token selection-icon-color: #ffffff */
/* @token active-icon-color: #00ff00 */
/* @token error-icon-color: #ff0000 */

QLabel[logLevel="debug"] { color: #00a000; }
QLabel[logLevel="info"] { color: #00dd00; }
QLabel[logLevel="warning"] { color: #f59e0b; font-weight: 600; }
QLabel[logLevel="error"] { color: #ff0000; font-weight: 600; }
QLabel[logLevel="critical"] { color: #ff0000; font-weight: 700; }
/* =============================================================================
   Global
   ============================================================================= */
QWidget {
    background-color: #000000;
    color: #00ff00;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 9pt;
}QWidget:disabled {
    color: #007700;
}QWidget:focus {
    outline: none;
}QDialog {
    background-color: #000000;
    color: #00ff00;
}QWidget#loadingScreen {
    background: transparent;
    border: none;
}QFrame#loadingFrame {
    background-color: #0a0a0a;
    border: 1px solid #00ff00;
    border-radius: 16px;
}QLabel,
QCheckBox,
QRadioButton {
    background-color: transparent;
}/* =============================================================================
   Main Window
   ============================================================================= */
QMainWindow {
    background-color: #000000;
}QMainWindow::separator {
    background: #000000;
    width: 5px;
    height: 5px;
}QMainWindow::separator:hover {
    background: #005500;
}QSplitter::handle {
    background-color: #000000;
}QSplitter::handle:hover {
    background-color: #005500;
}/* =============================================================================
   Dock Widgets
   ============================================================================= */
QDockWidget {
    background-color: #000000;
    border: 1px solid #00ff00;
    border-radius: 8px;
    titlebar-close-icon: url(:/icons/close.svg);
    titlebar-normal-icon: url(:/icons/float.svg);
}QDockWidget[panelDock="true"] {
    background-color: #0a0a0a;
    border-color: #00ff00;
}QDockWidget::title {
    background-color: #0a0a0a;
    color: #00ff00;
    padding: 5px 8px;
    font-weight: 600;
    border-bottom: 1px solid #00ff00;
}QWidget#dockTitleBar {
    background-color: #0a0a0a;
    border-bottom: 1px solid #00ff00;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
}QLabel#dockTitleLabel {
    background-color: transparent;
    color: #00ff00;
    font-weight: 600;
    background: transparent;
}QToolButton#dockFloatButton,
QToolButton#dockCloseButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 1px;
    background: transparent;
}QToolButton#dockFloatButton:hover,
QToolButton#dockCloseButton:hover {
    background-color: #003300;
    color: #00ff00;
}QToolButton#dockFloatButton:pressed,
QToolButton#dockCloseButton:pressed {
    background-color: #005500;
}QDockWidget::close-button,
QDockWidget::float-button {
    background-color: transparent;
    border-radius: 4px;
    padding: 2px;
}QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #005500;
}/* =============================================================================
   Menus and Toolbars
   ============================================================================= */
QMenuBar {
    background-color: #0a0a0a;
    padding: 2px;
    border-bottom: 1px solid #00ff00;
}QMenuBar::item {
    padding: 4px 8px;
    background: transparent;
    border-radius: 4px;
}QMenuBar::item:selected {
    background-color: #005500;
    color: #00ff00;
}QMenuBar::item:pressed {
    background-color: #005500;
    color: white;
}QMenu {
    background-color: #0a0a0a;
    border: 1px solid #00ff00;
    border-radius: 6px;
    padding: 4px;
}QMenu[glassMenu="true"] {
    background-color: rgba(0, 0, 0, 93);
}QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
}QMenu::item:selected {
    background-color: #005500;
    color: #ffffff;
}QMenu::item:pressed {
    background-color: #00ff00;
    color: #000000;
}QMenu::item:disabled {
    background-color: transparent;
    color: #007700;
}QMenu::item:checked {
    color: #00ff00;
    font-weight: 600;
}QMenu::separator {
    height: 1px;
    background-color: #00ff00;
    margin: 3px 8px;
}QToolBar {
    background-color: #0a0a0a;
    border: none;
    border-bottom: 1px solid #00ff00;
    padding: 3px;
    spacing: 3px;
}QToolBar::separator {
    background-color: #00ff00;
    width: 1px;
    height: 1px;
    margin: 4px;
}QToolButton {
    background-color: transparent;
    border-radius: 4px;
    padding: 6px 6px;
    color: #ffffff;
}QToolButton:hover {
    background-color: #003300;
    color: #ffffff;
}QToolButton:pressed {
    background-color: #005500;
    color: #ffffff;
}QToolButton:checked {
    background-color: #005500;
    color: #ffffff;
    border: 1px solid #00ff00;
}QToolButton:checked:hover {
    background-color: #005500;
    color: #ffffff;
}QToolButton:checked:pressed {
    background-color: #00ff00;
    color: #000000;
}QToolButton:disabled {
    background-color: transparent;
    color: #007700;
}/* =============================================================================
   Category Bar
   ============================================================================= */
QToolBar#activityBar {
    padding: 8px 6px;
    spacing: 8px;
    background-color: #000000;
    border: none;
}QToolBar#activityBar QToolButton {
    border-radius: 4px;
    padding: 7px 8px;
    min-width: 68px;
    min-height: 40px;
    background: transparent;
    color: #ffffff;
}QToolBar#activityBar QToolButton:hover {
    background-color: #003300;
    color: #ffffff;
}QToolBar#activityBar QToolButton:checked {
    background-color: #005500;
    color: #ffffff;
    border: 1px solid #00ff00;
}QToolBar#activityBar QToolButton:checked:hover {
    background-color: #005500;
    color: #ffffff;
}QToolBar#activityBar QToolButton[statusPlaceholder="true"] {
    background-color: #0a0a0a;
    color: #00cc00;
    border: 1px solid #007700;
}QToolBar#activityBar QToolButton[statusPlaceholder="true"]:hover {
    background-color: rgba(57, 60, 65, 220);
    color: #00ff00;
}QToolBar#activityBar QToolButton[statusPlaceholder="true"]::menu-indicator {
    image: none;
}/* =============================================================================
   Run Controls
   ============================================================================= */
QToolButton[runControl="start"],
QToolBar#activityBar QToolButton[runControl="start"] {
    background-color: #006400;
    color: #ffffff;
    font-weight: 600;
    border: 1px solid #00ff00;
    border-radius: 4px;
    padding: 0px;
}QToolButton[runControl="start"]:hover,
QToolBar#activityBar QToolButton[runControl="start"]:hover {
    background-color: #008000;
    color: #ffffff;
}QToolButton[runControl="start"]:pressed,
QToolBar#activityBar QToolButton[runControl="start"]:pressed {
    background-color: #004d00;
    color: #ffffff;
}QToolButton[runControl="stop"],
QToolBar#activityBar QToolButton[runControl="stop"] {
    background-color: #b00020;
    border: 1px solid #ff3333;
    border-radius: 4px;
    padding: 0px;
}QToolButton[runControl="stop"]:hover,
QToolBar#activityBar QToolButton[runControl="stop"]:hover {
    background-color: #d00028;
}QToolButton[runControl="stop"]:pressed,
QToolBar#activityBar QToolButton[runControl="stop"]:pressed {
    background-color: #880019;
}QToolButton[runControl]:disabled,
QToolBar#activityBar QToolButton[runControl]:disabled {
    background-color: #002200;
    color: rgba(255, 255, 255, 70);
    border-color: #004400;
}QToolBar#activityBar QToolButton[runGroup="idle"] {
    background-color: #006400;
    color: #ffffff;
    border: 1px solid #00ff00;
}QToolBar#activityBar QToolButton[runGroup="idle"]:hover {
    background-color: #005500;
    color: #ffffff;
}QToolBar#activityBar QToolButton[runGroup="running"] {
    background-color: #b00020;
    color: #ffffff;
    border: 1px solid #ff3333;
}QToolBar#activityBar QToolButton[runGroup="running"]:hover {
    background-color: #d00028;
    color: #ffffff;
}/* =============================================================================
   Buttons
   ============================================================================= */
QPushButton {
    background-color: #000000;
    color: #ffffff;
    border: 1px solid #00ff00;
    border-radius: 4px;
    padding: 4px 12px;
    min-height: 22px;
}QPushButton:hover {
    background-color: #003300;
    border-color: #00ff00;
    color: #ffffff;
}QPushButton:pressed {
    background-color: #005500;
    color: #ffffff;
}QPushButton:checked {
    background-color: #005500;
    color: #ffffff;
    border-color: #00ff00;
}QPushButton:checked:hover {
    background-color: #007700;
    border-color: #00ff00;
    color: #ffffff;
}QPushButton:default,
QPushButton[class="primary"] {
    background-color: #003300;
    color: #ffffff;
}QPushButton:default:hover,
QPushButton[class="primary"]:hover {
    background-color: #005500;
    color: #ffffff;
}QPushButton:default:pressed,
QPushButton[class="primary"]:pressed,
QPushButton:checked:pressed {
    background-color: #00ff00;
    color: #000000;
}QPushButton:disabled {
    background-color: #0a0a0a;
    color: #007700;
}/* =============================================================================
   Inputs
   ============================================================================= */
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #0a0a0a;
    border: 1px solid #00ff00;
    border-radius: 4px;
    padding: 3px 6px;
    selection-background-color: #007700;
    selection-color: white;
    color: #00ff00;
    min-height: 18px;
}QTextEdit#outputLog {
    background-color: #0a0a0a;
    color: #00ff00;
}QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateTimeEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    background-color: #003300;
}QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateTimeEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #b3ffb3;
    padding: 3px 8px;
    background-color: #001500;
}QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QDateTimeEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: #0a0a0a;
    color: #007700;
}QSpinBox::up-button,
QDoubleSpinBox::up-button,
QDateTimeEdit::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button,
QDateTimeEdit::down-button {
    background-color: transparent;
    border: none;
    width: 16px;
}QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QDateTimeEdit::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover,
QDateTimeEdit::down-button:hover {
    background-color: #005500;
}QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow,
QDateTimeEdit::up-arrow {
    image: url(:/icons/spinbox-up-arrow.svg);
    width: 10px;
    height: 10px;
}QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow,
QDateTimeEdit::down-arrow {
    image: url(:/icons/spinbox-down-arrow.svg);
    width: 10px;
    height: 10px;
}/* =============================================================================
   Lists, Trees, and Tables
   ============================================================================= */
QListView,
QTreeView,
QTableView {
    background-color: #0a0a0a;
    border: 1px solid #00ff00;
    border-radius: 4px;
    outline: none;
    alternate-background-color: #0f0f0f;
}QListView:focus,
QTreeView:focus,
QTableView:focus {
    border: 1px solid #b3ffb3;
}QListView::item,
QTreeView::item,
QTableView::item {
    padding: 2px 3px;
    border: none;
    border-radius: 3px;
}QListView::item:hover,
QTreeView::item:hover,
QTableView::item:hover {
    background-color: #005500;
}QListView::item:selected,
QTreeView::item:selected,
QTableView::item:selected {
    background-color: #007700;
    color: #99ff99;
    border-left: 2px solid #00ff00;
}QListView::item:disabled,
QTreeView::item:disabled,
QTableView::item:disabled {
    color: #007700;
}QTableView {
    gridline-color: #00ff00;
}QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/icons/tree-expand.svg);
}QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/icons/tree-collapse.svg);
}QHeaderView::section {
    background-color: #0a0a0a;
    color: #00ff00;
    border: none;
    border-bottom: 1px solid #00ff00;
    padding: 4px;
    font-weight: 600;
    font-size: 8pt;
    border-right: 1px solid #00ff00;
}/* =============================================================================
   Scrollbars
   ============================================================================= */
QScrollBar:vertical {
    background: #0a0a0a;
    width: 10px;
    margin: 0px;
}QScrollBar::handle:vertical {
    background: #005500;
    min-height: 20px;
    border-radius: 5px;
    margin: 2px;
}QScrollBar::handle:vertical:hover {
    background: #007700;
}QScrollBar::handle:vertical:pressed {
    background: #00bb00;
}QScrollBar:horizontal {
    background: #0a0a0a;
    height: 10px;
    margin: 0px;
}QScrollBar::handle:horizontal {
    background: #005500;
    min-width: 20px;
    border-radius: 5px;
    margin: 2px;
}QScrollBar::handle:horizontal:hover {
    background: #007700;
}QScrollBar::handle:horizontal:pressed {
    background: #00bb00;
}QScrollBar::handle:vertical:disabled,
QScrollBar::handle:horizontal:disabled {
    background: #0a0a0a;
}QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}/* =============================================================================
   Tabs
   ============================================================================= */
QTabWidget::pane {
    border: 1px solid #00ff00;
    border-top: none;
    background-color: #0a0a0a;
    border-radius: 0px 0px 4px 4px;
}QTabWidget::tab-bar {
    alignment: left;
}QTabBar::tab {
    background-color: transparent;
    color: #009900;
    border: none;
    padding: 7px 13px;
    margin-right: 2px;
    border-bottom: 2px solid transparent;
    border-radius: 4px 4px 0px 0px;
}QTabBar::tab:hover {
    color: #00aa00;
    background-color: #003300;
}QTabBar::tab:selected {
    color: #00ff00;
    border-bottom: 2px solid #00ff00;
    background-color: #0a0a0a;
}QTabBar::tab:selected:hover {
    background-color: #003300;
}QTabBar::tab:disabled {
    color: #007700;
}/* =============================================================================
   Selection and Progress Controls
   ============================================================================= */
QGroupBox {
    border: 1px solid #00ff00;
    border-radius: 5px;
    margin-top: 22px;
    padding: 4px;
    font-weight: bold;
}QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    margin-bottom: -20px;
    background-color: #000000;
    color: #00ff00;
}QGroupBox::title:disabled {
    color: #007700;
}QCheckBox {
    spacing: 6px;
}QCheckBox::indicator {
    width: 14px;
    height: 14px;
    background-color: #000000;
    border: 1px solid #00ff00;
    border-radius: 3px;
}QCheckBox::indicator:hover {
    border-color: #00cc00;
}QCheckBox::indicator:pressed {
    background-color: #005500;
}QCheckBox::indicator:checked {
    background-color: #00ff00;
    border-color: #33ff33;
    image: url(:/icons/check.svg);
}QCheckBox::indicator:checked:hover {
    background-color: #005500;
    border-color: #005500;
}QCheckBox::indicator:disabled {
    border-color: #004400;
}QCheckBox::indicator:checked:disabled {
    background-color: #002200;
    border-color: #004400;
}QRadioButton {
    spacing: 6px;
}QRadioButton::indicator {
    width: 14px;
    height: 14px;
    background-color: #000000;
    border: 1px solid #00ff00;
    border-radius: 7px;
}QRadioButton::indicator:hover {
    border-color: #00cc00;
}QRadioButton::indicator:pressed {
    background-color: #005500;
}QRadioButton::indicator:checked {
    background-color: #00ff00;
    border-color: #33ff33;
    image: url(:/icons/radio-dot.svg);
}QRadioButton::indicator:checked:hover {
    background-color: #005500;
    border-color: #005500;
}QRadioButton::indicator:disabled {
    border-color: #004400;
}QRadioButton::indicator:checked:disabled {
    background-color: #002200;
    border-color: #004400;
}QSlider::groove:horizontal {
    background: #000000;
    height: 6px;
    border-radius: 3px;
}QSlider::sub-page:horizontal {
    background: #00ff00;
    border-radius: 3px;
}QSlider::handle:horizontal {
    background: white;
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
}QSlider::handle:horizontal:hover {
    background: #00ff00;
    border: 2px solid #00ff00;
}QSlider::groove:vertical {
    background: #000000;
    width: 6px;
    border-radius: 3px;
}QSlider::sub-page:vertical {
    background: #00ff00;
    border-radius: 3px;
}QSlider::handle:vertical {
    background: #ffffff;
    width: 14px;
    height: 14px;
    margin: 0 -4px;
    border-radius: 7px;
}QSlider::handle:vertical:hover {
    background: #ffffff;
    border: 2px solid #00ff00;
}QSlider::groove:horizontal:disabled,
QSlider::groove:vertical:disabled {
    background: #0a0a0a;
}QSlider::handle:horizontal:disabled,
QSlider::handle:vertical:disabled {
    background: #007700;
}QProgressBar {
    background-color: #0a0a0a;
    border: none;
    border-radius: 6px;
    text-align: center;
    color: #00ff00;
}QProgressBar::chunk {
    background-color: #00ff00;
    border-radius: 6px;
}QToolTip {
    background-color: #0a0a0a;
    color: #00ff00;
    border: none;
    border-radius: 6px;
    padding: 5px 8px;
}/* =============================================================================
   Status and Application Chrome
   ============================================================================= */
QLabel[status="active"] {
    color: #00ff00;
    font-weight: bold;
}QLabel[status="loaded"],
QLabel[status="connected"] {
    color: #00ff00;
    font-weight: 600;
}QLabel[status="inactive"] {
    color: #00cc00;
    font-weight: 600;
}QLabel[status="error"] {
    color: #ff0000;
    font-weight: bold;
}QLabel[status="warning"] {
    color: #f59e0b;
    font-weight: bold;
}QLabel[status="info"],
QLabel[status="empty"] {
    color: #00dd00;
    font-size: 7pt;
}QLabel[updateLabelClickable="true"] {
    color: #00ff00;
    font-weight: 600;
}QLabel[updateLabelClickable="true"]:hover {
    color: #005500;
}QStatusBar {
    background-color: #0a0a0a;
    color: #00ff00;
}QWidget#appStatusBar {
    background-color: #0a0a0a;
    color: #00ff00;
}QWidget#appStatusBar QLabel[statusBarLabel="true"] {
    background-color: transparent;
    padding: 2px 4px;
    font-size: 11px;
}QLabel#appMetricsLabel {
    color: #00cc00;
}QListWidget#preferencesCategoryList {
    background-color: transparent;
    border: none;
}QListWidget#preferencesCategoryList::item {
    padding-top: 11px;
    padding-bottom: 11px;
}QListWidget#preferencesCategoryList::item:hover {
    background-color: rgba(0, 255, 0, 30);
}QListWidget#preferencesCategoryList::item:selected {
    background-color: rgba(0, 255, 0, 48);
    color: #00ff00;
    border-left: 3px solid #00ff00;
}QPushButton#preferencesConfirmButton {
    padding-left: 21px;
    padding-right: 21px;
}/* =============================================================================
   Semantic Components
   ============================================================================= */
QLabel[role="heading"] {
    font-size: 13pt;
    font-weight: 600;
    color: #00ff00;
    background: transparent;
}QLabel[role="subheading"] {
    font-size: 10pt;
    font-weight: 600;
    color: #00ff00;
    background: transparent;
}QLabel[role="caption"] {
    font-size: 8pt;
    color: #00cc00;
    background: transparent;
}QLabel[role="muted"] {
    color: #00cc00;
    background: transparent;
}QLabel[accent="true"] {
    color: #00ff00;
    background: transparent;
}QFrame[card="true"],
QLabel[card="true"] {
    background-color: #0a0a0a;
    border: 1px solid #00ff00;
    border-radius: 4px;
}QGroupBox#onlineResourceCard {
    background-color: #0a0a0a;
    border: 1px solid #00ff00;
    border-radius: 12px;
    margin: 0px;
    padding: 0px;
}QGroupBox#onlineResourceCard:hover {
    border-color: #66ff66;
}QGroupBox#onlineResourceCard .QWidget {
    background: transparent;
    border: none;
}QLabel#onlineResourceTitle {
    font-size: 12pt;
    font-weight: 600;
}QLabel[card="true"] {
    padding: 10px;
}QWidget#accountLoginCard {
    background-color: #0a0a0a;
    border: 1px solid #00ff00;
    border-radius: 16px;
}QFrame[card="true"] QLabel {
    background: transparent;
    border: none;
}QLabel[chip="true"] {
    background-color: #003300;
    border-radius: 4px;
    padding: 2px 8px;
    font-weight: 600;
    border: 1px solid #007700;
}QGroupBox[titleless="true"] {
    margin-top: 0px;
    padding-top: 0px;
}QTabWidget[compactTabs="true"]::pane {
    border: 1px solid #00ff00;
    border-radius: 4px;
}QTabWidget[compactTabs="true"] QTabBar::tab {
    padding: 4px 10px;
    font-size: 11px;
    border-radius: 4px 4px 0px 0px;
}QWidget[statusChip] {
    border-radius: 3px;
    font-weight: 600;
}QWidget[statusChip="ok"] {
    background-color: #003300;
    border: 1px solid #00aa00;
}QWidget[statusChip="error"] {
    background-color: #330008;
    border: 1px solid #ff3333;
}QWidget[statusChip="warning"] {
    background-color: #332200;
    border: 1px solid #f59e0b;
}QWidget[statusChip="info"] {
    background-color: #001f00;
    border: 1px solid #00cc00;
}QWidget[statusChip="neutral"] {
    background-color: #111111;
    border: 1px solid #007700;
}QWidget[statusChip] QLabel {
    background: transparent;
    border: none;
}QFrame[class="memory-slot"] {
    background-color: #003300;
    border: 1px solid #00ff00;
    border-radius: 8px;
}QFrame[class="memory-slot"][hasContent="true"] {
    background-color: #0a0a0a;
}QFrame[class="memory-slot"][selected="true"] {
    border: 1px solid #00ff00;
}QLabel#memorySlotNumber {
    font-size: 34px;
    font-weight: 700;
}QLabel[class="script-name"],
QLabel[class="device-name"] {
    color: #00ff00;
    font-weight: 600;
}QLabel[class="script-author"],
QLabel[class="input-translator-name"] {
    color: #00cc00;
}QLabel#memorySlotNumber:disabled,
QLabel[class="script-name"]:disabled,
QLabel[class="script-author"]:disabled,
QLabel[class="input-translator-name"]:disabled {
    color: #007700;
}QPushButton#scriptCardLikeButton {
    background-color: #005500;
    border-radius: 15px;
    padding: 4px 10px;
    color: #00ff00;
}QPushButton#scriptCardLikeButton:hover {
    background-color: #007700;
    color: #00ff00;
}QPushButton#scriptCardLikeButton:checked {
    background-color: #000000;
    color: #00ff00;
    border: 1px solid #00ff00;
}QPushButton#scriptCardDownloadButton,
QPushButton#henvCardInstallButton,
QPushButton#uploadButton {
    background-color: #00ff00;
    color: #000000;
    font-weight: 600;
}QPushButton#scriptCardDownloadButton:hover,
QPushButton#henvCardInstallButton:hover,
QPushButton#uploadButton:hover {
    background-color: #005500;
    color: #ffffff;
}QToolButton#refreshButton {
    min-width: 30px;
    min-height: 30px;
    padding: 4px;
}/* =============================================================================
   Overlays and Glass
   ============================================================================= */
QLabel[overlay="true"] {
    background-color: rgba(0, 0, 0, 185);
    color: #00ff00;
    padding: 2px 8px;
    border-radius: 3px;
    border: 1px solid #00ff00;
}QWidget[overlay="scrim"] {
    background-color: rgba(0, 0, 0, 185);
}QDialog[glassDialog="true"] {
    background-color: rgba(0, 0, 0, 235);
}QDialog[glassDialog="true"] .QWidget,
QDialog[glassDialog="true"] QScrollArea,
QDialog[glassDialog="true"] QStackedWidget,
QDialog[glassDialog="true"] QSplitter,
QDialog[glassDialog="true"] UserAccountWidget,
QDialog[glassDialog="true"] QLabel,
QDialog[glassDialog="true"] QCheckBox,
QDialog[glassDialog="true"] QRadioButton {
    background-color: transparent;
}QDialog[glassDialog="true"] QGroupBox {
    background-color: rgba(0, 20, 0, 170);
}QDialog[glassDialog="true"] QGroupBox::title {
    background-color: transparent;
}QDialog[glassDialog="true"] QTextEdit,
QDialog[glassDialog="true"] QPlainTextEdit,
QDialog[glassDialog="true"] QListWidget,
QDialog[glassDialog="true"] QTreeWidget,
QDialog[glassDialog="true"] QTableWidget {
    background-color: rgba(0, 0, 0, 170);
}/* =============================================================================
   Interaction Contract
   ============================================================================= */
QHeaderView[sortable="true"]::section:hover,
QHeaderView[sortable="true"]::section:pressed {
    background-color: #005500;
    color: #00ff00;
}QSpinBox::up-button:pressed,
QDoubleSpinBox::up-button:pressed,
QDateTimeEdit::up-button:pressed,
QSpinBox::down-button:pressed,
QDoubleSpinBox::down-button:pressed,
QDateTimeEdit::down-button:pressed {
    background-color: #00ff00;
}QSpinBox::up-button:disabled,
QDoubleSpinBox::up-button:disabled,
QDateTimeEdit::up-button:disabled,
QSpinBox::down-button:disabled,
QDoubleSpinBox::down-button:disabled,
QDateTimeEdit::down-button:disabled {
    background-color: transparent;
}QCheckBox:disabled,
QRadioButton:disabled {
    color: #007700;
}QSlider::handle:horizontal:pressed,
QSlider::handle:vertical:pressed {
    background: #00ff00;
    border: 2px solid white;
}QSlider::sub-page:horizontal:disabled,
QSlider::sub-page:vertical:disabled {
    background: #007700;
}QProgressBar:disabled {
    background-color: #0a0a0a;
    color: #007700;
}QProgressBar::chunk:disabled {
    background-color: #007700;
}QPushButton:focus,
QToolButton:focus {
    border: 1px solid #b3ffb3;
}QLineEdit,
QSpinBox,
QDoubleSpinBox,
QTextEdit,
QPlainTextEdit {
    min-height: 18px;
}/* =============================================================================
   Accessibility and Interaction Completion
   ============================================================================= */
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit,
QTextEdit,
QPlainTextEdit {
    padding: 3px 7px;
    border-width: 1px;
}QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateTimeEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateTimeEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QDateTimeEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QLineEdit:read-only,
QSpinBox:read-only,
QDoubleSpinBox:read-only,
QDateTimeEdit:read-only,
QTextEdit:read-only,
QPlainTextEdit:read-only,
QLineEdit:read-only:focus,
QSpinBox:read-only:focus,
QDoubleSpinBox:read-only:focus,
QDateTimeEdit:read-only:focus,
QTextEdit:read-only:focus,
QPlainTextEdit:read-only:focus {
    padding: 3px 7px;
    border-width: 1px;
}QPushButton:disabled,
QToolButton:disabled,
QMenuBar::item:disabled,
QMenu::item:disabled,
QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QDateTimeEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QListView::item:disabled,
QTreeView::item:disabled,
QTableView::item:disabled,
QListWidget::item:disabled,
QTreeWidget::item:disabled,
QTableWidget::item:disabled,
QTabBar::tab:disabled,
QGroupBox::title:disabled,
QCheckBox:disabled,
QRadioButton:disabled,
QProgressBar:disabled {
    color: #007700;
}QLineEdit:read-only,
QSpinBox:read-only,
QDoubleSpinBox:read-only,
QDateTimeEdit:read-only,
QTextEdit:read-only,
QPlainTextEdit:read-only {
    border: 1px solid #007700;
}QLineEdit:read-only:focus,
QSpinBox:read-only:focus,
QDoubleSpinBox:read-only:focus,
QDateTimeEdit:read-only:focus,
QTextEdit:read-only:focus,
QPlainTextEdit:read-only:focus {
    border-color: #00FF00;
}QCheckBox:focus::indicator,
QRadioButton:focus::indicator,
QTabBar::tab:focus {
    border-color: #00FF00;
}QToolBar#activityBar QToolButton:pressed,
QToolBar#activityBar QToolButton:checked:pressed {
    background-color: #005500;
    color: #FFFFFF;
    border-color: #00FF00;
}QToolBar#activityBar QToolButton:disabled,
QToolButton[runControl]:disabled,
QToolBar#activityBar QToolButton[runControl]:disabled {
    background-color: #0A0A0A;
    color: #007700;
    border-color: #007700;
}QPushButton#scriptCardLikeButton:pressed,
QPushButton#scriptCardDownloadButton:pressed,
QPushButton#henvCardInstallButton:pressed,
QPushButton#uploadButton:pressed {
    background-color: #005500;
    color: #FFFFFF;
    border-color: #00FF00;
}QPushButton#scriptCardLikeButton:disabled,
QPushButton#scriptCardDownloadButton:disabled,
QPushButton#henvCardInstallButton:disabled,
QPushButton#uploadButton:disabled {
    background-color: #0A0A0A;
    color: #007700;
    border-color: #007700;
}/* =============================================================================
   HACKER RAIN ANIMATED WALLPAPER LAYER
   Helios paints the GIF behind the main window. These final rules expose that
   layer through structural canvases while keeping controls readable.
   ============================================================================= */
QWidget {
    background-color: transparent;
}QMainWindow,
Helios--DockingAreaWindow,
QMainWindow > QWidget,
Helios--DockingAreaWindow > QWidget,
QMainWindow QStackedWidget,
QMainWindow QScrollArea,
QMainWindow QScrollArea > QWidget > QWidget {
    background-color: transparent;
}QMenuBar,
QStatusBar,
QWidget#appStatusBar,
QToolBar {
    background-color: rgba(0, 0, 0, 220);
}QDockWidget,
QDockWidget[panelDock="true"] {
    background-color: rgba(0, 0, 0, 178);
    border: 1px solid #00A800;
    border-radius: 8px;
}QDockWidget::title,
QWidget#dockTitleBar {
    background-color: rgba(0, 8, 0, 224);
    border-bottom: 1px solid #00A800;
}QGroupBox,
QFrame[card="true"],
QWidget[card="true"],
QFrame[panel="true"],
QWidget[panel="true"],
QFrame[class="memory-slot"],
QWidget#accountLoginCard,
QGroupBox#onlineResourceCard {
    background-color: rgba(0, 7, 0, 176);
    border-color: #008800;
}QTabWidget::pane,
QListView,
QTreeView,
QTableView,
QListWidget,
QTreeWidget,
QTableWidget,
QTextEdit,
QPlainTextEdit {
    background-color: rgba(0, 0, 0, 194);
}QPushButton,
QToolButton,
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit {
    background-color: rgba(0, 12, 0, 218);
}QMenu {
    background-color: rgba(0, 0, 0, 238);
}QTextEdit#outputLog,
QPlainTextEdit#outputLog,
QDockWidget#outputDock QTextEdit,
QDockWidget#outputDock QPlainTextEdit {
    background-color: rgba(0, 0, 0, 208);
}QOpenGLWidget,
QGraphicsView[videoSurface="true"],
QWidget[videoSurface="true"],
QLabel[videoSurface="true"] {
    background-color: #000000;
}

/* =============================================================================
   HELIOS SELECTOR CONTRACT — copied from the final working JAJ selector behavior
   Applied cleanly to Hacker Rain (Animated); previous conflicting ComboBox and managed-popup
   selectors were removed before this block. Theme colors are preserved.
   ============================================================================= */
QFrame[managedSelectorPopup="true"] {
    background-color: rgba(0, 0, 0, 238);
    border: 1px solid #00ff00;
    border-radius: 6px;
    padding: 4px;
}

QTreeView[managedSelectorItems="true"]::item {
    border-radius: 0;
    padding: 2px 4px;
}

QTreeView[managedSelectorItems="true"]::item:hover {
    background-color: #005500;
    color: #33ff33;
}

QTreeView[managedSelectorItems="true"]::item:selected {
    background-color: #007700;
    color: white;
}

QTreeView[managedSelectorItems="true"]::item:disabled {
    color: #007700;
}

QFrame#managedSelectorPopup {
    background-color: rgba(0, 0, 0, 238);
    color: #00ff00;
    border: 1px solid #00ff00;
    border-radius: 8px;
    padding: 0;
}

QTreeView[managedSelectorItems="true"],
QTreeView[managedSelectorItems="true"]:focus {
    background-color: rgba(0, 0, 0, 238);
    color: #00ff00;
    border: none;
    border-radius: 0;
    outline: none;
    padding: 4px;
}

QWidget[managedSelectorActions="true"] {
    background-color: rgba(0, 0, 0, 238);
    color: #00ff00;
    border: none;
}

QFrame[managedSelectorDivider="true"] {
    background-color: #00ff00;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

QWidget[managedSelectorRemoveCell="true"],
QToolButton[managedSelectorRemove="true"],
QToolButton[managedSelectorRemove="true"]:hover,
QToolButton[managedSelectorRemove="true"]:pressed,
QToolButton[managedSelectorRemove="true"]:focus {
    background-color: transparent;
    border: none;
    padding: 0;
}

QComboBox {
    min-width: 60px;
    min-height: 24px;
    padding: 4px 8px;
    background-color: rgba(0, 12, 0, 218);
    color: #00ff00;
    border: 1px solid #007700;
    border-radius: 4px;
    selection-background-color: #00FF00;
    selection-color: white;
}

QComboBox:hover {
    background-color: #004400;
    border: 1px solid #00FF00;
}

QComboBox:on {
    background-color: #003300;
    border: 1px solid #00FF00;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
    background-color: transparent;
}

QComboBox:hover::drop-down,
QComboBox:on::drop-down {
    background-color: #004400;
}

QComboBox::down-arrow,
QComboBox:disabled::down-arrow,
QComboBox:hover::down-arrow,
QComboBox:on::down-arrow,
QComboBox::down-arrow:hover,
QComboBox::down-arrow:on,
QComboBox::down-arrow:open,
QComboBox::down-arrow:pressed {
    image: url(:/icons/arrow-down.svg);
    width: 10px;
    height: 10px;
    background: transparent;
    border: none;
}

QComboBox QAbstractItemView {
    background-color: rgba(0, 0, 0, 238);
    color: #00ff00;
    border: 1px solid #00ff00;
    border-radius: 4px;
    selection-background-color: #007700;
    selection-color: white;
    outline: none;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    padding: 2px 4px;
    border-radius: 3px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #005500;
    color: #33ff33;
}

QComboBox QAbstractItemView::item:disabled {
    color: #007700;
}

QComboBox:disabled {
    background-color: #0a0a0a;
    color: #007700;
    border: 1px solid #007700;
    padding: 4px 8px;
}

QComboBox:disabled::drop-down {
    background-color: transparent;
}

QComboBox:focus {
    border-color: #00FF00;
}

QComboBox:enabled:!hover:!focus:!on {
    background-color: rgba(0, 0, 0, 26);
}

QComboBox:enabled:hover:!on {
    background-color: rgba(0, 0, 0, 51);
}
