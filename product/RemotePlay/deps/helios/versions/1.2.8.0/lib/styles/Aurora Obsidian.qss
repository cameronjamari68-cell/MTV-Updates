QDialog[glassDialog="true"] QListWidget,
QDialog[glassDialog="true"] QTreeWidget,
QDialog[glassDialog="true"] QTableWidget {
    background-color: rgba(11, 17, 27, 205);
}/* Managed menus and selector popups receive the same non-tiling artwork. */
QMenu[glassMenu="true"] {
    background-color: rgba(11, 17, 27, 166);

    border-color: #2FE0D0;
}/* Preferences is Helios::PreferencesDialog and needs an explicit canvas rule.
   QStackedWidget is the reliable inner surface underneath every preference page. */
