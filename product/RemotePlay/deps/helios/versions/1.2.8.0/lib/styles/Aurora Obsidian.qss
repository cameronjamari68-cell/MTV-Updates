}/* HELIOS ROUND COMBO ARROW BUTTON */
/* The drop-down is an independent Qt subcontrol, so it needs its own
   inset geometry and radius instead of inheriting the combo box shape. */
/* HELIOS THEMED POP-OUT GLASS */
/* Helios tags managed dialogs and menus with dynamic glass properties.  The
   translucent SVG supplies one fitted composition; opaque controls stay legible. */
QDialog[glassDialog="true"],
QMessageBox[glassDialog="true"],
QInputDialog[glassDialog="true"],
QColorDialog[glassDialog="true"] {
    background-color: rgba(11, 17, 27, 150);

    color: #D6E4F0;
}QDialog[glassDialog="true"] .QWidget,
