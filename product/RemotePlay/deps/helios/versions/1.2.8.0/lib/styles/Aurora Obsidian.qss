/* =============================================================================
   Aurora Obsidian Theme
   Midnight navy surfaces with teal and violet aurora accents.
   ============================================================================= */
/* @token content-padding: 16 */
/* @token wallpaper: assets/aurora_obsidian.svg */
/* @token wallpaper-mode: fill */
/* @token glass: dark */
/* @token icon-color: #d6e4f0 */
/* @token selection-icon-color: #f8fcff */
/* @token active-icon-color: #2fe0d0 */
/* @token error-icon-color: #ff6f80 */

QLabel[logLevel="debug"] { color: #7890a6; }
QLabel[logLevel="info"] { color: #7890a6; }
QLabel[logLevel="warning"] { color: #eab64d; font-weight: 600; }
QLabel[logLevel="error"] { color: #ff6f80; font-weight: 600; }
QLabel[logLevel="critical"] { color: #ff6f80; font-weight: 700; }
/* =============================================================================
   Global
   ============================================================================= */
QWidget {
    background-color: transparent;
    color: #d6e4f0;
    font-family: "Segoe UI Variable", "Segoe UI", "Roboto", "Helvetica Neue", sans-serif;
    font-size: 9pt;
}QWidget:disabled {
    color: #7890a6;
}QWidget:focus {
    outline: none;
}QDialog {
    background-color: #0b111b;
    color: #d6e4f0;
}QWidget#loadingScreen {
    background: transparent;
    border: none;
}QFrame#loadingFrame {
    background-color: #101927;
    border: 1px solid #38516a;
    border-radius: 18px;
}QLabel,
QCheckBox,
QRadioButton {
    background-color: transparent;
}/* =============================================================================
   Main Window
   ============================================================================= */
QMainWindow {
    background-color: #0b111b;
}QMainWindow::separator {
    background: #070d15;
    width: 5px;
    height: 5px;
}QMainWindow::separator:hover {
    background: #2b4058;
}QSplitter::handle {
    background-color: #0b111b;
}QSplitter::handle:hover {
    background-color: #2b4058;
}/* =============================================================================
   Dock Widgets
   ============================================================================= */
QDockWidget {
    background-color: #101927;
    border: 1px solid #26384b;
    border-radius: 12px;
    titlebar-close-icon: url(:/icons/close.svg);
    titlebar-normal-icon: url(:/icons/float.svg);
}QDockWidget[panelDock="true"] {
    background-color: #101927;
    border-color: #26384b;
}QDockWidget::title {
    background-color: #101927;
    color: #f2f8fc;
    padding: 5px 8px;
    font-weight: 600;
    border-bottom: 1px solid #26384b;
}QWidget#dockTitleBar {
    background-color: #0c1420;
    border-bottom: 1px solid #26384b;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
}QLabel#dockTitleLabel {
    background-color: transparent;
    color: #f2f8fc;
    font-weight: 600;
}QToolButton#dockFloatButton,
QToolButton#dockCloseButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 4px;
}QToolButton#dockFloatButton:hover,
QToolButton#dockCloseButton:hover {
    background-color: #182738;
    color: #f2f8fc;
}QToolButton#dockFloatButton:pressed,
QToolButton#dockCloseButton:pressed {
    background-color: #213349;
}QDockWidget::close-button,
QDockWidget::float-button {
    background-color: transparent;
    border-radius: 8px;
    padding: 2px;
}QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #182738;
}/* =============================================================================
   Menus and Toolbars
   ============================================================================= */
QMenuBar {
    background-color: #070d15;
    padding: 4px;
    border-bottom: 1px solid #26384b;
}QMenuBar::item {
    padding: 4px 8px;
    background: transparent;
    border-radius: 8px;
}QMenuBar::item:selected {
    background-color: #182738;
    color: #f2f8fc;
}QMenuBar::item:pressed {
    background-color: #213349;
    color: #f8fcff;
}QMenu {
    background-color: #101927;
    border: 1px solid #38516a;
    border-radius: 12px;
    padding: 8px;
}QMenu[glassMenu="true"] {
    background-color: rgba(7, 13, 21, 150);
}QMenu::item {
    padding: 8px 28px;
    border-radius: 8px;
}QMenu::item:selected {
    background-color: #164f5d;
    color: #f8fcff;
}QMenu::item:pressed {
    background-color: #126866;
    color: #f8fcff;
}QMenu::item:disabled {
    background-color: transparent;
    color: #7890a6;
}QMenu::item:checked {
    color: #f2f8fc;
    font-weight: 600;
}QMenu::separator {
    height: 1px;
    background-color: #26384b;
    margin: 4px 8px;
}QToolBar {
    background-color: #101927;
    border: none;
    border-bottom: 1px solid #26384b;
    padding: 5px;
    spacing: 5px;
}QToolBar::separator {
    background-color: #26384b;
    width: 1px;
    height: 1px;
    margin: 4px;
}QToolButton {
    background-color: transparent;
    border-radius: 10px;
    padding: 8px 10px;
    color: #f8fcff;
}QToolButton:hover {
    background-color: #182738;
    color: #f8fcff;
}QToolButton:pressed {
    background-color: #213349;
    color: #f8fcff;
}QToolButton:checked {
    background-color: #213349;
    color: #f8fcff;
}QToolButton:checked:hover {
    background-color: #2b4058;
    color: #f8fcff;
}QToolButton:checked:pressed {
    background-color: #177b78;
    color: #f8fcff;
}QToolButton:disabled {
    background-color: transparent;
    color: #7890a6;
}/* =============================================================================
   Category Bar
   ============================================================================= */
QToolBar#activityBar {
    padding: 10px 8px;
    spacing: 10px;
}QToolBar#activityBar QToolButton {
    border-radius: 12px;
    padding: 7px 8px;
    min-width: 68px;
    min-height: 40px;
    color: #f8fcff;
}QToolBar#activityBar QToolButton:hover {
    background-color: #182738;
    color: #f8fcff;
}QToolBar#activityBar QToolButton:checked {
    background-color: #213349;
    color: #f8fcff;
    border-bottom: 2px solid #2fe0d0;
}QToolBar#activityBar QToolButton:checked:hover {
    background-color: #2b4058;
    color: #f8fcff;
}QToolBar#activityBar QToolButton[statusPlaceholder="true"] {
    background-color: rgba(7, 13, 21, 210);
    color: #8ea5b8;
    border: 1px solid #26384b;
}QToolBar#activityBar QToolButton[statusPlaceholder="true"]:hover {
    background-color: rgba(24, 39, 56, 230);
    color: #d6e4f0;
}QToolBar#activityBar QToolButton[statusPlaceholder="true"]::menu-indicator {
    image: none;
}/* =============================================================================
   Run Controls
   ============================================================================= */
QToolButton[runControl="start"],
QToolBar#activityBar QToolButton[runControl="start"] {
    background-color: #237a55;
    color: #f8fcff;
    font-weight: 600;
    border: none;
    border-radius: 12px;
    padding: 0px;
}QToolButton[runControl="start"]:hover,
QToolBar#activityBar QToolButton[runControl="start"]:hover {
    background-color: #1d6747;
    color: #f8fcff;
}QToolButton[runControl="start"]:pressed,
QToolBar#activityBar QToolButton[runControl="start"]:pressed {
    background-color: #17533a;
    color: #f8fcff;
}QToolButton[runControl="stop"],
QToolBar#activityBar QToolButton[runControl="stop"] {
    background-color: #c84659;
    border: none;
    border-radius: 12px;
    padding: 0px;
}QToolButton[runControl="stop"]:hover,
QToolBar#activityBar QToolButton[runControl="stop"]:hover {
    background-color: #a73548;
}QToolButton[runControl="stop"]:pressed,
QToolBar#activityBar QToolButton[runControl="stop"]:pressed {
    background-color: #84293a;
}QToolButton[runControl]:disabled,
QToolBar#activityBar QToolButton[runControl]:disabled {
    background-color: rgba(42, 58, 76, 80);
    color: rgba(248, 252, 255, 75);
}QToolBar#activityBar QToolButton[runGroup="idle"] {
    background-color: #237a55;
    color: #f8fcff;
    border: none;
}QToolBar#activityBar QToolButton[runGroup="idle"]:hover {
    background-color: #1d6747;
    color: #f8fcff;
}QToolBar#activityBar QToolButton[runGroup="running"] {
    background-color: #c84659;
    color: #f8fcff;
    border: none;
}QToolBar#activityBar QToolButton[runGroup="running"]:hover {
    background-color: #a73548;
    color: #f8fcff;
}/* =============================================================================
   Buttons
   ============================================================================= */
QPushButton {
    background-color: #2a3a4c;
    color: #f8fcff;
    border: 1px solid #38516a;
    border-radius: 12px;
    padding: 8px 16px;
    min-height: 24px;
}QPushButton:hover {
    background-color: #354a60;
    border-color: #4b6985;
    color: #f8fcff;
}QPushButton:pressed {
    background-color: #26384b;
    color: #f8fcff;
}QPushButton:checked {
    background-color: #177b78;
    color: #f8fcff;
    border-color: #2fe0d0;
}QPushButton:checked:hover {
    background-color: #126866;
    color: #f8fcff;
}QPushButton:default,
QPushButton[class="primary"] {
    background-color: #177b78;
    color: #f8fcff;
    border-color: #2fe0d0;
}QPushButton:default:hover,
QPushButton[class="primary"]:hover {
    background-color: #126866;
    color: #f8fcff;
}QPushButton:default:pressed,
QPushButton[class="primary"]:pressed,
QPushButton:checked:pressed {
    background-color: #0d5352;
    color: #f8fcff;
}QPushButton:disabled {
    background-color: #162230;
    color: #7890a6;
    border-color: #26384b;
}/* =============================================================================
   Inputs
   ============================================================================= */
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #070d15;
    border: 1px solid #26384b;
    border-radius: 12px;
    padding: 6px 10px;
    selection-background-color: #177b78;
    selection-color: #f8fcff;
    color: #d6e4f0;
    min-height: 20px;
}QTextEdit#outputLog {
    background-color: #070d15;
    color: #d6e4f0;
}QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateTimeEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    background-color: #0c1420;
    border-color: #38516a;
}QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateTimeEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #a78bfa;
    padding: 6px 10px;
}QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QDateTimeEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: #162230;
    color: #7890a6;
    border-color: #26384b;
}QSpinBox::up-button,
QDoubleSpinBox::up-button,
QDateTimeEdit::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button,
QDateTimeEdit::down-button {
    background-color: transparent;
    border: none;
    width: 16px;
}QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QDateTimeEdit::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover,
QDateTimeEdit::down-button:hover {
    background-color: #182738;
}QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow,
QDateTimeEdit::up-arrow {
    image: url(:/icons/spinbox-up-arrow.svg);
    width: 10px;
    height: 10px;
}QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow,
QDateTimeEdit::down-arrow {
    image: url(:/icons/spinbox-down-arrow.svg);
    width: 10px;
    height: 10px;
}/* =============================================================================
   Lists, Trees, and Tables
   ============================================================================= */
QListView,
QTreeView,
QTableView {
    background-color: #101927;
    border: 1px solid #26384b;
    border-radius: 12px;
    outline: none;
    alternate-background-color: #0b111b;
}QListView:focus,
QTreeView:focus,
QTableView:focus {
    border: 1px solid #a78bfa;
}QListView::item,
QTreeView::item,
QTableView::item {
    padding: 5px 7px;
    border: none;
    border-radius: 8px;
}QListView::item:hover,
QTreeView::item:hover,
QTableView::item:hover {
    background-color: #182738;
}QListView::item:selected,
QTreeView::item:selected,
QTableView::item:selected {
    background-color: #183d4d;
    color: #f8fcff;
}QListView::item:disabled,
QTreeView::item:disabled,
QTableView::item:disabled {
    color: #7890a6;
}QTableView {
    gridline-color: #26384b;
}QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/icons/tree-expand.svg);
}QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/icons/tree-collapse.svg);
}QHeaderView::section {
    background-color: #0c1420;
    color: #8ea5b8;
    border: none;
    border-bottom: 1px solid #38516a;
    padding: 6px;
    font-weight: 600;
    font-size: 8pt;
}/* =============================================================================
   Scrollbars
   ============================================================================= */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}QScrollBar::handle:vertical {
    background: rgba(112, 134, 154, 95);
    min-height: 20px;
    border-radius: 5px;
    margin: 2px;
}QScrollBar::handle:vertical:hover {
    background: rgba(112, 134, 154, 150);
}QScrollBar::handle:vertical:pressed {
    background: #b8fff8;
}QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0px;
}QScrollBar::handle:horizontal {
    background: rgba(112, 134, 154, 95);
    min-width: 20px;
    border-radius: 5px;
    margin: 2px;
}QScrollBar::handle:horizontal:hover {
    background: rgba(112, 134, 154, 150);
}QScrollBar::handle:horizontal:pressed {
    background: #b8fff8;
}QScrollBar::handle:vertical:disabled,
QScrollBar::handle:horizontal:disabled {
    background: rgba(112, 134, 154, 45);
}QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}/* =============================================================================
   Tabs
   ============================================================================= */
QTabWidget::pane {
    border: 1px solid #26384b;
    border-top: 1px solid #38516a;
    background-color: #101927;
}QTabWidget::tab-bar {
    alignment: left;
}QTabBar::tab {
    background-color: transparent;
    color: #8ea5b8;
    border: none;
    padding: 9px 16px;
    margin-right: 2px;
    border-bottom: 2px solid transparent;
}QTabBar::tab:hover {
    color: #d6e4f0;
    background-color: #182738;
}QTabBar::tab:selected {
    color: #f2f8fc;
    border-bottom: 2px solid #2fe0d0;
    background-color: #101927;
}QTabBar::tab:selected:hover {
    background-color: #182738;
}QTabBar::tab:disabled {
    color: #7890a6;
}/* =============================================================================
   Selection and Progress Controls
   ============================================================================= */
QGroupBox {
    border: 1px solid #38516a;
    border-radius: 12px;
    margin-top: 22px;
    padding: 4px;
    font-weight: bold;
}QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    margin-bottom: -20px;
    background-color: #101927;
    color: #f2f8fc;
}QGroupBox::title:disabled {
    color: #7890a6;
}QCheckBox {
    spacing: 6px;
}QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: transparent;
    border: 1px solid #70869a;
    border-radius: 8px;
}QCheckBox::indicator:hover {
    border-color: #aec3d4;
}QCheckBox::indicator:pressed {
    background-color: #213349;
}QCheckBox::indicator:checked {
    background-color: #177b78;
    border-color: #177b78;
    image: url(:/icons/check.svg);
}QCheckBox::indicator:checked:hover {
    background-color: #126866;
    border-color: #126866;
}QCheckBox::indicator:disabled {
    border-color: #2a3a4c;
}QCheckBox::indicator:checked:disabled {
    background-color: #2a3a4c;
    border-color: #2a3a4c;
}QRadioButton {
    spacing: 6px;
}QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background-color: transparent;
    border: 1px solid #70869a;
    border-radius: 9px;
}QRadioButton::indicator:hover {
    border-color: #aec3d4;
}QRadioButton::indicator:pressed {
    background-color: #213349;
}QRadioButton::indicator:checked {
    background-color: #177b78;
    border-color: #177b78;
    image: url(:/icons/radio-dot.svg);
}QRadioButton::indicator:checked:hover {
    background-color: #126866;
    border-color: #126866;
}QRadioButton::indicator:disabled {
    border-color: #2a3a4c;
}QRadioButton::indicator:checked:disabled {
    background-color: #2a3a4c;
    border-color: #2a3a4c;
}QSlider::groove:horizontal {
    background: #2a3a4c;
    height: 6px;
    border-radius: 5px;
}QSlider::sub-page:horizontal {
    background: #177b78;
    border-radius: 5px;
}QSlider::handle:horizontal {
    background: #f8fcff;
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 11px;
}QSlider::handle:horizontal:hover {
    background: #f2f8fc;
    border: 2px solid #177b78;
}QSlider::groove:vertical {
    background: #2a3a4c;
    width: 6px;
    border-radius: 5px;
}QSlider::sub-page:vertical {
    background: #177b78;
    border-radius: 5px;
}QSlider::handle:vertical {
    background: #f2f8fc;
    width: 14px;
    height: 14px;
    margin: 0 -4px;
    border-radius: 11px;
}QSlider::handle:vertical:hover {
    background: #f2f8fc;
    border: 2px solid #177b78;
}QSlider::groove:horizontal:disabled,
QSlider::groove:vertical:disabled {
    background: #162230;
}QSlider::handle:horizontal:disabled,
QSlider::handle:vertical:disabled {
    background: #7890a6;
}QProgressBar {
    background-color: #070d15;
    border: none;
    border-radius: 10px;
    text-align: center;
    color: #f2f8fc;
}QProgressBar::chunk {
    background-color: #177b78;
    border-radius: 10px;
}QToolTip {
    background-color: #05090f;
    color: #d6e4f0;
    border: 1px solid #38516a;
    border-radius: 10px;
    padding: 5px 8px;
}/* =============================================================================
   Status and Application Chrome
   ============================================================================= */
QLabel[status="active"] {
    color: #45d69b;
    font-weight: bold;
}QLabel[status="loaded"],
QLabel[status="connected"] {
    color: #45d69b;
    font-weight: 600;
}QLabel[status="inactive"] {
    color: #8ea5b8;
    font-weight: 600;
}QLabel[status="error"] {
    color: #ff6f80;
    font-weight: bold;
}QLabel[status="warning"] {
    color: #eab64d;
    font-weight: bold;
}QLabel[status="info"],
QLabel[status="empty"] {
    color: #8ea5b8;
    font-size: 7pt;
}QLabel[updateLabelClickable="true"] {
    color: #49ded4;
    font-weight: 600;
}QLabel[updateLabelClickable="true"]:hover {
    color: #a78bfa;
}QStatusBar {
    background-color: #070d15;
    color: #8ea5b8;
}QWidget#appStatusBar {
    background-color: #070d15;
    color: #8ea5b8;
}QWidget#appStatusBar QLabel[statusBarLabel="true"] {
    background-color: transparent;
    padding: 2px 4px;
    font-size: 11px;
}QLabel#appMetricsLabel {
    color: #8ea5b8;
}QListWidget#preferencesCategoryList {
    background-color: transparent;
    border: none;
}QListWidget#preferencesCategoryList::item {
    padding-top: 11px;
    padding-bottom: 11px;
}QListWidget#preferencesCategoryList::item:hover {
    background-color: rgba(248, 252, 255, 22);
}QListWidget#preferencesCategoryList::item:selected {
    background-color: rgba(33, 184, 177, 52);
    color: #f2f8fc;
    border-left: 3px solid #177b78;
}QPushButton#preferencesConfirmButton {
    padding-left: 21px;
    padding-right: 21px;
}/* =============================================================================
   Semantic Components
   ============================================================================= */
QLabel[role="heading"] {
    font-size: 13pt;
    font-weight: 600;
    color: #f2f8fc;
    background: transparent;
}QLabel[role="subheading"] {
    font-size: 10pt;
    font-weight: 600;
    color: #f2f8fc;
    background: transparent;
}QLabel[role="caption"] {
    font-size: 8pt;
    color: #8ea5b8;
    background: transparent;
}QLabel[role="muted"] {
    color: #aec3d4;
    background: transparent;
}QLabel[accent="true"] {
    color: #49ded4;
    background: transparent;
}QFrame[card="true"],
QLabel[card="true"] {
    background-color: #101927;
    border: 1px solid #26384b;
    border-radius: 14px;
}QGroupBox#onlineResourceCard {
    background-color: #101927;
    border: 1px solid #38516a;
    border-radius: 16px;
    margin: 0px;
    padding: 0px;
}QGroupBox#onlineResourceCard:hover {
    border-color: #a78bfa;
}QGroupBox#onlineResourceCard .QWidget {
    background: transparent;
    border: none;
}QLabel#onlineResourceTitle {
    font-size: 12pt;
    font-weight: 600;
}QLabel[card="true"] {
    padding: 10px;
}QWidget#accountLoginCard {
    background-color: #101927;
    border: 1px solid #38516a;
    border-radius: 18px;
}QFrame[card="true"] QLabel {
    background: transparent;
    border: none;
}QLabel[chip="true"] {
    background-color: #213349;
    border-radius: 14px;
    padding: 2px 8px;
    font-weight: 600;
}QGroupBox[titleless="true"] {
    margin-top: 0px;
    padding-top: 0px;
}QTabWidget[compactTabs="true"]::pane {
    border-radius: 0px 0px 6px 6px;
}QTabWidget[compactTabs="true"] QTabBar::tab {
    padding: 4px 10px;
    font-size: 11px;
    border-radius: 10px 6px 0px 0px;
}QWidget[statusChip] {
    border-radius: 12px;
    font-weight: 600;
}QWidget[statusChip="ok"] {
    background-color: rgba(69, 214, 155, 40);
    border: 1px solid rgba(69, 214, 155, 110);
}QWidget[statusChip="error"] {
    background-color: rgba(255, 111, 128, 40);
    border: 1px solid rgba(255, 111, 128, 110);
}QWidget[statusChip="warning"] {
    background-color: rgba(234, 182, 77, 40);
    border: 1px solid rgba(234, 182, 77, 110);
}QWidget[statusChip="info"] {
