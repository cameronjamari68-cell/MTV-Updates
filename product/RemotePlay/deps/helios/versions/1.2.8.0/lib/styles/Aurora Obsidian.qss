}QWidget[statusChip="ok"] QLabel { color: #45d69b; }QWidget[statusChip="error"] QLabel { color: #ff6f80; }QWidget[statusChip="warning"] QLabel { color: #eab64d; }QWidget[statusChip="info"] QLabel { color: #a78bfa; }QWidget[statusChip="neutral"] QLabel { color: #aec3d4; }QFrame[class="memory-slot"] {
    background-color: #0c1420;
