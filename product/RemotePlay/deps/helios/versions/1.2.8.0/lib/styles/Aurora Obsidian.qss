QFrame#loadingFrame {
    border-radius: 11px;
}QTabWidget::pane {
    border-radius: 11px;
}QWidget#dockTitleBar {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}QTabBar::tab {
    border-radius: 9px;
}QGroupBox {
    margin-top: 26px;
    padding-top: 8px;
    padding-right: 6px;
    padding-bottom: 4px;
    padding-left: 6px;
}QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    position: relative;
    top: -6px;
    left: 0;
    margin-left: 6px;
    padding: 0 7px 4px 7px;
    background-color: transparent;
    border: none;
}/* Image/resource cards are titleless and must retain their fitted image geometry. */
QGroupBox#onlineResourceCard {
    margin-top: 0;
    padding-top: 1px;
    padding-right: 2px;
    padding-bottom: 1px;
    padding-left: 1px;
    border-radius: 11px;
}QGroupBox[titleless="true"] {
    margin-top: 0;
    padding-top: 6px;
    border-radius: 11px;
}QGroupBox#onlineResourceCard > QLabel,
