/* =============================================================================
   Charcoal Red Static Theme
   Canonical Helios 1.1.1.7 contract with analog-static charcoal styling.
   ============================================================================= */
/* @token content-padding: 13 */
/* @token wallpaper: assets/charcoal_red_static.svg */
/* @token wallpaper-mode: fill */
/* @token glass: dark */
/* @token icon-color: #e6e1e4 */
/* @token selection-icon-color: #ff9bad */
/* @token active-icon-color: #ff3b5c */
/* @token error-icon-color: #ff5c75 */

QLabel[logLevel="debug"] { color: #9c9298; }
QLabel[logLevel="info"] { color: #9c9298; }
QLabel[logLevel="warning"] { color: #f1b84b; font-weight: 600; }
QLabel[logLevel="error"] { color: #ff5c75; font-weight: 600; }
QLabel[logLevel="critical"] { color: #ff5c75; font-weight: 700; }
/* =============================================================================
   Global
   ============================================================================= */
QWidget {
    background-color: #101014;
    color: #e6e1e4;
    font-family: "Bahnschrift", "Segoe UI Variable", "Segoe UI", sans-serif;
    font-size: 9pt;
}QWidget:disabled {
    color: #9c9298;
}QWidget:focus {
    outline: none;
}QDialog {
    background-color: #101014;
    color: #e6e1e4;
}QWidget#loadingScreen {
    background: transparent;
    border: none;
}QFrame#loadingFrame {
    background-color: #17171c;
    border: 1px solid #66283a;
    border-radius: 10px;
}QLabel,
QCheckBox,
QRadioButton {
    background-color: transparent;
}/* =============================================================================
   Main Window
   ============================================================================= */
QMainWindow {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                      stop:0 #09090c, stop:0.58 #101014, stop:1 #1a1116);
}QMainWindow::separator {
    background: #0b0b0e;
    width: 5px;
    height: 5px;
}QMainWindow::separator:hover {
    background: #ff3b5c;
}QSplitter::handle {
    background-color: #101014;
}QSplitter::handle:hover {
    background-color: #473039;
}/* =============================================================================
   Dock Widgets
   ============================================================================= */
QDockWidget {
    background-color: #17171c;
    border: 1px solid #3d2930;
    border-radius: 7px;
    titlebar-close-icon: url(:/icons/close.svg);
    titlebar-normal-icon: url(:/icons/float.svg);
}QDockWidget[panelDock="true"] {
    background-color: #17171c;
    border-color: #3d2930;
}QDockWidget::title {
    background-color: #17171c;
    color: #fff8fa;
    padding: 5px 8px;
    font-weight: 600;
    border-bottom: 1px solid #66283a;
}QWidget#dockTitleBar {
    background-color: #121217;
    border-bottom: 1px solid #0b0b0e;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
}QLabel#dockTitleLabel {
    background-color: transparent;
    color: #fff8fa;
    font-weight: 600;
}QToolButton#dockFloatButton,
QToolButton#dockCloseButton {
    background-color: transparent;
    border: none;
    border-radius: 5px;
    padding: 4px;
}QToolButton#dockFloatButton:hover,
QToolButton#dockCloseButton:hover {
    background-color: #29232a;
    color: #fff8fa;
}QToolButton#dockFloatButton:pressed,
QToolButton#dockCloseButton:pressed {
    background-color: #35252c;
}QDockWidget::close-button,
QDockWidget::float-button {
    background-color: transparent;
    border-radius: 4px;
    padding: 2px;
}QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #29232a;
}/* =============================================================================
   Menus and Toolbars
   ============================================================================= */
QMenuBar {
    background-color: #09090c;
    padding: 2px;
    border-bottom: 1px solid #3d2930;
}QMenuBar::item {
    padding: 4px 8px;
    background: transparent;
    border-radius: 4px;
}QMenuBar::item:selected {
    background-color: #29232a;
    color: #fff8fa;
}QMenuBar::item:pressed {
    background-color: #35252c;
    color: #ffffff;
}QMenu {
    background-color: #1b1b21;
    border: 1px solid #66283a;
    border-radius: 6px;
    padding: 6px;
}QMenu[glassMenu="true"] {
    background-color: rgba(7, 7, 10, 196);
}QMenu::item {
    padding: 6px 24px;
    border-radius: 3px;
    border-left: 2px solid transparent;
}QMenu::item:selected {
    background-color: #4b1b27;
    color: #ffffff;
    border-left: 2px solid #ff3b5c;
}QMenu::item:pressed {
    background-color: #6b1f31;
    color: #ffffff;
    border-left: 2px solid #ff5a75;
}QMenu::item:disabled {
    background-color: transparent;
    color: #9c9298;
}QMenu::item:checked {
    color: #fff8fa;
    font-weight: 600;
}QMenu::separator {
    height: 1px;
    background-color: #33272c;
    margin: 4px 8px;
}QToolBar {
    background-color: #111116;
    border: none;
    border-bottom: 1px solid #3d2930;
    padding: 3px;
    spacing: 3px;
}QToolBar::separator {
    background-color: #33272c;
    width: 1px;
    height: 1px;
    margin: 4px;
}QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 7px 8px;
    color: #ffffff;
}QToolButton:hover {
    background-color: #302128;
    border-color: #66283a;
    color: #ffffff;
}QToolButton:pressed {
    background-color: #35252c;
    color: #ffffff;
}QToolButton:checked {
    background-color: #4b1b27;
    border-color: #8a2c41;
    color: #ffffff;
}QToolButton:checked:hover {
    background-color: #632033;
    border-color: #ff3b5c;
    color: #ffffff;
}QToolButton:checked:pressed {
    background-color: #c61f3a;
    color: #ffffff;
}QToolButton:disabled {
    background-color: transparent;
    color: #9c9298;
}/* =============================================================================
   Category Bar
   ============================================================================= */
QToolBar#activityBar {
    padding: 8px 6px;
    spacing: 8px;
}QToolBar#activityBar QToolButton {
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 7px 8px;
    min-width: 68px;
    min-height: 40px;
    color: #ffffff;
}QToolBar#activityBar QToolButton:hover {
    background-color: #302128;
    border-color: #66283a;
    color: #ffffff;
}QToolBar#activityBar QToolButton:checked {
    background-color: #3b1d26;
    border: 1px solid #7e2c3e;
    border-bottom: 2px solid #ff3b5c;
    color: #ffffff;
}QToolBar#activityBar QToolButton:checked:hover {
    background-color: #51202d;
    border-color: #a93850;
    border-bottom-color: #ff5a75;
    color: #ffffff;
}QToolBar#activityBar QToolButton[statusPlaceholder="true"] {
    background-color: rgba(11, 11, 14, 210);
    color: #aaa0a6;
    border: 1px solid #33272c;
}QToolBar#activityBar QToolButton[statusPlaceholder="true"]:hover {
    background-color: rgba(41, 35, 42, 232);
    color: #e6e1e4;
}QToolBar#activityBar QToolButton[statusPlaceholder="true"]::menu-indicator {
    image: none;
}/* =============================================================================
   Run Controls
   ============================================================================= */
QToolButton[runControl="start"],
QToolBar#activityBar QToolButton[runControl="start"] {
    background-color: #237c5a;
    color: #ffffff;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    padding: 0px;
}QToolButton[runControl="start"]:hover,
QToolBar#activityBar QToolButton[runControl="start"]:hover {
    background-color: #2f9d73;
    color: #ffffff;
}QToolButton[runControl="start"]:pressed,
QToolBar#activityBar QToolButton[runControl="start"]:pressed {
    background-color: #1a6549;
    color: #ffffff;
}QToolButton[runControl="stop"],
QToolBar#activityBar QToolButton[runControl="stop"] {
    background-color: #d62643;
    border: none;
    border-radius: 8px;
    padding: 0px;
}QToolButton[runControl="stop"]:hover,
QToolBar#activityBar QToolButton[runControl="stop"]:hover {
    background-color: #f04059;
}QToolButton[runControl="stop"]:pressed,
QToolBar#activityBar QToolButton[runControl="stop"]:pressed {
    background-color: #9b152b;
}QToolButton[runControl]:disabled,
QToolBar#activityBar QToolButton[runControl]:disabled {
    background-color: rgba(59, 48, 53, 94);
    color: rgba(255, 248, 250, 76);
}QToolBar#activityBar QToolButton[runGroup="idle"] {
    background-color: #237c5a;
    color: #ffffff;
    border: none;
}QToolBar#activityBar QToolButton[runGroup="idle"]:hover {
    background-color: #2f9d73;
    color: #ffffff;
}QToolBar#activityBar QToolButton[runGroup="running"] {
    background-color: #d62643;
    color: #ffffff;
    border: none;
}QToolBar#activityBar QToolButton[runGroup="running"]:hover {
    background-color: #f04059;
    color: #ffffff;
}/* =============================================================================
   Buttons
   ============================================================================= */
QPushButton {
    background-color: #262126;
    color: #ffffff;
    border: 1px solid #49323a;
    border-radius: 6px;
    padding: 6px 13px;
    min-height: 22px;
}QPushButton:hover {
    background-color: #38252d;
    border-color: #a93850;
    color: #ffffff;
}QPushButton:pressed {
    background-color: #171419;
    border-color: #66283a;
    color: #ffffff;
}QPushButton:checked {
    background-color: #c61f3a;
    color: #ffffff;
    border-color: #ff3b5c;
}QPushButton:checked:hover {
    background-color: #df2d4b;
    color: #ffffff;
    border-color: #ff5a75;
}QPushButton:default,
QPushButton[class="primary"] {
    background-color: #c61f3a;
    color: #ffffff;
    border-color: #ff3b5c;
}QPushButton:default:hover,
QPushButton[class="primary"]:hover {
    background-color: #df2d4b;
    color: #ffffff;
    border-color: #ff5a75;
}QPushButton:default:pressed,
QPushButton[class="primary"]:pressed,
QPushButton:checked:pressed {
    background-color: #94152b;
    color: #ffffff;
    border-color: #c61f3a;
}QPushButton:disabled {
    background-color: #242126;
    color: #9c9298;
}/* =============================================================================
   Inputs
   ============================================================================= */
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #0b0b0e;
    border: 1px solid #3d3035;
    border-radius: 6px;
    padding: 4px 9px;
    selection-background-color: #c61f3a;
    selection-color: #ffffff;
    color: #e6e1e4;
    min-height: 18px;
}QTextEdit#outputLog {
    background-color: #0b0b0e;
    color: #e6e1e4;
}QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateTimeEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    background-color: #181318;
    border-color: #66283a;
}QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateTimeEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #67c7ff;
    padding: 4px 9px;
}QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QDateTimeEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: #242126;
    color: #9c9298;
    border-color: #3d3035;
}QSpinBox::up-button,
QDoubleSpinBox::up-button,
QDateTimeEdit::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button,
QDateTimeEdit::down-button {
    background-color: transparent;
    border: none;
    width: 16px;
}QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QDateTimeEdit::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover,
QDateTimeEdit::down-button:hover {
    background-color: #38212a;
}QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow,
QDateTimeEdit::up-arrow {
    image: url(:/icons/spinbox-up-arrow.svg);
    width: 10px;
    height: 10px;
}QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow,
QDateTimeEdit::down-arrow {
    image: url(:/icons/spinbox-down-arrow.svg);
    width: 10px;
    height: 10px;
}/* =============================================================================
   Lists, Trees, and Tables
   ============================================================================= */
QListView,
QTreeView,
QTableView {
    background-color: #17171c;
    border: 1px solid #3d2930;
    border-radius: 6px;
    outline: none;
    alternate-background-color: #101014;
}QListView:focus,
QTreeView:focus,
QTableView:focus {
    border: 1px solid #67c7ff;
}QListView::item,
QTreeView::item,
QTableView::item {
    padding: 3px 4px;
    border: none;
    border-radius: 4px;
}QListView::item:hover,
QTreeView::item:hover,
QTableView::item:hover {
    background-color: #29232a;
}QListView::item:selected,
QTreeView::item:selected,
QTableView::item:selected {
    background-color: #4b1b27;
    color: #ffffff;
}QListView::item:disabled,
QTreeView::item:disabled,
QTableView::item:disabled {
    color: #9c9298;
}QTableView {
    gridline-color: #33272c;
}QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/icons/tree-expand.svg);
}QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/icons/tree-collapse.svg);
}QHeaderView::section {
    background-color: #17171c;
    color: #aaa0a6;
    border: none;
    border-bottom: 1px solid #66283a;
    padding: 4px;
    font-weight: 600;
    font-size: 8pt;
}/* =============================================================================
   Scrollbars
   ============================================================================= */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}QScrollBar::handle:vertical {
    background: rgba(143, 133, 138, 105);
    min-height: 20px;
    border-radius: 3px;
    margin: 2px;
}QScrollBar::handle:vertical:hover {
    background: rgba(140, 54, 75, 165);
}QScrollBar::handle:vertical:pressed {
    background: rgba(198, 31, 58, 210);
}QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0px;
}QScrollBar::handle:horizontal {
    background: rgba(143, 133, 138, 105);
    min-width: 20px;
    border-radius: 3px;
    margin: 2px;
}QScrollBar::handle:horizontal:hover {
    background: rgba(140, 54, 75, 165);
}QScrollBar::handle:horizontal:pressed {
    background: rgba(198, 31, 58, 210);
}QScrollBar::handle:vertical:disabled,
QScrollBar::handle:horizontal:disabled {
    background: rgba(143, 133, 138, 55);
}QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}/* =============================================================================
   Tabs
   ============================================================================= */
QTabWidget::pane {
    border: none;
    border-top: 1px solid #0b0b0e;
    background-color: #101014;
}QTabWidget::tab-bar {
    alignment: left;
}QTabBar::tab {
    background-color: transparent;
    color: #aaa0a6;
    border: none;
    padding: 7px 13px;
    margin-right: 2px;
    border-bottom: 2px solid transparent;
    border-radius: 5px 5px 0px 0px;
}QTabBar::tab:hover {
    color: #e6e1e4;
    background-color: #302128;
}QTabBar::tab:selected {
    color: #fff8fa;
    border-bottom: 2px solid #ff3b5c;
    background-color: #3b1d26;
}QTabBar::tab:selected:hover {
    background-color: #29232a;
}QTabBar::tab:disabled {
    color: #9c9298;
}/* =============================================================================
   Selection and Progress Controls
   ============================================================================= */
QGroupBox {
    border: 1px solid #4a2933;
    border-radius: 7px;
    margin-top: 22px;
    padding: 4px;
    font-weight: bold;
}QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    margin-bottom: -20px;
    background-color: #101014;
    color: #fff8fa;
}QGroupBox::title:disabled {
    color: #9c9298;
}QCheckBox {
    spacing: 6px;
}QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: transparent;
    border: 1px solid #8f858a;
    border-radius: 5px;
}QCheckBox::indicator:hover {
    border-color: #c8c1c5;
}QCheckBox::indicator:pressed {
    background-color: #35252c;
}QCheckBox::indicator:checked {
    background-color: #c61f3a;
    border-color: #c61f3a;
    image: url(:/icons/check.svg);
}QCheckBox::indicator:checked:hover {
    background-color: #df2d4b;
    border-color: #ff5a75;
}QCheckBox::indicator:disabled {
    border-color: #3b3035;
}QCheckBox::indicator:checked:disabled {
    background-color: #3b3035;
    border-color: #3b3035;
}QRadioButton {
    spacing: 6px;
}QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background-color: transparent;
    border: 1px solid #8f858a;
    border-radius: 9px;
}QRadioButton::indicator:hover {
    border-color: #c8c1c5;
}QRadioButton::indicator:pressed {
    background-color: #35252c;
}QRadioButton::indicator:checked {
    background-color: #c61f3a;
    border-color: #c61f3a;
    image: url(:/icons/radio-dot.svg);
}QRadioButton::indicator:checked:hover {
    background-color: #df2d4b;
    border-color: #ff5a75;
}QRadioButton::indicator:disabled {
    border-color: #3b3035;
}QRadioButton::indicator:checked:disabled {
    background-color: #3b3035;
    border-color: #3b3035;
}QSlider::groove:horizontal {
    background: #3b3035;
    height: 6px;
    border-radius: 3px;
}QSlider::sub-page:horizontal {
    background: #c61f3a;
    border-radius: 3px;
}QSlider::handle:horizontal {
    background: #ffffff;
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
}QSlider::handle:horizontal:hover {
    background: #fff8fa;
    border: 2px solid #ff3b5c;
}QSlider::groove:vertical {
    background: #3b3035;
    width: 6px;
    border-radius: 3px;
}QSlider::sub-page:vertical {
    background: #c61f3a;
    border-radius: 3px;
}QSlider::handle:vertical {
    background: #fff8fa;
    width: 14px;
    height: 14px;
    margin: 0 -4px;
    border-radius: 7px;
}QSlider::handle:vertical:hover {
    background: #fff8fa;
    border: 2px solid #ff3b5c;
}QSlider::groove:horizontal:disabled,
QSlider::groove:vertical:disabled {
    background: #242126;
}QSlider::handle:horizontal:disabled,
QSlider::handle:vertical:disabled {
    background: #9c9298;
}QProgressBar {
    background-color: #0b0b0e;
    border: none;
    border-radius: 6px;
    text-align: center;
    color: #fff8fa;
}QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                      stop:0 #94152b, stop:0.55 #c61f3a, stop:1 #ff3b5c);
    border-radius: 6px;
}QToolTip {
    background-color: #07070a;
    color: #e6e1e4;
    border: 1px solid #66283a;
    border-radius: 6px;
    padding: 5px 8px;
}/* =============================================================================
   Status and Application Chrome
   ============================================================================= */
QLabel[status="active"] {
    color: #48d597;
    font-weight: bold;
}QLabel[status="loaded"],
QLabel[status="connected"] {
    color: #48d597;
    font-weight: 600;
}QLabel[status="inactive"] {
    color: #aaa0a6;
    font-weight: 600;
}QLabel[status="error"] {
    color: #ff5c75;
    font-weight: bold;
}QLabel[status="warning"] {
    color: #f1b84b;
    font-weight: bold;
}QLabel[status="info"],
QLabel[status="empty"] {
    color: #aaa0a6;
    font-size: 7pt;
}QLabel[updateLabelClickable="true"] {
    color: #ff5a75;
    font-weight: 600;
}QLabel[updateLabelClickable="true"]:hover {
    color: #ff8a9e;
}QStatusBar {
    background-color: #09090c;
    color: #aaa0a6;
}QWidget#appStatusBar {
    background-color: #09090c;
    color: #aaa0a6;
}QWidget#appStatusBar QLabel[statusBarLabel="true"] {
    background-color: transparent;
    padding: 2px 4px;
    font-size: 11px;
}QLabel#appMetricsLabel {
    color: #aaa0a6;
}QListWidget#preferencesCategoryList {
    background-color: transparent;
    border: none;
}QListWidget#preferencesCategoryList::item {
    padding-top: 11px;
    padding-bottom: 11px;
}QListWidget#preferencesCategoryList::item:hover {
    background-color: rgba(255, 248, 250, 20);
}QListWidget#preferencesCategoryList::item:selected {
    background-color: rgba(255, 59, 92, 46);
    color: #fff8fa;
    border-left: 3px solid #ff3b5c;
}QPushButton#preferencesConfirmButton {
    padding-left: 21px;
    padding-right: 21px;
}/* =============================================================================
   Semantic Components
   ============================================================================= */
QLabel[role="heading"] {
    font-size: 13pt;
    font-weight: 600;
    color: #fff8fa;
    background: transparent;
}QLabel[role="subheading"] {
    font-size: 10pt;
    font-weight: 600;
    color: #fff8fa;
    background: transparent;
}QLabel[role="caption"] {
    font-size: 8pt;
    color: #aaa0a6;
    background: transparent;
}QLabel[role="muted"] {
    color: #c8c1c5;
    background: transparent;
}QLabel[accent="true"] {
    color: #ff5a75;
    background: transparent;
}QFrame[card="true"],
QLabel[card="true"] {
    background-color: #17171c;
    border: 1px solid #3d2930;
    border-radius: 8px;
}QGroupBox#onlineResourceCard {
    background-color: #17171c;
    border: 1px solid #50343d;
    border-radius: 8px;
    margin: 0px;
    padding: 0px;
}QGroupBox#onlineResourceCard:hover {
    border-color: #ff3b5c;
}QGroupBox#onlineResourceCard .QWidget {
    background: transparent;
    border: none;
}QLabel#onlineResourceTitle {
    font-size: 12pt;
    font-weight: 600;
}QLabel[card="true"] {
    padding: 10px;
}QWidget#accountLoginCard {
    background-color: #17171c;
    border: 1px solid #50343d;
    border-radius: 10px;
}QFrame[card="true"] QLabel {
    background: transparent;
    border: none;
}QLabel[chip="true"] {
    background-color: #35252c;
    border: 1px solid #66283a;
    border-radius: 5px;
    padding: 2px 8px;
    font-weight: 600;
}QGroupBox[titleless="true"] {
    margin-top: 0px;
    padding-top: 0px;
