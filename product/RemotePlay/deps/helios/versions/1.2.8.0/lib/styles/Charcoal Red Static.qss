    border-radius: 11px;
}QWidget#dockTitleBar {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}QTabBar::tab {
    border-radius: 9px;
}QGroupBox {
    margin-top: 26px;
    padding-top: 8px;
    padding-right: 6px;
    padding-bottom: 4px;
    padding-left: 6px;
}QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    position: relative;
    top: -6px;
    left: 0;
    margin-left: 6px;
    padding: 0 7px 4px 7px;
    background-color: transparent;
    border: none;
}/* Image/resource cards are titleless and must retain their fitted image geometry. */
