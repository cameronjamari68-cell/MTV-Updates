/* =============================================================================
   Desert Signal Theme
   Warm espresso, clay, sand, amber, and turquoise Helios theme.
   ============================================================================= */
/* @token content-padding: 12 */
/* @token wallpaper: assets/desert_signal.svg */
/* @token wallpaper-mode: fill */
/* @token glass: dark */
/* @token icon-color: #f1dcc2 */
/* @token selection-icon-color: #55d4c6 */
/* @token active-icon-color: #ed8b3c */
/* @token error-icon-color: #f06b6f */

QLabel[logLevel="debug"] { color: #c0a895; }
QLabel[logLevel="info"] { color: #c0a895; }
QLabel[logLevel="warning"] { color: #f3b54a; font-weight: 600; }
QLabel[logLevel="error"] { color: #f06b6f; font-weight: 600; }
QLabel[logLevel="critical"] { color: #f06b6f; font-weight: 700; }
/* =============================================================================
   Global
   ============================================================================= */
QWidget {
    background-color: #3b2a24;
    color: #f1dcc2;
    font-family: "Segoe UI Variable", "Segoe UI", sans-serif;
    font-size: 9pt;
}QWidget:disabled {
    color: #C0A895;
}QWidget:focus {
    outline: none;
}QDialog {
    background-color: #3b2a24;
    color: #f1dcc2;
}QWidget#loadingScreen {
    background: transparent;
    border: none;
}QFrame#loadingFrame {
    background-color: #4a342c;
    border: none;
    border-radius: 10px;
}QLabel,
QCheckBox,
QRadioButton {
    background-color: transparent;
}/* =============================================================================
   Main Window
   ============================================================================= */
QMainWindow {
    background-color: #3b2a24;
}QMainWindow::separator {
    background: #261b18;
    width: 5px;
    height: 5px;
}QMainWindow::separator:hover {
    background: #ed8b3c;
}QSplitter::handle {
    background-color: #3b2a24;
}QSplitter::handle:hover {
    background-color: #55d4c6;
}/* =============================================================================
   Dock Widgets
   ============================================================================= */
QDockWidget {
    background-color: #4a342c;
    border: 1px solid #745142;
    border-radius: 8px;
    titlebar-close-icon: url(:/icons/close.svg);
    titlebar-normal-icon: url(:/icons/float.svg);
}QDockWidget[panelDock="true"] {
    background-color: #4a342c;
    border-color: #745142;
}QDockWidget::title {
    background-color: #4a342c;
    color: #fff1dd;
    padding: 5px 8px;
    font-weight: 600;
    border-bottom: 1px solid #261b18;
}QWidget#dockTitleBar {
    background-color: #32231e;
    border-bottom: 1px solid #261b18;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}QLabel#dockTitleLabel {
    background-color: transparent;
    color: #fff1dd;
    font-weight: 600;
}QToolButton#dockFloatButton,
QToolButton#dockCloseButton {
    background-color: transparent;
    border: none;
    border-radius: 7px;
    padding: 4px;
}QToolButton#dockFloatButton:hover,
QToolButton#dockCloseButton:hover {
    background-color: #68483a;
    color: #fff1dd;
}QToolButton#dockFloatButton:pressed,
QToolButton#dockCloseButton:pressed {
    background-color: #7a5140;
}QDockWidget::close-button,
QDockWidget::float-button {
    background-color: transparent;
    border-radius: 6px;
    padding: 2px;
}QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #68483a;
}/* =============================================================================
   Menus and Toolbars
   ============================================================================= */
QMenuBar {
    background-color: #261b18;
    padding: 2px;
    border-bottom: 1px solid #261b18;
}QMenuBar::item {
    padding: 4px 8px;
    background: transparent;
    border-radius: 6px;
}QMenuBar::item:selected {
    background-color: #ed8b3c;
    color: #211713;
}QMenuBar::item:pressed {
    background-color: #d6712e;
    color: #211713;
}QMenu {
    background-color: #5a3d33;
    border: 1px solid #d49a63;
    border-radius: 8px;
    padding: 6px;
}QMenu[glassMenu="true"] {
    background-color: rgba(74, 52, 44, 245);
}QMenu::item {
    padding: 6px 24px;
    border-radius: 6px;
}QMenu::item:selected {
    background-color: #ed8b3c;
    color: #211713;
}QMenu::item:pressed {
    background-color: #d6712e;
    color: #211713;
}QMenu::item:disabled {
    background-color: transparent;
    color: #C0A895;
}QMenu::item:checked {
    color: #ffb56e;
    font-weight: 600;
}QMenu::separator {
    height: 1px;
    background-color: #5c4036;
    margin: 4px 8px;
}QToolBar {
    background-color: #4a342c;
    border: none;
    border-bottom: 1px solid #261b18;
    padding: 3px;
    spacing: 3px;
}QToolBar::separator {
    background-color: #5c4036;
    width: 1px;
    height: 1px;
    margin: 4px;
}QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 7px 8px;
    color: #fff8eb;
}QToolButton:hover {
    background-color: #68483a;
    border-color: #ed8b3c;
    color: #fff1dd;
}QToolButton:pressed {
    background-color: #d6712e;
    border-color: #d6712e;
    color: #211713;
}QToolButton:checked {
    background-color: #ed8b3c;
    border-color: #ed8b3c;
    color: #211713;
}QToolButton:checked:hover {
    background-color: #d6712e;
    border-color: #d6712e;
    color: #211713;
}QToolButton:checked:pressed {
    background-color: #ad5522;
    border-color: #ad5522;
    color: #fff1dd;
}QToolButton:disabled {
    background-color: transparent;
    color: #C0A895;
}/* =============================================================================
   Category Bar
   ============================================================================= */
QToolBar#activityBar {
    padding: 8px 6px;
    spacing: 8px;
}QToolBar#activityBar QToolButton {
    border-radius: 8px;
    padding: 7px 8px;
    min-width: 68px;
    min-height: 40px;
    color: #fff8eb;
}QToolBar#activityBar QToolButton:hover {
    background-color: #68483a;
    color: #fff8eb;
}QToolBar#activityBar QToolButton:checked {
    background-color: #ed8b3c;
    color: #211713;
}QToolBar#activityBar QToolButton:checked:hover {
    background-color: #d6712e;
    color: #211713;
}QToolBar#activityBar QToolButton[statusPlaceholder="true"] {
    background-color: rgba(38, 27, 24, 220);
    color: #c6a78d;
    border: 1px solid #5c4036;
}QToolBar#activityBar QToolButton[statusPlaceholder="true"]:hover {
    background-color: rgba(104, 72, 58, 242);
    color: #f1dcc2;
}QToolBar#activityBar QToolButton[statusPlaceholder="true"]::menu-indicator {
    image: none;
}/* =============================================================================
   Run Controls
   ============================================================================= */
QToolButton[runControl="start"],
QToolBar#activityBar QToolButton[runControl="start"] {
    background-color: #ed8b3c;
    color: #211713;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    padding: 0px;
}QToolButton[runControl="start"]:hover,
QToolBar#activityBar QToolButton[runControl="start"]:hover {
    background-color: #d6712e;
    color: #211713;
}QToolButton[runControl="start"]:pressed,
QToolBar#activityBar QToolButton[runControl="start"]:pressed {
    background-color: #ad5522;
    color: #fff8eb;
}QToolButton[runControl="stop"],
QToolBar#activityBar QToolButton[runControl="stop"] {
    background-color: #d84b50;
    border: none;
    border-radius: 8px;
    padding: 0px;
}QToolButton[runControl="stop"]:hover,
QToolBar#activityBar QToolButton[runControl="stop"]:hover {
    background-color: #ba393e;
}QToolButton[runControl="stop"]:pressed,
QToolBar#activityBar QToolButton[runControl="stop"]:pressed {
    background-color: #922c31;
}QToolButton[runControl]:disabled,
QToolBar#activityBar QToolButton[runControl]:disabled {
    background-color: rgba(116, 81, 66, 110);
    color: rgba(198, 167, 141, 115);
}QToolBar#activityBar QToolButton[runGroup="idle"] {
    background-color: #ed8b3c;
    color: #211713;
    border: none;
}QToolBar#activityBar QToolButton[runGroup="idle"]:hover {
    background-color: #d6712e;
    color: #211713;
}QToolBar#activityBar QToolButton[runGroup="running"] {
    background-color: #c43d46;
    color: #fff8eb;
    border: none;
}QToolBar#activityBar QToolButton[runGroup="running"]:hover {
    background-color: #9c262e;
    color: #fff8eb;
}/* =============================================================================
   Buttons
   ============================================================================= */
QPushButton {
    background-color: #745142;
    color: #fff8eb;
    border: 1px solid #745142;
    border-radius: 8px;
    padding: 6px 13px;
    min-height: 22px;
}QPushButton:hover {
    background-color: #87604d;
    border-color: #ed8b3c;
    color: #fff1dd;
}QPushButton:pressed {
    background-color: #a98670;
    color: #211713;
}QPushButton:checked {
    background-color: #ed8b3c;
    border-color: #ed8b3c;
    color: #211713;
}QPushButton:checked:hover {
    background-color: #d6712e;
    border-color: #d6712e;
    color: #211713;
}QPushButton:default,
QPushButton[class="primary"] {
    background-color: #ed8b3c;
    border-color: #ed8b3c;
    color: #211713;
}QPushButton:default:hover,
QPushButton[class="primary"]:hover {
    background-color: #d6712e;
    border-color: #d6712e;
    color: #211713;
}QPushButton:default:pressed,
QPushButton[class="primary"]:pressed,
QPushButton:checked:pressed {
    background-color: #ad5522;
    border-color: #ad5522;
    color: #fff8eb;
}QPushButton:disabled {
    background-color: #463129;
    color: #C0A895;
}/* =============================================================================
   Inputs
   ============================================================================= */
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #261b18;
    border: 1px solid #745142;
    border-radius: 8px;
    padding: 3px 8px;
    selection-background-color: #ed8b3c;
    selection-color: #211713;
    color: #f1dcc2;
    min-height: 18px;
}QTextEdit#outputLog {
    background-color: #261b18;
    color: #f1dcc2;
}QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateTimeEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    background-color: #32231e;
}QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateTimeEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 2px solid #55d4c6;
    padding: 2px 7px;
}QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QDateTimeEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: #463129;
    color: #C0A895;
}QSpinBox::up-button,
QDoubleSpinBox::up-button,
QDateTimeEdit::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button,
QDateTimeEdit::down-button {
    background-color: transparent;
    border: none;
    width: 16px;
}QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QDateTimeEdit::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover,
QDateTimeEdit::down-button:hover {
    background-color: #68483a;
}QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow,
QDateTimeEdit::up-arrow {
    image: url(:/icons/spinbox-up-arrow.svg);
    width: 10px;
    height: 10px;
}QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow,
QDateTimeEdit::down-arrow {
    image: url(:/icons/spinbox-down-arrow.svg);
    width: 10px;
    height: 10px;
}/* =============================================================================
   Lists, Trees, and Tables
   ============================================================================= */
QListView,
QTreeView,
QTableView {
    background-color: #4a342c;
    border: none;
    border-radius: 8px;
    outline: none;
    alternate-background-color: #3b2a24;
}QListView:focus,
QTreeView:focus,
QTableView:focus {
    border: 2px solid #55d4c6;
}QListView::item,
QTreeView::item,
QTableView::item {
    padding: 3px 4px;
    border: none;
    border-radius: 6px;
}QListView::item:hover,
QTreeView::item:hover,
QTableView::item:hover {
    background-color: #68483a;
}QListView::item:selected,
QTreeView::item:selected,
QTableView::item:selected {
    background-color: #ed8b3c;
    color: #211713;
}QListView::item:disabled,
QTreeView::item:disabled,
QTableView::item:disabled {
    color: #C0A895;
}QTableView {
    gridline-color: #5c4036;
}QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/icons/tree-expand.svg);
}QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/icons/tree-collapse.svg);
}QHeaderView::section {
    background-color: #4a342c;
    color: #c6a78d;
    border: none;
    border-bottom: 1px solid #261b18;
    padding: 4px;
    font-weight: 600;
    font-size: 8pt;
}/* =============================================================================
   Scrollbars
   ============================================================================= */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}QScrollBar::handle:vertical {
    background: rgba(243, 181, 74, 105);
    min-height: 20px;
    border-radius: 5px;
    margin: 2px;
}QScrollBar::handle:vertical:hover {
    background: rgba(237, 139, 60, 190);
}QScrollBar::handle:vertical:pressed {
    background: rgba(85, 212, 198, 225);
}QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0px;
}QScrollBar::handle:horizontal {
    background: rgba(243, 181, 74, 105);
    min-width: 20px;
    border-radius: 5px;
    margin: 2px;
}QScrollBar::handle:horizontal:hover {
    background: rgba(237, 139, 60, 190);
}QScrollBar::handle:horizontal:pressed {
    background: rgba(85, 212, 198, 225);
}QScrollBar::handle:vertical:disabled,
QScrollBar::handle:horizontal:disabled {
    background: rgba(140, 113, 99, 55);
}QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}/* =============================================================================
   Tabs
   ============================================================================= */
QTabWidget::pane {
    border: none;
    border-top: 1px solid #261b18;
    background-color: #3b2a24;
}QTabWidget::tab-bar {
    alignment: left;
}QTabBar::tab {
    background-color: transparent;
    color: #c6a78d;
    border: none;
    padding: 7px 13px;
    margin-right: 2px;
    border-bottom: 2px solid transparent;
}QTabBar::tab:hover {
    color: #f1dcc2;
    background-color: #68483a;
}QTabBar::tab:selected {
    color: #fff1dd;
    border-bottom: 2px solid #ed8b3c;
    background-color: #5a3d33;
}QTabBar::tab:selected:hover {
    background-color: #6b493b;
}QTabBar::tab:disabled {
    color: #C0A895;
}/* =============================================================================
   Selection and Progress Controls
   ============================================================================= */
QGroupBox {
    border: 1px solid #745142;
    border-radius: 8px;
    margin-top: 22px;
    padding: 4px;
    font-weight: bold;
}QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    margin-bottom: -20px;
    background-color: #3b2a24;
    color: #fff1dd;
}QGroupBox::title:disabled {
    color: #C0A895;
}QCheckBox {
    spacing: 6px;
}QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: transparent;
    border: 1px solid #a98670;
    border-radius: 7px;
}QCheckBox::indicator:hover {
    border-color: #e5c9aa;
}QCheckBox::indicator:pressed {
    background-color: #7a5140;
}QCheckBox::indicator:checked {
    background-color: #ed8b3c;
    border-color: #ed8b3c;
    image: url(:/icons/check.svg);
}QCheckBox::indicator:checked:hover {
    background-color: #d6712e;
    border-color: #d6712e;
}QCheckBox::indicator:disabled {
    border-color: #745142;
}QCheckBox::indicator:checked:disabled {
    background-color: #745142;
    border-color: #745142;
}QRadioButton {
    spacing: 6px;
}QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background-color: transparent;
    border: 1px solid #a98670;
    border-radius: 8px;
}QRadioButton::indicator:hover {
    border-color: #e5c9aa;
}QRadioButton::indicator:pressed {
    background-color: #7a5140;
}QRadioButton::indicator:checked {
    background-color: #ed8b3c;
    border-color: #ed8b3c;
    image: url(:/icons/radio-dot.svg);
}QRadioButton::indicator:checked:hover {
    background-color: #d6712e;
    border-color: #d6712e;
}QRadioButton::indicator:disabled {
    border-color: #745142;
}QRadioButton::indicator:checked:disabled {
    background-color: #745142;
    border-color: #745142;
}QSlider::groove:horizontal {
    background: #745142;
    height: 6px;
    border-radius: 5px;
}QSlider::sub-page:horizontal {
    background: #ed8b3c;
    border-radius: 5px;
}QSlider::handle:horizontal {
    background: #fff8eb;
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 8px;
}QSlider::handle:horizontal:hover {
    background: #fff1dd;
    border: 2px solid #ed8b3c;
}QSlider::groove:vertical {
    background: #745142;
    width: 6px;
    border-radius: 5px;
}QSlider::sub-page:vertical {
    background: #ed8b3c;
    border-radius: 5px;
}QSlider::handle:vertical {
    background: #fff1dd;
    width: 14px;
    height: 14px;
    margin: 0 -4px;
    border-radius: 8px;
}QSlider::handle:vertical:hover {
    background: #fff1dd;
    border: 2px solid #ed8b3c;
}QSlider::groove:horizontal:disabled,
QSlider::groove:vertical:disabled {
    background: #463129;
}QSlider::handle:horizontal:disabled,
QSlider::handle:vertical:disabled {
    background: #C0A895;
}QProgressBar {
    background-color: #261b18;
    border: none;
    border-radius: 8px;
    text-align: center;
    color: #fff1dd;
}QProgressBar::chunk {
    background-color: #ed8b3c;
    border-radius: 8px;
}QToolTip {
    background-color: #211713;
    color: #f1dcc2;
    border: none;
    border-radius: 8px;
    padding: 5px 8px;
}/* =============================================================================
   Status and Application Chrome
   ============================================================================= */
QLabel[status="active"] {
    color: #5dc98b;
    font-weight: bold;
}QLabel[status="loaded"],
QLabel[status="connected"] {
    color: #5dc98b;
    font-weight: 600;
}QLabel[status="inactive"] {
    color: #c6a78d;
    font-weight: 600;
}QLabel[status="error"] {
    color: #f06b6f;
    font-weight: bold;
}QLabel[status="warning"] {
    color: #f3b54a;
    font-weight: bold;
}QLabel[status="info"],
QLabel[status="empty"] {
    color: #70ded2;
    font-size: 7pt;
}QLabel[updateLabelClickable="true"] {
    color: #ed8b3c;
    font-weight: 600;
}QLabel[updateLabelClickable="true"]:hover {
    color: #d6712e;
}QStatusBar {
    background-color: #261b18;
    color: #c6a78d;
}QWidget#appStatusBar {
    background-color: #261b18;
    color: #c6a78d;
}QWidget#appStatusBar QLabel[statusBarLabel="true"] {
    background-color: transparent;
    padding: 2px 4px;
    font-size: 11px;
}QLabel#appMetricsLabel {
    color: #c6a78d;
}QListWidget#preferencesCategoryList {
    background-color: transparent;
    border: none;
}QListWidget#preferencesCategoryList::item {
    padding-top: 11px;
    padding-bottom: 11px;
}QListWidget#preferencesCategoryList::item:hover {
    background-color: rgba(255, 255, 255, 22);
}QListWidget#preferencesCategoryList::item:selected {
    background-color: rgba(237, 139, 60, 58);
    color: #fff1dd;
    border-left: 3px solid #ed8b3c;
}QPushButton#preferencesConfirmButton {
    padding-left: 21px;
    padding-right: 21px;
}/* =============================================================================
   Semantic Components
   ============================================================================= */
QLabel[role="heading"] {
    font-size: 13pt;
    font-weight: 600;
    color: #fff1dd;
    background: transparent;
}QLabel[role="subheading"] {
    font-size: 10pt;
    font-weight: 600;
    color: #fff1dd;
    background: transparent;
}QLabel[role="caption"] {
    font-size: 8pt;
    color: #c6a78d;
    background: transparent;
}QLabel[role="muted"] {
    color: #e5c9aa;
    background: transparent;
}QLabel[accent="true"] {
    color: #ed8b3c;
    background: transparent;
}QFrame[card="true"],
QLabel[card="true"] {
    background-color: #4a342c;
    border: 1px solid #745142;
    border-radius: 8px;
}QGroupBox#onlineResourceCard {
    background-color: #4a342c;
    border: 1px solid #93705a;
    border-radius: 9px;
    margin: 0px;
    padding: 0px;
}QGroupBox#onlineResourceCard:hover {
    border-color: #55d4c6;
}QGroupBox#onlineResourceCard .QWidget {
    background: transparent;
    border: none;
}QLabel#onlineResourceTitle {
    font-size: 12pt;
    font-weight: 600;
}QLabel[card="true"] {
    padding: 10px;
}QWidget#accountLoginCard {
    background-color: #4a342c;
    border: 1px solid #5c4036;
    border-radius: 10px;
}QFrame[card="true"] QLabel {
    background: transparent;
    border: none;
}QLabel[chip="true"] {
    background-color: #ed8b3c;
    color: #211713;
    border-radius: 8px;
    padding: 2px 8px;
    font-weight: 600;
}QGroupBox[titleless="true"] {
    margin-top: 0px;
    padding-top: 0px;
}QTabWidget[compactTabs="true"]::pane {
    border-radius: 0px 0px 8px 8px;
}QTabWidget[compactTabs="true"] QTabBar::tab {
    padding: 4px 10px;
    font-size: 11px;
    border-radius: 8px 8px 0px 0px;
}QWidget[statusChip] {
    border-radius: 8px;
    font-weight: 600;
}QWidget[statusChip="ok"] {
    background-color: rgba(46, 160, 67, 40);
    border: 1px solid rgba(46, 160, 67, 110);
}QWidget[statusChip="error"] {
    background-color: rgba(229, 83, 75, 40);
    border: 1px solid rgba(229, 83, 75, 110);
}QWidget[statusChip="warning"] {
    background-color: rgba(240, 180, 41, 40);
    border: 1px solid rgba(240, 180, 41, 110);
}QWidget[statusChip="info"] {
    background-color: rgba(85, 212, 198, 42);
    border: 1px solid rgba(85, 212, 198, 125);
}QWidget[statusChip="neutral"] {
    background-color: rgba(148, 155, 164, 40);
    border: 1px solid rgba(148, 155, 164, 110);
}QWidget[statusChip] QLabel {
    background: transparent;
    border: none;
}QFrame[class="memory-slot"] {
    background-color: #32231e;
    border: 1px solid #5c4036;
    border-radius: 8px;
}QFrame[class="memory-slot"][hasContent="true"] {
    background-color: #4a342c;
}QFrame[class="memory-slot"][selected="true"] {
    border: 1px solid #ed8b3c;
}QLabel#memorySlotNumber {
    font-size: 34px;
