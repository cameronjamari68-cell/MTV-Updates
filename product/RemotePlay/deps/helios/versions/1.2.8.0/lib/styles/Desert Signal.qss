    min-width: 30px;
    min-height: 30px;
    padding: 4px;
}/* =============================================================================
   Overlays and Glass
   ============================================================================= */
QLabel[overlay="true"] {
    background-color: rgba(0, 0, 0, 130);
    color: #fff8eb;
    padding: 2px 8px;
    border-radius: 6px;
}QWidget[overlay="scrim"] {
    background-color: rgba(38, 27, 24, 170);
