   Geometry-only final override: preserves this theme's palette and artwork.
   ============================================================================= */
QDockWidget,
QGroupBox,
QFrame[card="true"],
QWidget[card="true"],
QLabel[card="true"],
QFrame[panel="true"],
QWidget[panel="true"],
QWidget#accountLoginCard,
QFrame[class="memory-slot"],
QFrame#loadingFrame {
    border-radius: 11px;
}QTabWidget::pane {
    border-radius: 11px;
}QWidget#dockTitleBar {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}QTabBar::tab {
    border-radius: 9px;
}QGroupBox {
    margin-top: 26px;
    padding-top: 8px;
    padding-right: 6px;
    padding-bottom: 4px;
    padding-left: 6px;
}QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    position: relative;
    top: -6px;
    left: 0;
    margin-left: 6px;
    padding: 0 7px 4px 7px;
    background-color: transparent;
    border: none;
}/* Image/resource cards are titleless and must retain their fitted image geometry. */
QGroupBox#onlineResourceCard {
    margin-top: 0;
    padding-top: 1px;
    padding-right: 2px;
    padding-bottom: 1px;
    padding-left: 1px;
    border-radius: 11px;
}QGroupBox[titleless="true"] {
    margin-top: 0;
    padding-top: 6px;
    border-radius: 11px;
}QGroupBox#onlineResourceCard > QLabel,
QGroupBox#onlineResourceCard QLabel[card="true"] {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}/* Preserve the complete glyph box and keep plugin text vertically centered. */
QLabel#dockTitleLabel,
QWidget#dockTitleBar QLabel,
QLabel#onlineResourceTitle,
QLabel[class="plugin-name"],
QLabel[class="script-name"],
QLabel[class="device-name"],
QLabel[role="plugin-title"],
QLabel[pluginTitle="true"],
QLabel[role="heading"] {
    padding-top: 0;
    padding-bottom: 0;
}QDockWidget::title {
    padding-top: 3px;
    padding-right: 8px;
    padding-bottom: 7px;
    padding-left: 8px;
}/* Preferences needs a slightly larger title gutter than compact plugin cards. */
Helios--PreferencesDialog QGroupBox,
QWidget#preferencesDialog QGroupBox,
QDialog[glassDialog="true"] QGroupBox {
    margin-top: 30px;
    padding-top: 9px;
    padding-right: 6px;
    padding-bottom: 4px;
    padding-left: 6px;
    border-radius: 11px;
}Helios--PreferencesDialog QGroupBox::title,
QWidget#preferencesDialog QGroupBox::title,
QDialog[glassDialog="true"] QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    position: relative;
    top: -7px;
    left: 0;
    margin-left: 6px;
    padding: 0 7px 4px 7px;
    background-color: transparent;
    border: none;
}/* Standard interactive surfaces should never fall back to square native corners. */
QPushButton,
QToolButton,
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit {
    border-radius: 8px;
}QTextEdit,
QPlainTextEdit,
QListView,
QTreeView,
QTableView,
QListWidget,
QTreeWidget,
QTableWidget,
QMenu {
    border-radius: 9px;
}/* Center-only gradient boundary cues for splitters and dock separators. */
QSplitter::handle { background-color: transparent; }QSplitter::handle:horizontal {
    min-width: 5px;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 transparent, stop:.30 transparent, stop:.30 rgba(116, 81, 66, 55),
        stop:.40 #745142, stop:.50 #ED8B3C, stop:.60 #FFE0B3,
        stop:.70 rgba(255, 224, 179, 55), stop:.70 transparent, stop:1 transparent);
}QSplitter::handle:vertical {
    min-height: 5px;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 transparent, stop:.30 transparent, stop:.30 rgba(116, 81, 66, 55),
        stop:.40 #745142, stop:.50 #ED8B3C, stop:.60 #FFE0B3,
        stop:.70 rgba(255, 224, 179, 55), stop:.70 transparent, stop:1 transparent);
}QSplitter::handle:horizontal:hover,
QSplitter::handle:horizontal:pressed {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 transparent, stop:.26 transparent, stop:.26 rgba(116, 81, 66, 90),
        stop:.38 #745142, stop:.50 #ED8B3C, stop:.62 #FFE0B3,
        stop:.74 rgba(255, 224, 179, 90), stop:.74 transparent, stop:1 transparent);
}QSplitter::handle:vertical:hover,
QSplitter::handle:vertical:pressed {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 transparent, stop:.26 transparent, stop:.26 rgba(116, 81, 66, 90),
        stop:.38 #745142, stop:.50 #ED8B3C, stop:.62 #FFE0B3,
        stop:.74 rgba(255, 224, 179, 90), stop:.74 transparent, stop:1 transparent);
}QMainWindow::separator,
QMainWindow::separator:hover {
    background: transparent;
    width: 5px;
    height: 5px;
}QMainWindow::separator:horizontal {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 transparent, stop:.30 transparent, stop:.30 rgba(116, 81, 66, 55),
        stop:.40 #745142, stop:.50 #ED8B3C, stop:.60 #FFE0B3,
        stop:.70 rgba(255, 224, 179, 55), stop:.70 transparent, stop:1 transparent);
}QMainWindow::separator:vertical {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 transparent, stop:.30 transparent, stop:.30 rgba(116, 81, 66, 55),
        stop:.40 #745142, stop:.50 #ED8B3C, stop:.60 #FFE0B3,
        stop:.70 rgba(255, 224, 179, 55), stop:.70 transparent, stop:1 transparent);
}QMainWindow::separator:horizontal:hover {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 transparent, stop:.26 transparent, stop:.26 rgba(116, 81, 66, 90),
        stop:.38 #745142, stop:.50 #ED8B3C, stop:.62 #FFE0B3,
        stop:.74 rgba(255, 224, 179, 90), stop:.74 transparent, stop:1 transparent);
}QMainWindow::separator:vertical:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 transparent, stop:.26 transparent, stop:.26 rgba(116, 81, 66, 90),
        stop:.38 #745142, stop:.50 #ED8B3C, stop:.62 #FFE0B3,
        stop:.74 rgba(255, 224, 179, 90), stop:.74 transparent, stop:1 transparent);
}/* Final Helios shell curve and proportional arrow calibration. */
QDockWidget,
QFrame,
QGroupBox,
QStackedWidget,
QScrollArea,
QAbstractScrollArea,
QWidget[panel="true"],
QFrame[panel="true"],
QWidget[card="true"],
QFrame[card="true"],
QWidget[container="true"],
QFrame[container="true"] {
    border-radius: 12px;
}QTabWidget,
QTabWidget::pane,
Helios--TitanBridgeWidget QTabWidget,
Helios--TitanBridgeWidget QTabWidget::pane,
Helios--DSCaptureWidget QTabWidget,
Helios--DSCaptureWidget QTabWidget::pane,
Helios--MFCaptureWidget QTabWidget,
Helios--MFCaptureWidget QTabWidget::pane,
Helios--OnlineResourcesWidget QTabWidget,
Helios--OnlineResourcesWidget QTabWidget::pane {
    border-radius: 14px;
}QWidget#dockTitleBar {
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}QTabBar::tab {
    border-radius: 9px;
}/* Final live-widget title baseline correction: retain the title gutter but
   move the text below the clipping edge used by Helios plugin group boxes. */
QGroupBox::title {
    position: relative;
    top: 1px;
}Helios--PreferencesDialog QGroupBox::title,
QWidget#preferencesDialog QGroupBox::title,
QDialog[glassDialog="true"] QGroupBox::title {
    position: relative;
    top: 1px;
}/* Titan Bridge nested tab-surface correction. The pane and its internal
   stacked page must both be rounded; otherwise the page paints square
   pixels over the pane's lower corners. */
Helios--TitanBridgeWidget QTabWidget,
Helios--TitanBridgeWidget QTabWidget::pane,
Helios--TitanBridgeWidget QStackedWidget#qt_tabwidget_stackedwidget,
Helios--TitanBridgeWidget QStackedWidget#qt_tabwidget_stackedwidget > QWidget {
    border-radius: 14px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}Helios--TitanBridgeWidget QStackedWidget#qt_tabwidget_stackedwidget,
Helios--TitanBridgeWidget QStackedWidget#qt_tabwidget_stackedwidget > QWidget {
    background-color: transparent;
    border: none;
}/* Live-verified Titan pane replacement: Qt paints the native tab-pane border
   square, so suppress it and place the themed rounded outline on the stacked
   page surface that occupies the same geometry. */
Helios--TitanBridgeWidget QTabWidget::pane {
    background-color: transparent;
    border: none;
}Helios--TitanBridgeWidget QStackedWidget#qt_tabwidget_stackedwidget {
    background-color: transparent;
    border: 1px solid #745142;
    border-radius: 14px;
}/* =============================================================================
   HACKER-REFERENCE WIDGET TEXT FIT OVERRIDE
   Matches the known-good Hacker by Kem text metrics and control spacing.
   Palette, borders, corner styling, images, and theme-specific artwork remain intact.
   ============================================================================= */
QWidget {
    font-family: "Consolas", "Courier New", monospace;
    font-size: 9pt;
}QDockWidget::title {
    padding-top: 5px;
    padding-right: 8px;
    padding-bottom: 5px;
    padding-left: 8px;
}QLabel#dockTitleLabel,
QWidget#dockTitleBar QLabel,
QLabel#onlineResourceTitle,
QLabel[class="plugin-name"],
QLabel[class="script-name"],
QLabel[class="device-name"],
QLabel[role="plugin-title"],
QLabel[pluginTitle="true"],
QLabel[role="heading"] {
    padding-top: 0px;
    padding-bottom: 0px;
}QToolButton#dockFloatButton,
QToolButton#dockCloseButton {
    padding: 1px;
}QMenu {
    padding: 4px;
}QMenu::item {
    padding: 6px 24px;
}QToolButton {
    padding: 6px 6px;
}QToolBar#activityBar QToolButton {
    padding: 7px 8px;
    min-height: 40px;
}QPushButton {
    padding: 4px 12px;
    min-height: 22px;
}QLineEdit,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit,
QTextEdit,
QPlainTextEdit {
    padding: 3px 7px;
    min-height: 18px;
    border-width: 1px;
}QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateTimeEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateTimeEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QDateTimeEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QLineEdit:read-only,
QSpinBox:read-only,
QDoubleSpinBox:read-only,
QDateTimeEdit:read-only,
QTextEdit:read-only,
QPlainTextEdit:read-only,
QLineEdit:read-only:focus,
QSpinBox:read-only:focus,
QDoubleSpinBox:read-only:focus,
QDateTimeEdit:read-only:focus,
QTextEdit:read-only:focus,
QPlainTextEdit:read-only:focus {
    padding: 3px 7px;
    min-height: 18px;
    border-width: 1px;
}QListView::item,
QTreeView::item,
QTableView::item,
QListWidget::item,
QTreeWidget::item,
QTableWidget::item {
    padding: 2px 3px;
}QHeaderView::section {
    padding: 4px;
    font-size: 8pt;
}QTabBar::tab {
    padding: 7px 13px;
    min-height: 0px;
}QGroupBox {
    margin-top: 22px;
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
}QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    position: relative;
    top: 0px;
    left: 0px;
    margin-left: 0px;
    margin-bottom: -20px;
    padding-top: 0px;
    padding-right: 5px;
    padding-bottom: 0px;
    padding-left: 5px;
}Helios--PreferencesDialog QGroupBox,
QWidget#preferencesDialog QGroupBox,
QDialog[glassDialog="true"] QGroupBox {
    margin-top: 22px;
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
}Helios--PreferencesDialog QGroupBox::title,
QWidget#preferencesDialog QGroupBox::title,
QDialog[glassDialog="true"] QGroupBox::title {
    position: relative;
    top: 0px;
    left: 0px;
    margin-left: 0px;
    margin-bottom: -20px;
    padding-top: 0px;
    padding-right: 5px;
    padding-bottom: 0px;
    padding-left: 5px;
}QGroupBox#onlineResourceCard,
QGroupBox[titleless="true"] {
    margin-top: 0px;
}QCheckBox::indicator,
QRadioButton::indicator {
    width: 14px;
    height: 14px;
}QLabel[status="info"],
QLabel[status="empty"] {
    font-size: 7pt;
}QWidget#appStatusBar QLabel[statusBarLabel="true"] {
    padding: 2px 4px;
    font-size: 11px;
}QLabel[role="heading"] { font-size: 13pt; }QLabel[role="subheading"] { font-size: 10pt; }QLabel[role="caption"] { font-size: 8pt; }

/* =============================================================================
   HELIOS SELECTOR CONTRACT — copied from the final working JAJ selector behavior
   Applied cleanly to Desert Signal; previous conflicting ComboBox and managed-popup
   selectors were removed before this block. Theme colors are preserved.
   ============================================================================= */
QFrame[managedSelectorPopup="true"] {
    background-color: rgba(43, 27, 21, 198);
    border: 1px solid #745142;
    border-radius: 6px;
    padding: 4px;
}

QTreeView[managedSelectorItems="true"]::item {
    border-radius: 0;
    padding: 2px 4px;
}

QTreeView[managedSelectorItems="true"]::item:hover {
    background-color: rgba(237, 139, 60, 34);
    color: #FFD18B;
}

QTreeView[managedSelectorItems="true"]::item:selected {
    background-color: rgba(237, 139, 60, 76);
    color: #55D4C6;
}

QTreeView[managedSelectorItems="true"]::item:disabled {
    color: #8B7162;
}

QFrame#managedSelectorPopup {
    background-color: rgba(43, 27, 21, 198);
    color: #FFF1DD;
    border: 1px solid #745142;
    border-radius: 8px;
    padding: 0;
}

QTreeView[managedSelectorItems="true"],
QTreeView[managedSelectorItems="true"]:focus {
    background-color: rgba(43, 27, 21, 198);
    color: #FFF1DD;
    border: none;
    border-radius: 0;
    outline: none;
    padding: 4px;
}

QWidget[managedSelectorActions="true"] {
    background-color: rgba(43, 27, 21, 198);
    color: #FFF1DD;
    border: none;
}

QFrame[managedSelectorDivider="true"] {
    background-color: #745142;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

QWidget[managedSelectorRemoveCell="true"],
QToolButton[managedSelectorRemove="true"],
QToolButton[managedSelectorRemove="true"]:hover,
QToolButton[managedSelectorRemove="true"]:pressed,
QToolButton[managedSelectorRemove="true"]:focus {
    background-color: transparent;
    border: none;
    padding: 0;
}

QComboBox {
    min-width: 60px;
    min-height: 24px;
    padding: 4px 8px;
    background-color: rgba(55, 33, 24, 76);
    color: #FFF1DD;
    border: 1px solid #745142;
    border-radius: 4px;
    selection-background-color: #ED8B3C;
    selection-color: #211713;
}

QComboBox:hover {
    background-color: rgba(237, 139, 60, 64);
    border: 1px solid #ED8B3C;
}

QComboBox:on {
    background-color: rgba(237, 139, 60, 64);
    border: 1px solid #ED8B3C;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
    background-color: transparent;
}

QComboBox:hover::drop-down,
QComboBox:on::drop-down {
    background-color: rgba(237, 139, 60, 64);
}

QComboBox::down-arrow,
QComboBox:disabled::down-arrow,
QComboBox:hover::down-arrow,
QComboBox:on::down-arrow,
QComboBox::down-arrow:hover,
QComboBox::down-arrow:on,
QComboBox::down-arrow:open,
QComboBox::down-arrow:pressed {
    image: url(:/icons/arrow-down.svg);
    width: 10px;
    height: 10px;
    background: transparent;
    border: none;
}

QComboBox QAbstractItemView {
    background-color: rgba(43, 27, 21, 198);
    color: #FFF1DD;
    border: 1px solid #745142;
    border-radius: 4px;
    selection-background-color: #ed8b3c;
    selection-color: #211713;
    outline: none;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    padding: 2px 4px;
    border-radius: 3px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: rgba(237, 139, 60, 34);
    color: #FFD18B;
}

QComboBox QAbstractItemView::item:disabled {
    color: #8B7162;
}

QComboBox:disabled {
    background-color: rgba(55, 33, 24, 42);
    color: #8B7162;
    border: 1px solid #4d3830;
    padding: 4px 8px;
}

QComboBox:disabled::drop-down {
    background-color: transparent;
}

QComboBox:focus {
    border-color: #ED8B3C;
}

/* Helios interaction states required by the theme contract. */
QMenuBar::item:disabled,
QListWidget::item:disabled,
QTreeWidget::item:disabled,
QTableWidget::item:disabled {
    color: #8B7162;
}

QCheckBox:focus::indicator,
QRadioButton:focus::indicator,
QTabBar::tab:focus {
    border-color: #ED8B3C;
}

QToolBar#activityBar QToolButton:pressed,
QToolBar#activityBar QToolButton:checked:pressed,
QPushButton#scriptCardLikeButton:pressed,
QPushButton#scriptCardDownloadButton:pressed,
QPushButton#henvCardInstallButton:pressed,
QPushButton#uploadButton:pressed {
    background-color: rgba(237, 139, 60, 76);
    color: #55D4C6;
    border-color: #55D4C6;
}

QToolBar#activityBar QToolButton:disabled,
QPushButton#scriptCardLikeButton:disabled,
QPushButton#scriptCardDownloadButton:disabled,
QPushButton#henvCardInstallButton:disabled,
QPushButton#uploadButton:disabled {
    background-color: rgba(55, 33, 24, 76);
    color: #8B7162;
    border-color: #745142;
}

QWidget#dockTitleBar QToolButton:hover {
    background-color: rgba(237, 139, 60, 64);
}

QComboBox:enabled:!hover:!focus:!on {
    background-color: rgba(0, 0, 0, 26);
}

QComboBox:enabled:hover:!on {
    background-color: rgba(0, 0, 0, 51);
}
