/* =============================================================================
   Nexus Plasma Forge Theme
   Industrial charcoal controls forged with molten copper, violet energy, and plasma-cyan light.
   ============================================================================= */
/* @token content-padding: 14 */
/* @token wallpaper: assets/nexus_plasma_forge.png */
/* @token wallpaper-mode: fill */
/* @token glass: dark */
/* @token icon-color: #ede4e7 */
/* @token selection-icon-color: #34e4de */
/* @token active-icon-color: #ff8a45 */
/* @token error-icon-color: #ff7254 */

QLabel[logLevel="debug"] { color: #998a96; }
QLabel[logLevel="info"] { color: #998a96; }
QLabel[logLevel="warning"] { color: #ffb55e; font-weight: 600; }
QLabel[logLevel="error"] { color: #ff7254; font-weight: 600; }
QLabel[logLevel="critical"] { color: #ff7254; font-weight: 700; }
/* =============================================================================
   Global
   ============================================================================= */
QWidget {
    background-color: transparent;
    color: #EDE4E7;
    font-family: "Bahnschrift", "Segoe UI Variable", "Segoe UI", sans-serif;
    font-size: 9pt;
}QWidget:disabled {
    color: #998A96;
}QWidget:focus {
    outline: none;
}QDialog {
    background-color: #060509;
    color: #EDE4E7;
}QWidget#loadingScreen {
    background: transparent;
    border: none;
}QFrame#loadingFrame {
    background-color: #100D18;
    border: 1px solid #8B4D48;
    border-radius: 8px;
}QLabel,
QCheckBox,
QRadioButton {
    background-color: transparent;
}/* =============================================================================
   Main Window
   ============================================================================= */
QMainWindow {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                      stop: 0 #030308,
                                      stop: 0.38 #151023,
                                      stop: 0.72 #1B1329,
                                      stop: 1 #060509);
}QMainWindow::separator {
    background: #030308;
    width: 5px;
    height: 5px;
}QMainWindow::separator:hover {
    background: #B05435;
}QSplitter::handle {
    background-color: #060509;
}QSplitter::handle:hover {
    background-color: #B05435;
}/* =============================================================================
   Dock Widgets
   ============================================================================= */
QDockWidget {
    background-color: #100D18;
    border: 1px solid #5A3340;
    border-top: 2px solid #C26945;
    border-radius: 8px;
    titlebar-close-icon: url(:/icons/close.svg);
    titlebar-normal-icon: url(:/icons/float.svg);
}QDockWidget[panelDock="true"] {
    background-color: #100D18;
    border-color: #5A3340;
    border-top-color: #C26945;
}QDockWidget::title {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                      stop: 0 #2A1B2D,
                                      stop: 0.56 #151023,
                                      stop: 1 #100D18);
    color: #FFF4ED;
    padding: 5px 8px;
    font-weight: 600;
    border-bottom: 1px solid #5A3340;
}QWidget#dockTitleBar {
    background-color: #151023;
    border-bottom: 1px solid #5A3340;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
}QLabel#dockTitleLabel {
    background-color: transparent;
    color: #FFF4ED;
    font-weight: 600;
}QToolButton#dockFloatButton,
QToolButton#dockCloseButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 4px;
}QToolButton#dockFloatButton:hover,
QToolButton#dockCloseButton:hover {
    background-color: #2A1B2D;
    color: #FFF4ED;
}QToolButton#dockFloatButton:pressed,
QToolButton#dockCloseButton:pressed {
    background-color: #3A2235;
}QDockWidget::close-button,
QDockWidget::float-button {
    background-color: transparent;
    border-radius: 8px;
    padding: 2px;
}QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #2A1B2D;
}/* =============================================================================
   Menus and Toolbars
   ============================================================================= */
QMenuBar {
    background-color: #030308;
    padding: 4px;
    border-bottom: 1px solid #5A3340;
}QMenuBar::item {
    padding: 4px 8px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
}QMenuBar::item:selected {
    background-color: #2A1B2D;
    color: #FFF4ED;
    border-color: #34E4DE;
}QMenuBar::item:pressed {
    background-color: #7B2C38;
    color: #FFF8F3;
    border-color: #A66BFF;
}QMenu {
    background-color: rgba(16, 13, 24, 232);
    border: 1px solid #8B4D48;
    border-radius: 8px;
    padding: 8px;
}QMenu[glassMenu="true"] {
    background-color: rgba(3, 3, 8, 160);
}QMenu::item {
    padding: 8px 28px;
    border: 1px solid transparent;
    border-radius: 8px;
}QMenu::item:selected {
    background-color: rgba(25, 91, 100, 226);
    color: #FFF8F3;
    border-color: #34E4DE;
}QMenu::item:pressed {
    background-color: rgba(107, 44, 39, 232);
    color: #FFF8F3;
    border-color: #FF7254;
}QMenu::item:disabled {
    background-color: transparent;
    color: #998A96;
}QMenu::item:checked {
    color: #FFF4ED;
    font-weight: 600;
}QMenu::separator {
    height: 1px;
    background-color: #5A3340;
    margin: 4px 8px;
}QToolBar {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                      stop: 0 #100D18,
                                      stop: 0.58 #151023,
                                      stop: 1 #201326);
    border: none;
    border-bottom: 1px solid #5A3340;
    padding: 5px;
    spacing: 5px;
}QToolBar::separator {
    background-color: #5A3340;
    width: 1px;
    height: 1px;
    margin: 4px;
}QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 7px 9px;
    color: #FFF8F3;
}QToolButton:hover {
    background-color: #2A1B2D;
    border-color: #34E4DE;
    color: #FFF8F3;
}QToolButton:pressed {
    background-color: #3A2235;
    border-color: #A66BFF;
    color: #FFF8F3;
}QToolButton:checked {
    background-color: #3A2235;
    color: #FFF8F3;
}QToolButton:checked:hover {
    background-color: #B05435;
    border-color: #34E4DE;
    color: #FFF8F3;
}QToolButton:checked:pressed {
    background-color: #A8472B;
    color: #FFF8F3;
}QToolButton:disabled {
    background-color: transparent;
    color: #998A96;
}/* =============================================================================
   Category Bar
   ============================================================================= */
QToolBar#activityBar {
    padding: 10px 8px;
    spacing: 10px;
}QToolBar#activityBar QToolButton {
    border-radius: 8px;
    padding: 7px 8px;
    min-width: 68px;
    min-height: 40px;
    color: #FFF8F3;
}QToolBar#activityBar QToolButton:hover {
    background-color: #2A1B2D;
    color: #FFF8F3;
}QToolBar#activityBar QToolButton:checked {
    background-color: #3A2235;
    color: #FFF8F3;
    border-bottom: 2px solid #34E4DE;
}QToolBar#activityBar QToolButton:checked:hover {
    background-color: #B05435;
    color: #FFF8F3;
}QToolBar#activityBar QToolButton[statusPlaceholder="true"] {
    background-color: rgba(3, 3, 8, 214);
    color: #C5B0BA;
    border: 1px solid #5A3340;
}QToolBar#activityBar QToolButton[statusPlaceholder="true"]:hover {
    background-color: rgba(42, 27, 45, 230);
    color: #EDE4E7;
}QToolBar#activityBar QToolButton[statusPlaceholder="true"]::menu-indicator {
    image: none;
}/* =============================================================================
   Run Controls
   ============================================================================= */
QToolButton[runControl="start"],
QToolBar#activityBar QToolButton[runControl="start"] {
    background-color: #297A70;
    color: #FFF8F3;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    padding: 0px;
}QToolButton[runControl="start"]:hover,
QToolBar#activityBar QToolButton[runControl="start"]:hover {
    background-color: #22685F;
    color: #FFF8F3;
}QToolButton[runControl="start"]:pressed,
QToolBar#activityBar QToolButton[runControl="start"]:pressed {
    background-color: #1B544E;
    color: #FFF8F3;
}QToolButton[runControl="stop"],
QToolBar#activityBar QToolButton[runControl="stop"] {
    background-color: #A24431;
    border: none;
    border-radius: 8px;
    padding: 0px;
}QToolButton[runControl="stop"]:hover,
QToolBar#activityBar QToolButton[runControl="stop"]:hover {
    background-color: #7B2C38;
}QToolButton[runControl="stop"]:pressed,
QToolBar#activityBar QToolButton[runControl="stop"]:pressed {
    background-color: #64251D;
}QToolButton[runControl]:disabled,
QToolBar#activityBar QToolButton[runControl]:disabled {
    background-color: rgba(74, 41, 57, 90);
    color: rgba(255, 248, 243, 75);
}QToolBar#activityBar QToolButton[runGroup="idle"] {
    background-color: #297A70;
    color: #FFF8F3;
    border: none;
}QToolBar#activityBar QToolButton[runGroup="idle"]:hover {
    background-color: #22685F;
    color: #FFF8F3;
}QToolBar#activityBar QToolButton[runGroup="running"] {
    background-color: #A24431;
    color: #FFF8F3;
    border: none;
}QToolBar#activityBar QToolButton[runGroup="running"]:hover {
    background-color: #7B2C38;
    color: #FFF8F3;
}/* =============================================================================
   Buttons
   ============================================================================= */
QPushButton {
    background-color: #4A2939;
    color: #FFF8F3;
    border: 1px solid #8B4D48;
    border-radius: 8px;
    padding: 8px 16px;
    min-height: 24px;
}QPushButton:hover {
    background-color: #6F3B4D;
    border-color: #C26945;
    color: #FFF8F3;
}QPushButton:pressed {
    background-color: #5A3340;
    color: #FFF8F3;
}QPushButton:checked {
    background-color: #A8472B;
    color: #FFF8F3;
    border-color: #34E4DE;
}QPushButton:checked:hover {
    background-color: #833625;
    color: #FFF8F3;
}QPushButton:default,
QPushButton[class="primary"] {
    background-color: #A8472B;
    color: #FFF8F3;
    border-color: #34E4DE;
}QPushButton:default:hover,
QPushButton[class="primary"]:hover {
    background-color: #833625;
    color: #FFF8F3;
}QPushButton:default:pressed,
QPushButton[class="primary"]:pressed,
QPushButton:checked:pressed {
    background-color: #67271D;
    color: #FFF8F3;
}QPushButton:disabled {
    background-color: #1B1723;
    color: #998A96;
    border-color: #5A3340;
}/* =============================================================================
   Inputs
   ============================================================================= */
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #030308;
    border: 1px solid #5A3340;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: #A8472B;
    selection-color: #FFF8F3;
    color: #EDE4E7;
    min-height: 20px;
}QTextEdit#outputLog {
    background-color: #030308;
    color: #EDE4E7;
}QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateTimeEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    background-color: #151023;
    border-color: #34E4DE;
}QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateTimeEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #A66BFF;
    padding: 6px 10px;
}QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QDateTimeEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: #1B1723;
    color: #998A96;
    border-color: #5A3340;
}QSpinBox::up-button,
QDoubleSpinBox::up-button,
QDateTimeEdit::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button,
QDateTimeEdit::down-button {
    background-color: transparent;
    border: none;
    width: 16px;
}QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QDateTimeEdit::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover,
QDateTimeEdit::down-button:hover {
    background-color: #2A1B2D;
}QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow,
QDateTimeEdit::up-arrow {
    image: url(:/icons/spinbox-up-arrow.svg);
    width: 10px;
    height: 10px;
}QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow,
QDateTimeEdit::down-arrow {
    image: url(:/icons/spinbox-down-arrow.svg);
    width: 10px;
    height: 10px;
}/* =============================================================================
   Lists, Trees, and Tables
   ============================================================================= */
QListView,
QTreeView,
QTableView {
    background-color: #100D18;
    border: 1px solid #5A3340;
    border-radius: 8px;
    outline: none;
    alternate-background-color: #060509;
}QListView:focus,
QTreeView:focus,
QTableView:focus {
    border: 1px solid #A66BFF;
}QListView::item,
QTreeView::item,
QTableView::item {
    padding: 5px 7px;
    border: none;
    border-radius: 8px;
}QListView::item:hover,
QTreeView::item:hover,
QTableView::item:hover {
    background-color: #2A1B2D;
    color: #FFF4ED;
}QListView::item:selected,
QTreeView::item:selected,
QTableView::item:selected {
    background-color: #673443;
    color: #FFF8F3;
}QListView::item:disabled,
QTreeView::item:disabled,
QTableView::item:disabled {
    color: #998A96;
}QTableView {
    gridline-color: #5A3340;
}QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/icons/tree-expand.svg);
}QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/icons/tree-collapse.svg);
}QHeaderView::section {
    background-color: #151023;
    color: #C5B0BA;
    border: none;
    border-bottom: 1px solid #8B4D48;
    padding: 6px;
    font-weight: 600;
    font-size: 8pt;
}/* =============================================================================
   Scrollbars
   ============================================================================= */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}QScrollBar::handle:vertical {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #5A3340,
                                stop: 0.55 #8B4D48,
                                stop: 1 #34E4DE);
    min-height: 20px;
    border-radius: 5px;
    margin: 2px;
}QScrollBar::handle:vertical:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #A8472B,
                                stop: 1 #A66BFF);
}QScrollBar::handle:vertical:pressed {
    background: #34E4DE;
}QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0px;
}QScrollBar::handle:horizontal {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                stop: 0 #5A3340,
                                stop: 0.55 #8B4D48,
                                stop: 1 #34E4DE);
    min-width: 20px;
    border-radius: 5px;
    margin: 2px;
}QScrollBar::handle:horizontal:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                stop: 0 #A8472B,
                                stop: 1 #A66BFF);
}QScrollBar::handle:horizontal:pressed {
    background: #34E4DE;
}QScrollBar::handle:vertical:disabled,
QScrollBar::handle:horizontal:disabled {
    background: rgba(166, 148, 160, 45);
}QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}/* =============================================================================
   Tabs
   ============================================================================= */
QTabWidget::pane {
    border: 1px solid #5A3340;
    border-top: 1px solid #8B4D48;
    background-color: #100D18;
}QTabWidget::tab-bar {
    alignment: left;
}QTabBar::tab {
    background-color: transparent;
    color: #C5B0BA;
    border: none;
    padding: 9px 16px;
    margin-right: 2px;
    border-bottom: 2px solid transparent;
}QTabBar::tab:hover {
    color: #A66BFF;
    background-color: #2A1B2D;
}QTabBar::tab:selected {
    color: #FFF4ED;
    border-bottom: 2px solid #34E4DE;
    background-color: #100D18;
}QTabBar::tab:selected:hover {
    background-color: #2A1B2D;
}QTabBar::tab:disabled {
    color: #998A96;
}/* =============================================================================
   Selection and Progress Controls
   ============================================================================= */
QGroupBox {
    border: 1px solid #8B4D48;
    border-radius: 8px;
    margin-top: 22px;
    padding: 4px;
    font-weight: bold;
}QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    margin-bottom: -20px;
    background-color: #100D18;
    color: #FFB55E;
}QGroupBox::title:disabled {
    color: #998A96;
}QCheckBox {
    spacing: 6px;
}QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: transparent;
    border: 1px solid #A694A0;
    border-radius: 8px;
}QCheckBox::indicator:hover {
    border-color: #D8C7CE;
}QCheckBox::indicator:pressed {
    background-color: #3A2235;
}QCheckBox::indicator:checked {
    background-color: #A8472B;
    border-color: #A8472B;
    image: url(:/icons/check.svg);
}QCheckBox::indicator:checked:hover {
    background-color: #833625;
    border-color: #833625;
}QCheckBox::indicator:disabled {
    border-color: #4A2939;
}QCheckBox::indicator:checked:disabled {
    background-color: #4A2939;
    border-color: #4A2939;
}QRadioButton {
    spacing: 6px;
}QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background-color: transparent;
    border: 1px solid #A694A0;
    border-radius: 9px;
}QRadioButton::indicator:hover {
    border-color: #D8C7CE;
}QRadioButton::indicator:pressed {
    background-color: #3A2235;
}QRadioButton::indicator:checked {
    background-color: #A8472B;
    border-color: #A8472B;
    image: url(:/icons/radio-dot.svg);
}QRadioButton::indicator:checked:hover {
    background-color: #833625;
    border-color: #833625;
}QRadioButton::indicator:disabled {
    border-color: #4A2939;
}QRadioButton::indicator:checked:disabled {
    background-color: #4A2939;
    border-color: #4A2939;
}QSlider::groove:horizontal {
    background: #4A2939;
    height: 6px;
    border-radius: 5px;
}QSlider::sub-page:horizontal {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                stop: 0 #FF934C,
                                stop: 0.36 #A8472B,
                                stop: 0.68 #A66BFF,
                                stop: 1 #34E4DE);
    border-radius: 5px;
}QSlider::handle:horizontal {
    background: #FFF8F3;
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 11px;
}QSlider::handle:horizontal:hover {
    background: #A66BFF;
    border: 2px solid #34E4DE;
}QSlider::groove:vertical {
    background: #4A2939;
    width: 6px;
    border-radius: 5px;
}QSlider::sub-page:vertical {
    background: qlineargradient(x1: 0, y1: 1, x2: 0, y2: 0,
                                stop: 0 #FF934C,
                                stop: 0.36 #A8472B,
                                stop: 0.68 #A66BFF,
                                stop: 1 #34E4DE);
    border-radius: 5px;
}QSlider::handle:vertical {
    background: #FFF4ED;
    width: 14px;
    height: 14px;
    margin: 0 -4px;
    border-radius: 11px;
}QSlider::handle:vertical:hover {
    background: #A66BFF;
    border: 2px solid #34E4DE;
}QSlider::groove:horizontal:disabled,
QSlider::groove:vertical:disabled {
    background: #1B1723;
}QSlider::handle:horizontal:disabled,
QSlider::handle:vertical:disabled {
    background: #998A96;
}QProgressBar {
    background-color: #030308;
    border: 1px solid #5A3340;
    border-radius: 8px;
    text-align: center;
    color: #FFF4ED;
}QProgressBar::chunk {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                stop: 0 #FF934C,
                                stop: 0.34 #A8472B,
                                stop: 0.66 #A66BFF,
                                stop: 1 #34E4DE);
    border-radius: 8px;
}QToolTip {
    background-color: #040307;
    color: #EDE4E7;
    border: 1px solid #8B4D48;
    border-radius: 8px;
    padding: 5px 8px;
}/* =============================================================================
   Status and Application Chrome
   ============================================================================= */
QLabel[status="active"] {
    color: #34DCCB;
    font-weight: bold;
}QLabel[status="loaded"],
QLabel[status="connected"] {
    color: #34DCCB;
    font-weight: 600;
}QLabel[status="inactive"] {
    color: #C5B0BA;
    font-weight: 600;
}QLabel[status="error"] {
    color: #FF7254;
    font-weight: bold;
}QLabel[status="warning"] {
    color: #FFB55E;
    font-weight: bold;
}QLabel[status="info"],
QLabel[status="empty"] {
    color: #C5B0BA;
    font-size: 7pt;
}QLabel[updateLabelClickable="true"] {
    color: #78F2EA;
    font-weight: 600;
}QLabel[updateLabelClickable="true"]:hover {
    color: #A66BFF;
}QStatusBar {
    background-color: #030308;
    color: #C5B0BA;
    border-top: 1px solid #5A3340;
}QWidget#appStatusBar {
    background-color: #030308;
    color: #C5B0BA;
    border-top: 1px solid #5A3340;
}QWidget#appStatusBar QLabel[statusBarLabel="true"] {
    background-color: transparent;
    padding: 2px 4px;
    font-size: 11px;
}QLabel#appMetricsLabel {
    color: #C5B0BA;
}QListWidget#preferencesCategoryList {
    background-color: transparent;
    border: none;
}QListWidget#preferencesCategoryList::item {
    padding-top: 11px;
    padding-bottom: 11px;
}QListWidget#preferencesCategoryList::item:hover {
    background-color: rgba(255, 248, 243, 22);
}QListWidget#preferencesCategoryList::item:selected {
    background-color: rgba(52, 228, 222, 52);
    color: #FFF4ED;
    border-left: 3px solid #A8472B;
}QPushButton#preferencesConfirmButton {
    padding-left: 21px;
    padding-right: 21px;
}/* =============================================================================
   Semantic Components
   ============================================================================= */
QLabel[role="heading"] {
    font-size: 13pt;
    font-weight: 600;
    color: #FFF4ED;
    background: transparent;
}QLabel[role="subheading"] {
    font-size: 10pt;
    font-weight: 600;
    color: #FFF4ED;
    background: transparent;
}QLabel[role="caption"] {
    font-size: 8pt;
    color: #C5B0BA;
    background: transparent;
}QLabel[role="muted"] {
    color: #D8C7CE;
    background: transparent;
}QLabel[accent="true"] {
    color: #78F2EA;
    background: transparent;
}QFrame[card="true"],
QLabel[card="true"] {
    background-color: rgba(16, 13, 24, 220);
    border: 1px solid #5A3340;
    border-radius: 8px;
}QGroupBox#onlineResourceCard {
    background-color: rgba(16, 13, 24, 220);
    border: 1px solid #8B4D48;
    border-radius: 8px;
    margin: 0px;
    padding: 0px;
}QGroupBox#onlineResourceCard:hover {
    border-color: #34E4DE;
}QGroupBox#onlineResourceCard .QWidget {
    background: transparent;
    border: none;
}QLabel#onlineResourceTitle {
    font-size: 12pt;
    font-weight: 600;
}QLabel[card="true"] {
    padding: 10px;
}QWidget#accountLoginCard {
    background-color: #100D18;
    border: 1px solid #8B4D48;
    border-radius: 8px;
}QFrame[card="true"] QLabel {
    background: transparent;
    border: none;
}QLabel[chip="true"] {
    background-color: #3A2235;
    border-radius: 8px;
    padding: 2px 8px;
    font-weight: 600;
}QGroupBox[titleless="true"] {
    margin-top: 0px;
    padding-top: 0px;
}QTabWidget[compactTabs="true"]::pane {
    border-radius: 0px 0px 6px 6px;
}QTabWidget[compactTabs="true"] QTabBar::tab {
    padding: 4px 10px;
    font-size: 11px;
    border-radius: 10px 6px 0px 0px;
}QWidget[statusChip] {
    border-radius: 8px;
    font-weight: 600;
}QWidget[statusChip="ok"] {
    background-color: rgba(52, 220, 203, 40);
    border: 1px solid rgba(52, 220, 203, 110);
}QWidget[statusChip="error"] {
    background-color: rgba(255, 114, 84, 40);
    border: 1px solid rgba(255, 114, 84, 110);
}QWidget[statusChip="warning"] {
    background-color: rgba(255, 181, 94, 40);
    border: 1px solid rgba(255, 181, 94, 110);
}QWidget[statusChip="info"] {
    background-color: rgba(166, 107, 255, 40);
    border: 1px solid rgba(166, 107, 255, 110);
}QWidget[statusChip="neutral"] {
    background-color: rgba(197, 176, 186, 40);
    border: 1px solid rgba(197, 176, 186, 110);
}QWidget[statusChip] QLabel {
    background: transparent;
    border: none;
}QWidget[statusChip="ok"] QLabel { color: #34DCCB; }QWidget[statusChip="error"] QLabel { color: #FF7254; }QWidget[statusChip="warning"] QLabel { color: #FFB55E; }QWidget[statusChip="info"] QLabel { color: #A66BFF; }QWidget[statusChip="neutral"] QLabel { color: #D8C7CE; }QFrame[class="memory-slot"] {
    background-color: #151023;
    border: 1px solid #8B4D48;
    border-radius: 8px;
}QFrame[class="memory-slot"][hasContent="true"] {
    background-color: #100D18;
}QFrame[class="memory-slot"][selected="true"] {
    border: 1px solid #34E4DE;
}QLabel#memorySlotNumber {
    font-size: 34px;
    font-weight: 700;
}QLabel[class="script-name"],
QLabel[class="device-name"] {
    color: #FFF4ED;
    font-weight: 600;
}QLabel[class="script-author"],
QLabel[class="input-translator-name"] {
    color: #C5B0BA;
}QLabel#memorySlotNumber:disabled,
QLabel[class="script-name"]:disabled,
QLabel[class="script-author"]:disabled,
QLabel[class="input-translator-name"]:disabled {
    color: #998A96;
}QPushButton#scriptCardLikeButton {
    background-color: #3A2235;
    border-radius: 8px;
    padding: 4px 10px;
    color: #FFF8F3;
}QPushButton#scriptCardLikeButton:hover {
    background-color: #B05435;
    color: #FFF8F3;
}QPushButton#scriptCardLikeButton:checked {
    background-color: #A8472B;
    color: #FFF8F3;
}QPushButton#scriptCardDownloadButton,
QPushButton#henvCardInstallButton,
QPushButton#uploadButton {
    background-color: #A8472B;
    color: #FFF8F3;
    font-weight: 600;
}QPushButton#scriptCardDownloadButton:hover,
QPushButton#henvCardInstallButton:hover,
QPushButton#uploadButton:hover {
    background-color: #833625;
    color: #FFF8F3;
}QToolButton#refreshButton {
    min-width: 30px;
    min-height: 30px;
    padding: 4px;
}/* =============================================================================
   Overlays and Glass
   ============================================================================= */
QLabel[overlay="true"] {
    background-color: rgba(6, 5, 9, 150);
    color: #FFF8F3;
    padding: 2px 8px;
    border-radius: 8px;
}QWidget[overlay="scrim"] {
    background-color: rgba(4, 3, 7, 156);
}QDialog[glassDialog="true"] {
    background-color: rgba(3, 3, 8, 205);
}QDialog[glassDialog="true"] .QWidget,
QDialog[glassDialog="true"] QScrollArea,
QDialog[glassDialog="true"] QStackedWidget,
QDialog[glassDialog="true"] QSplitter,
QDialog[glassDialog="true"] UserAccountWidget,
QDialog[glassDialog="true"] QLabel,
QDialog[glassDialog="true"] QCheckBox,
QDialog[glassDialog="true"] QRadioButton {
    background-color: transparent;
}QDialog[glassDialog="true"] QGroupBox {
    background-color: rgba(16, 13, 24, 176);
    border: 1px solid #8B4D48;
}QDialog[glassDialog="true"] QGroupBox::title {
    background-color: transparent;
}QDialog[glassDialog="true"] QTextEdit,
QDialog[glassDialog="true"] QPlainTextEdit,
QDialog[glassDialog="true"] QListWidget,
QDialog[glassDialog="true"] QTreeWidget,
QDialog[glassDialog="true"] QTableWidget {
    background-color: rgba(6, 5, 9, 166);
}/* Preferences is a custom top-level window, not glassDialog.  Helios currently
   paints its outer frame itself, so the theme also paints the large inner
   content canvas below. */
QWidget#preferencesDialog,
QDialog#preferencesDialog,
Helios--PreferencesDialog#preferencesDialog {
    background-color: #030308;

    color: #EDE4E7;
}QWidget#preferencesDialog .QWidget,
QWidget#preferencesDialog QScrollArea,
QWidget#preferencesDialog QSplitter,
QWidget#preferencesDialog QLabel,
QWidget#preferencesDialog QCheckBox,
QWidget#preferencesDialog QRadioButton {
    background-color: transparent;
}QWidget#preferencesDialog QStackedWidget {
    background-color: #030308;

    border: 1px solid rgba(244, 141, 91, 168);
    border-radius: 8px;
}QWidget#preferencesDialog > .QWidget {
    background-color: rgba(6, 5, 9, 230);
    border: 1px solid rgba(79, 190, 193, 150);
    border-radius: 8px;
}QWidget#preferencesDialog QListWidget#preferencesCategoryList {
    background-color: rgba(3, 3, 8, 182);
    border: 1px solid rgba(139, 77, 72, 190);
    border-radius: 8px;
    padding: 6px;
}QWidget#preferencesDialog QGroupBox {
    background-color: rgba(16, 13, 24, 198);
    border: 1px solid #8B4D48;
    border-radius: 8px;
}QWidget#preferencesDialog QGroupBox::title {
    background-color: transparent;
}QWidget#preferencesDialog QTextEdit,
QWidget#preferencesDialog QPlainTextEdit,
QWidget#preferencesDialog QListWidget,
QWidget#preferencesDialog QTreeWidget,
QWidget#preferencesDialog QTableWidget {
    background-color: rgba(6, 5, 9, 222);
}/* =============================================================================
   Interaction Contract
   ============================================================================= */
QHeaderView[sortable="true"]::section:hover,
QHeaderView[sortable="true"]::section:pressed {
    background-color: #2A1B2D;
    color: #FFF4ED;
}QSpinBox::up-button:pressed,
QDoubleSpinBox::up-button:pressed,
QDateTimeEdit::up-button:pressed,
QSpinBox::down-button:pressed,
QDoubleSpinBox::down-button:pressed,
QDateTimeEdit::down-button:pressed {
    background-color: #67271D;
}QSpinBox::up-button:disabled,
QDoubleSpinBox::up-button:disabled,
QDateTimeEdit::up-button:disabled,
QSpinBox::down-button:disabled,
QDoubleSpinBox::down-button:disabled,
QDateTimeEdit::down-button:disabled {
    background-color: transparent;
}QCheckBox:disabled,
QRadioButton:disabled {
    color: #998A96;
}QSlider::handle:horizontal:pressed,
QSlider::handle:vertical:pressed {
    background: #A8472B;
    border: 2px solid #FFF8F3;
}QSlider::sub-page:horizontal:disabled,
QSlider::sub-page:vertical:disabled {
    background: #998A96;
}QProgressBar:disabled {
    background-color: #1B1723;
    color: #998A96;
}QProgressBar::chunk:disabled {
    background-color: #998A96;
}QPushButton:focus,
QToolButton:focus {
    border: 1px solid #A66BFF;
}QLineEdit,
QSpinBox,
QDoubleSpinBox,
QTextEdit,
QPlainTextEdit {
    min-height: 20px;
}/* HELIOS ROUND COMBO ARROW BUTTON */
