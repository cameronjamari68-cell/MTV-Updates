/* =============================================================================
   Black Meridian Theme
   Canonical Helios widget contract with the original theme palette.
   ============================================================================= */
/* @token content-padding: 11 */
/* @token wallpaper: assets/black_meridian.svg */
/* @token wallpaper-mode: fill */
/* @token glass: dark */
/* @token icon-color: #f7f7f7 */
/* @token selection-icon-color: #ffffff */
/* @token active-icon-color: #ffffff */
/* @token error-icon-color: #ff8078 */

QLabel[logLevel="debug"] { color: #989898; }
QLabel[logLevel="info"] { color: #989898; }
QLabel[logLevel="warning"] { color: #ebc56c; font-weight: 600; }
QLabel[logLevel="error"] { color: #ff8078; font-weight: 600; }
QLabel[logLevel="critical"] { color: #ff8078; font-weight: 700; }
/* =============================================================================
   Global
   ============================================================================= */
QWidget {
    background-color: #000000;
    color: #F7F7F7;
    font-family: "Cascadia Mono", "Consolas", "Segoe UI", monospace;
    font-size: 9pt;
}QWidget:disabled {
    color: #989898;
}QWidget:focus {
    outline: none;
}QDialog {
    background-color: #000000;
    color: #F7F7F7;
}QWidget#loadingScreen {
    background: transparent;
    border: none;
}QFrame#loadingFrame {
    background-color: #0A0A0A;
    border: none;
    border-radius: 16px;
}QLabel,
QCheckBox,
QRadioButton {
    background-color: transparent;
}/* =============================================================================
   Main Window
   ============================================================================= */
QMainWindow {
    background-color: #000000;
}QMainWindow::separator {
    background: #050505;
    width: 5px;
    height: 5px;
}QMainWindow::separator:hover {
    background: #4A4A4A;
}QSplitter::handle {
    background-color: #000000;
}QSplitter::handle:hover {
    background-color: #4A4A4A;
}/* =============================================================================
   Dock Widgets
   ============================================================================= */
QDockWidget {
    background-color: #0A0A0A;
    border: 1px solid #050505;
    border-radius: 8px;
    titlebar-close-icon: url(:/icons/close.svg);
    titlebar-normal-icon: url(:/icons/float.svg);
}QDockWidget[panelDock="true"] {
    background-color: #0A0A0A;
    border-color: #050505;
}QDockWidget::title {
    background-color: #0A0A0A;
    color: #FFFFFF;
    padding: 5px 8px;
    font-weight: 600;
    border-bottom: 1px solid #050505;
}QWidget#dockTitleBar {
    background-color: #121212;
    border-bottom: 1px solid #050505;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
}QLabel#dockTitleLabel {
    background-color: transparent;
    color: #FFFFFF;
    font-weight: 600;
}QToolButton#dockFloatButton,
QToolButton#dockCloseButton {
    background-color: transparent;
    border: none;
    border-radius: 5px;
    padding: 4px;
}QToolButton#dockFloatButton:hover,
QToolButton#dockCloseButton:hover {
    background-color: #202020;
    color: #FFFFFF;
}QToolButton#dockFloatButton:pressed,
QToolButton#dockCloseButton:pressed {
    background-color: #2C2C2C;
}QDockWidget::close-button,
QDockWidget::float-button {
    background-color: transparent;
    border-radius: 4px;
    padding: 2px;
}QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #202020;
}/* =============================================================================
   Menus and Toolbars
   ============================================================================= */
QMenuBar {
    background-color: #050505;
    padding: 2px;
    border-bottom: 1px solid #050505;
}QMenuBar::item {
    padding: 4px 8px;
    background: transparent;
    border-radius: 4px;
}QMenuBar::item:selected {
    background-color: #202020;
    color: #FFFFFF;
}QMenuBar::item:pressed {
    background-color: #2C2C2C;
    color: #FFFFFF;
}QMenu {
    background-color: #0A0A0A;
    border: 1px solid #050505;
    border-radius: 8px;
    padding: 6px;
}QMenu[glassMenu="true"] {
    background-color: rgba(20, 21, 23, 93);
}QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
}QMenu::item:selected {
    background-color: #303030;
    color: #FFFFFF;
}QMenu::item:pressed {
    background-color: #4A4A4A;
    color: #FFFFFF;
}QMenu::item:disabled {
    background-color: transparent;
    color: #989898;
}QMenu::item:checked {
    color: #FFFFFF;
    font-weight: 600;
}QMenu::separator {
    height: 1px;
    background-color: #4A4A4A;
    margin: 4px 8px;
}QToolBar {
    background-color: #0A0A0A;
    border: none;
    border-bottom: 1px solid #050505;
    padding: 3px;
    spacing: 3px;
}QToolBar::separator {
    background-color: #4A4A4A;
    width: 1px;
    height: 1px;
    margin: 4px;
}QToolButton {
    background-color: transparent;
    border-radius: 6px;
    padding: 7px 8px;
    color: #FFFFFF;
}QToolButton:hover {
    background-color: #202020;
    color: #FFFFFF;
}QToolButton:pressed {
    background-color: #2C2C2C;
    color: #FFFFFF;
}QToolButton:checked {
    background-color: #2C2C2C;
    color: #FFFFFF;
}QToolButton:checked:hover {
    background-color: #4A4A4A;
    color: #FFFFFF;
}QToolButton:checked:pressed {
    background-color: #4A4A4A;
    color: #FFFFFF;
}QToolButton:disabled {
    background-color: transparent;
    color: #989898;
}/* =============================================================================
   Category Bar
   ============================================================================= */
QToolBar#activityBar {
    padding: 8px 6px;
    spacing: 8px;
}QToolBar#activityBar QToolButton {
    border-radius: 8px;
    padding: 7px 8px;
    min-width: 68px;
    min-height: 40px;
    color: #FFFFFF;
}QToolBar#activityBar QToolButton:hover {
    background-color: #202020;
    color: #FFFFFF;
}QToolBar#activityBar QToolButton:checked {
    background-color: #2C2C2C;
    color: #FFFFFF;
}QToolBar#activityBar QToolButton:checked:hover {
    background-color: #4A4A4A;
    color: #FFFFFF;
}QToolBar#activityBar QToolButton[statusPlaceholder="true"] {
    background-color: rgba(30, 31, 34, 190);
    color: #BDBDBD;
    border: 1px solid #4A4A4A;
}QToolBar#activityBar QToolButton[statusPlaceholder="true"]:hover {
    background-color: rgba(57, 60, 65, 220);
    color: #F7F7F7;
}QToolBar#activityBar QToolButton[statusPlaceholder="true"]::menu-indicator {
    image: none;
}/* =============================================================================
   Run Controls
   ============================================================================= */
QToolButton[runControl="start"],
QToolBar#activityBar QToolButton[runControl="start"] {
    background-color: #4A4A4A;
    color: #FFFFFF;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    padding: 0px;
}QToolButton[runControl="start"]:hover,
QToolBar#activityBar QToolButton[runControl="start"]:hover {
    background-color: #303030;
    color: #FFFFFF;
}QToolButton[runControl="start"]:pressed,
QToolBar#activityBar QToolButton[runControl="start"]:pressed {
    background-color: #1F1F1F;
    color: #FFFFFF;
}QToolButton[runControl="stop"],
QToolBar#activityBar QToolButton[runControl="stop"] {
    background-color: #FF8078;
    border: none;
    border-radius: 8px;
    padding: 0px;
}QToolButton[runControl="stop"]:hover,
QToolBar#activityBar QToolButton[runControl="stop"]:hover {
    background-color: #A83939;
}QToolButton[runControl="stop"]:pressed,
QToolBar#activityBar QToolButton[runControl="stop"]:pressed {
    background-color: #812A2A;
}QToolButton[runControl]:disabled,
QToolBar#activityBar QToolButton[runControl]:disabled {
    background-color: rgba(78, 80, 88, 70);
    color: rgba(255, 255, 255, 70);
}QToolBar#activityBar QToolButton[runGroup="idle"] {
    background-color: #4A4A4A;
    color: #FFFFFF;
    border: none;
}QToolBar#activityBar QToolButton[runGroup="idle"]:hover {
    background-color: #303030;
    color: #FFFFFF;
}QToolBar#activityBar QToolButton[runGroup="running"] {
    background-color: #FF8078;
    color: #000000;
    border: none;
}QToolBar#activityBar QToolButton[runGroup="running"]:hover {
    background-color: #A83939;
    color: #FFFFFF;
}/* =============================================================================
   Buttons
   ============================================================================= */
QPushButton {
    background-color: #1A1A1A;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 6px 13px;
    min-height: 22px;
}QPushButton:hover {
    background-color: #989898;
    color: #FFFFFF;
}QPushButton:pressed {
    background-color: #686868;
    color: #000000;
}QPushButton:checked {
    background-color: #4A4A4A;
    color: #FFFFFF;
}QPushButton:checked:hover {
    background-color: #303030;
    color: #FFFFFF;
}QPushButton:default,
QPushButton[class="primary"] {
    background-color: #4A4A4A;
    color: #FFFFFF;
}QPushButton:default:hover,
QPushButton[class="primary"]:hover {
    background-color: #303030;
    color: #FFFFFF;
}QPushButton:default:pressed,
QPushButton[class="primary"]:pressed,
QPushButton:checked:pressed {
    background-color: #1F1F1F;
    color: #FFFFFF;
}QPushButton:disabled {
    background-color: #222222;
    color: #989898;
}/* =============================================================================
   Inputs
   ============================================================================= */
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #050505;
    border: none;
    border-radius: 8px;
    padding: 4px 9px;
    selection-background-color: #4A4A4A;
    selection-color: #FFFFFF;
    color: #F7F7F7;
    min-height: 18px;
}QTextEdit#outputLog {
    background-color: #050505;
    color: #F7F7F7;
}QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateTimeEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    background-color: #121212;
}QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateTimeEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #4A4A4A;
    padding: 3px 8px;
}QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QDateTimeEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: #222222;
    color: #989898;
}QSpinBox::up-button,
QDoubleSpinBox::up-button,
QDateTimeEdit::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button,
QDateTimeEdit::down-button {
    background-color: transparent;
    border: none;
    width: 16px;
}QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QDateTimeEdit::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover,
QDateTimeEdit::down-button:hover {
    background-color: #202020;
}QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow,
QDateTimeEdit::up-arrow {
    image: url(:/icons/spinbox-up-arrow.svg);
    width: 10px;
    height: 10px;
}QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow,
QDateTimeEdit::down-arrow {
    image: url(:/icons/spinbox-down-arrow.svg);
    width: 10px;
    height: 10px;
}/* =============================================================================
   Lists, Trees, and Tables
   ============================================================================= */
QListView,
QTreeView,
QTableView {
    background-color: #0A0A0A;
    border: none;
    border-radius: 8px;
    outline: none;
    alternate-background-color: #000000;
}QListView:focus,
QTreeView:focus,
QTableView:focus {
    border: 1px solid #4A4A4A;
}QListView::item,
QTreeView::item,
QTableView::item {
    padding: 3px 4px;
    border: none;
    border-radius: 4px;
}QListView::item:hover,
QTreeView::item:hover,
QTableView::item:hover {
    background-color: #202020;
}QListView::item:selected,
QTreeView::item:selected,
QTableView::item:selected {
    background-color: #2C2C2C;
    color: #FFFFFF;
}QListView::item:disabled,
QTreeView::item:disabled,
QTableView::item:disabled {
    color: #989898;
}QTableView {
    gridline-color: #4A4A4A;
}QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/icons/tree-expand.svg);
}QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/icons/tree-collapse.svg);
}QHeaderView::section {
    background-color: #0A0A0A;
    color: #BDBDBD;
    border: none;
    border-bottom: 1px solid #050505;
    padding: 4px;
    font-weight: 600;
    font-size: 8pt;
}/* =============================================================================
   Scrollbars
   ============================================================================= */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 56);
    min-height: 20px;
    border-radius: 3px;
    margin: 2px;
}QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 56);
}QScrollBar::handle:vertical:pressed {
    background: rgba(255, 255, 255, 56);
}QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0px;
}QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 56);
    min-width: 20px;
    border-radius: 3px;
    margin: 2px;
}QScrollBar::handle:horizontal:hover {
    background: rgba(255, 255, 255, 56);
}QScrollBar::handle:horizontal:pressed {
    background: rgba(255, 255, 255, 56);
}QScrollBar::handle:vertical:disabled,
QScrollBar::handle:horizontal:disabled {
    background: rgba(128, 128, 128, 42);
}QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}/* =============================================================================
   Tabs
   ============================================================================= */
QTabWidget::pane {
    border: none;
    border-top: 1px solid #050505;
    background-color: #000000;
}QTabWidget::tab-bar {
    alignment: left;
}QTabBar::tab {
    background-color: transparent;
    color: #BDBDBD;
    border: none;
    padding: 7px 13px;
    margin-right: 2px;
    border-bottom: 2px solid transparent;
}QTabBar::tab:hover {
    color: #F7F7F7;
    background-color: #202020;
}QTabBar::tab:selected {
    color: #FFFFFF;
    border-bottom: 2px solid #4A4A4A;
    background-color: #000000;
}QTabBar::tab:selected:hover {
    background-color: #202020;
}QTabBar::tab:disabled {
    color: #989898;
}/* =============================================================================
   Selection and Progress Controls
   ============================================================================= */
QGroupBox {
    border: 1px solid #4A4A4A;
    border-radius: 8px;
    margin-top: 22px;
    padding: 4px;
    font-weight: bold;
}QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    margin-bottom: -20px;
    background-color: #000000;
    color: #FFFFFF;
}QGroupBox::title:disabled {
    color: #989898;
}QCheckBox {
    spacing: 6px;
}QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: transparent;
    border: 1px solid #686868;
    border-radius: 5px;
}QCheckBox::indicator:hover {
    border-color: #DDDDDD;
}QCheckBox::indicator:pressed {
    background-color: #2C2C2C;
}QCheckBox::indicator:checked {
    background-color: #4A4A4A;
    border-color: #4A4A4A;
    image: url(:/icons/check.svg);
}QCheckBox::indicator:checked:hover {
    background-color: #303030;
    border-color: #303030;
}QCheckBox::indicator:disabled {
    border-color: #1A1A1A;
}QCheckBox::indicator:checked:disabled {
    background-color: #1A1A1A;
    border-color: #1A1A1A;
}QRadioButton {
    spacing: 6px;
}QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background-color: transparent;
    border: 1px solid #686868;
    border-radius: 9px;
}QRadioButton::indicator:hover {
    border-color: #DDDDDD;
}QRadioButton::indicator:pressed {
    background-color: #2C2C2C;
}QRadioButton::indicator:checked {
    background-color: #4A4A4A;
    border-color: #4A4A4A;
    image: url(:/icons/radio-dot.svg);
}QRadioButton::indicator:checked:hover {
    background-color: #303030;
    border-color: #303030;
}QRadioButton::indicator:disabled {
    border-color: #1A1A1A;
}QRadioButton::indicator:checked:disabled {
    background-color: #1A1A1A;
    border-color: #1A1A1A;
}QSlider::groove:horizontal {
    background: #1A1A1A;
    height: 6px;
    border-radius: 3px;
}QSlider::sub-page:horizontal {
    background: #4A4A4A;
    border-radius: 3px;
}QSlider::handle:horizontal {
    background: #FFFFFF;
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
}QSlider::handle:horizontal:hover {
    background: #FFFFFF;
    border: 2px solid #4A4A4A;
}QSlider::groove:vertical {
    background: #1A1A1A;
    width: 6px;
    border-radius: 3px;
}QSlider::sub-page:vertical {
    background: #4A4A4A;
    border-radius: 3px;
}QSlider::handle:vertical {
    background: #FFFFFF;
    width: 14px;
    height: 14px;
    margin: 0 -4px;
    border-radius: 7px;
}QSlider::handle:vertical:hover {
    background: #FFFFFF;
    border: 2px solid #4A4A4A;
}QSlider::groove:horizontal:disabled,
QSlider::groove:vertical:disabled {
    background: #222222;
}QSlider::handle:horizontal:disabled,
QSlider::handle:vertical:disabled {
    background: #989898;
}QProgressBar {
    background-color: #050505;
    border: none;
    border-radius: 6px;
    text-align: center;
    color: #FFFFFF;
}QProgressBar::chunk {
    background-color: #4A4A4A;
    border-radius: 6px;
}QToolTip {
    background-color: #000000;
    color: #F7F7F7;
    border: none;
    border-radius: 6px;
    padding: 5px 8px;
}/* =============================================================================
   Status and Application Chrome
   ============================================================================= */
QLabel[status="active"] {
    color: #6ED3A0;
    font-weight: bold;
}QLabel[status="loaded"],
QLabel[status="connected"] {
    color: #6ED3A0;
    font-weight: 600;
}QLabel[status="inactive"] {
    color: #BDBDBD;
    font-weight: 600;
}QLabel[status="error"] {
    color: #FF8078;
    font-weight: bold;
}QLabel[status="warning"] {
    color: #EBC56C;
    font-weight: bold;
}QLabel[status="info"],
QLabel[status="empty"] {
    color: #BDBDBD;
    font-size: 7pt;
}QLabel[updateLabelClickable="true"] {
    color: #4A4A4A;
    font-weight: 600;
}QLabel[updateLabelClickable="true"]:hover {
    color: #303030;
}QStatusBar {
    background-color: #050505;
    color: #BDBDBD;
}QWidget#appStatusBar {
    background-color: #050505;
    color: #BDBDBD;
}QWidget#appStatusBar QLabel[statusBarLabel="true"] {
    background-color: transparent;
    padding: 2px 4px;
    font-size: 11px;
}QLabel#appMetricsLabel {
    color: #BDBDBD;
}QListWidget#preferencesCategoryList {
    background-color: transparent;
    border: none;
}QListWidget#preferencesCategoryList::item {
    padding-top: 11px;
    padding-bottom: 11px;
}QListWidget#preferencesCategoryList::item:hover {
    background-color: rgba(255, 255, 255, 56);
}QListWidget#preferencesCategoryList::item:selected {
    background-color: rgba(255, 255, 255, 56);
    color: #FFFFFF;
    border-left: 3px solid #4A4A4A;
}QPushButton#preferencesConfirmButton {
    padding-left: 21px;
    padding-right: 21px;
}/* =============================================================================
   Semantic Components
   ============================================================================= */
QLabel[role="heading"] {
    font-size: 13pt;
    font-weight: 600;
    color: #FFFFFF;
    background: transparent;
}QLabel[role="subheading"] {
    font-size: 10pt;
    font-weight: 600;
    color: #FFFFFF;
    background: transparent;
}QLabel[role="caption"] {
    font-size: 8pt;
    color: #BDBDBD;
    background: transparent;
}QLabel[role="muted"] {
    color: #DDDDDD;
    background: transparent;
}QLabel[accent="true"] {
    color: #4A4A4A;
    background: transparent;
}QFrame[card="true"],
QLabel[card="true"] {
    background-color: #0A0A0A;
    border: none;
    border-radius: 10px;
}QGroupBox#onlineResourceCard {
    background-color: #0A0A0A;
    border: 1px solid #555861;
    border-radius: 12px;
    margin: 0px;
    padding: 0px;
}QGroupBox#onlineResourceCard:hover {
    border-color: #6d78f5;
}QGroupBox#onlineResourceCard .QWidget {
    background: transparent;
    border: none;
}QLabel#onlineResourceTitle {
    font-size: 12pt;
    font-weight: 600;
}QLabel[card="true"] {
    padding: 10px;
}QWidget#accountLoginCard {
    background-color: #0A0A0A;
    border: 1px solid #4A4A4A;
    border-radius: 16px;
}QFrame[card="true"] QLabel {
    background: transparent;
    border: none;
}QLabel[chip="true"] {
    background-color: #2C2C2C;
    border-radius: 10px;
    padding: 2px 8px;
    font-weight: 600;
}QGroupBox[titleless="true"] {
    margin-top: 0px;
    padding-top: 0px;
}QTabWidget[compactTabs="true"]::pane {
    border-radius: 0px 0px 6px 6px;
}QTabWidget[compactTabs="true"] QTabBar::tab {
    padding: 4px 10px;
    font-size: 11px;
    border-radius: 6px 6px 0px 0px;
}QWidget[statusChip] {
    border-radius: 8px;
    font-weight: 600;
}QWidget[statusChip="ok"] {
    background-color: rgba(46, 160, 67, 40);
    border: 1px solid rgba(46, 160, 67, 110);
}QWidget[statusChip="error"] {
    background-color: rgba(229, 83, 75, 40);
    border: 1px solid rgba(229, 83, 75, 110);
}QWidget[statusChip="warning"] {
    background-color: rgba(240, 180, 41, 40);
    border: 1px solid rgba(240, 180, 41, 110);
}QWidget[statusChip="info"] {
    background-color: rgba(88, 101, 242, 40);
    border: 1px solid rgba(88, 101, 242, 110);
}QWidget[statusChip="neutral"] {
    background-color: rgba(148, 155, 164, 40);
    border: 1px solid rgba(148, 155, 164, 110);
}QWidget[statusChip] QLabel {
    background: transparent;
    border: none;
}QFrame[class="memory-slot"] {
    background-color: #121212;
    border: 1px solid #4A4A4A;
    border-radius: 8px;
}QFrame[class="memory-slot"][hasContent="true"] {
    background-color: #0A0A0A;
