/* =============================================================================
   HELIOS SELECTOR CONTRACT — copied from the final working JAJ selector behavior
   Applied cleanly to Black Meridian; previous conflicting ComboBox and managed-popup
   selectors were removed before this block. Theme colors are preserved.
   ============================================================================= */
QFrame[managedSelectorPopup="true"] {
    background-color: rgba(0, 0, 0, 220);
    border: 1px solid #686868;
    border-radius: 6px;
    padding: 4px;
}

QTreeView[managedSelectorItems="true"]::item {
    border-radius: 0;
    padding: 2px 4px;
}

QTreeView[managedSelectorItems="true"]::item:hover {
    background-color: rgba(255, 255, 255, 26);
    color: #FFFFFF;
}

QTreeView[managedSelectorItems="true"]::item:selected {
    background-color: rgba(255, 255, 255, 56);
    color: #FFFFFF;
}

QTreeView[managedSelectorItems="true"]::item:disabled {
    color: #777777;
}

QFrame#managedSelectorPopup {
    background-color: rgba(0, 0, 0, 220);
    color: #F7F7F7;
    border: 1px solid #686868;
    border-radius: 8px;
    padding: 0;
}

QTreeView[managedSelectorItems="true"],
QTreeView[managedSelectorItems="true"]:focus {
    background-color: rgba(0, 0, 0, 220);
    color: #F7F7F7;
    border: none;
    border-radius: 0;
    outline: none;
    padding: 4px;
}

QWidget[managedSelectorActions="true"] {
    background-color: rgba(0, 0, 0, 220);
    color: #F7F7F7;
    border: none;
}

QFrame[managedSelectorDivider="true"] {
    background-color: #686868;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

QWidget[managedSelectorRemoveCell="true"],
QToolButton[managedSelectorRemove="true"],
QToolButton[managedSelectorRemove="true"]:hover,
QToolButton[managedSelectorRemove="true"]:pressed,
QToolButton[managedSelectorRemove="true"]:focus {
    background-color: transparent;
    border: none;
    padding: 0;
}

QComboBox {
    min-width: 60px;
    min-height: 24px;
    padding: 4px 8px;
    background-color: rgba(0, 0, 0, 72);
    color: #F7F7F7;
    border: 1px solid #686868;
    border-radius: 4px;
    selection-background-color: #FFFFFF;
    selection-color: #FFFFFF;
}

QComboBox:hover {
    background-color: rgba(255, 255, 255, 48);
    border: 1px solid #FFFFFF;
}

QComboBox:on {
    background-color: rgba(255, 255, 255, 48);
    border: 1px solid #FFFFFF;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
    background-color: transparent;
}

QComboBox:hover::drop-down,
QComboBox:on::drop-down {
    background-color: rgba(255, 255, 255, 48);
}

QComboBox::down-arrow,
QComboBox:disabled::down-arrow,
QComboBox:hover::down-arrow,
QComboBox:on::down-arrow,
QComboBox::down-arrow:hover,
QComboBox::down-arrow:on,
QComboBox::down-arrow:open,
QComboBox::down-arrow:pressed {
    image: url(:/icons/arrow-down.svg);
    width: 10px;
    height: 10px;
    background: transparent;
    border: none;
}

QComboBox QAbstractItemView {
    background-color: rgba(0, 0, 0, 220);
    color: #F7F7F7;
    border: 1px solid #686868;
    border-radius: 4px;
    selection-background-color: #4A4A4A;
    selection-color: #FFFFFF;
    outline: none;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    padding: 2px 4px;
    border-radius: 3px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: rgba(255, 255, 255, 26);
    color: #FFFFFF;
}

QComboBox QAbstractItemView::item:disabled {
    color: #777777;
}

QComboBox:disabled {
    background-color: rgba(0, 0, 0, 40);
    color: #777777;
    border: 1px solid #3A3A3A;
    padding: 4px 8px;
}

QComboBox:disabled::drop-down {
    background-color: transparent;
}

QComboBox:focus {
    border-color: #FFFFFF;
}

/* Helios interaction states required by the theme contract. */
QMenuBar::item:disabled,
QListWidget::item:disabled,
QTreeWidget::item:disabled,
QTableWidget::item:disabled {
    color: #777777;
}

QCheckBox:focus::indicator,
QRadioButton:focus::indicator,
QTabBar::tab:focus {
    border-color: #FFFFFF;
}

QToolBar#activityBar QToolButton:pressed,
QToolBar#activityBar QToolButton:checked:pressed,
QPushButton#scriptCardLikeButton:pressed,
QPushButton#scriptCardDownloadButton:pressed,
QPushButton#henvCardInstallButton:pressed,
QPushButton#uploadButton:pressed {
    background-color: rgba(255, 255, 255, 56);
    color: #FFFFFF;
    border-color: #FFFFFF;
}

QToolBar#activityBar QToolButton:disabled,
QPushButton#scriptCardLikeButton:disabled,
QPushButton#scriptCardDownloadButton:disabled,
QPushButton#henvCardInstallButton:disabled,
QPushButton#uploadButton:disabled {
    background-color: rgba(0, 0, 0, 40);
    color: #777777;
    border-color: #3A3A3A;
}

QWidget#dockTitleBar QToolButton:hover {
    background-color: rgba(255, 255, 255, 48);
}

QComboBox:enabled:!hover:!focus:!on {
    background-color: rgba(0, 0, 0, 26);
}

QComboBox:enabled:hover:!on {
    background-color: rgba(0, 0, 0, 51);
}
