QSplitter::handle { background-color: transparent; }QSplitter::handle:horizontal {
    min-width: 5px;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 transparent, stop:.30 transparent, stop:.30 rgba(88, 88, 88, 55),
        stop:.40 #585858, stop:.50 #BFC5CB, stop:.60 #FFFFFF,
        stop:.70 rgba(255, 255, 255, 55), stop:.70 transparent, stop:1 transparent);
}QSplitter::handle:vertical {
    min-height: 5px;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 transparent, stop:.30 transparent, stop:.30 rgba(88, 88, 88, 55),
        stop:.40 #585858, stop:.50 #BFC5CB, stop:.60 #FFFFFF,
        stop:.70 rgba(255, 255, 255, 55), stop:.70 transparent, stop:1 transparent);
}QSplitter::handle:horizontal:hover,
QSplitter::handle:horizontal:pressed {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 transparent, stop:.26 transparent, stop:.26 rgba(88, 88, 88, 90),
        stop:.38 #585858, stop:.50 #BFC5CB, stop:.62 #FFFFFF,
        stop:.74 rgba(255, 255, 255, 90), stop:.74 transparent, stop:1 transparent);
}QSplitter::handle:vertical:hover,
QSplitter::handle:vertical:pressed {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 transparent, stop:.26 transparent, stop:.26 rgba(88, 88, 88, 90),
        stop:.38 #585858, stop:.50 #BFC5CB, stop:.62 #FFFFFF,
        stop:.74 rgba(255, 255, 255, 90), stop:.74 transparent, stop:1 transparent);
}QMainWindow::separator,
