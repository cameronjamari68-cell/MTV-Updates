    qproperty-icon: url(assets/vermyx_refresh_hover_new.svg); }
Helios--FileExplorerWidget Helios--ThemedToolButton { min-width: 32px; max-width: 32px; min-height: 32px; max-height: 32px;
    padding: 0px; background-color: rgba(28, 8, 14, 72); border: 1px solid #7B2536; border-radius: 6px;
    qproperty-icon: url(assets/vermyx_folder_new.svg); qproperty-iconSize: 18px 18px; }
Helios--FileExplorerWidget Helios--ThemedToolButton:hover { background-color: rgba(9, 2, 6, 148); border-color: #E21D48;
    qproperty-icon: url(assets/vermyx_folder_hover_new.svg); }

QDockWidget QComboBox { min-width: 132px; max-width: 16777215px; padding-left: 7px; padding-right: 27px; }
Helios--TitanBridgeWidget QComboBox { min-width: 152px; max-width: 16777215px; }

QGroupBox#onlineResourceCard { margin: 0px; padding: 1px 2px 1px 1px; border-left: 1px solid #7B2536; border-right: 2px solid #7B2536; border-radius: 12px; }
QGroupBox#onlineResourceCard .QWidget, QGroupBox#onlineResourceCard QWidget { background-color: transparent; border: none; }
QGroupBox#onlineResourceCard:hover { background-color: rgba(9, 2, 6, 148); border-color: #E21D48; }
QGroupBox#onlineResourceCard > QLabel, QGroupBox#onlineResourceCard QLabel[card="true"] { margin: 0px; padding: 0px 1px 0px 0px;
    border: none; border-right: 2px solid #7B2536; border-top-left-radius: 11px; border-top-right-radius: 11px;
    border-bottom-left-radius: 0px; border-bottom-right-radius: 0px; }

Helios--PreferencesDialog, Helios--PreferencesDialog#preferencesDialog,
QWidget#preferencesDialog, QDialog#preferencesDialog, QDialog[glassDialog="true"],
QMessageBox[glassDialog="true"], QInputDialog[glassDialog="true"], QColorDialog[glassDialog="true"] {
    background-color: rgba(18, 4, 10, 204); color: #FFE3E6; border: 1px solid #7B2536;
}
Helios--PreferencesDialog QWidget, Helios--PreferencesDialog QScrollArea,
Helios--PreferencesDialog QScrollArea > QWidget > QWidget, Helios--PreferencesDialog QStackedWidget,
Helios--PreferencesDialog QSplitter, Helios--PreferencesDialog QLabel, Helios--PreferencesDialog QCheckBox,
Helios--PreferencesDialog QRadioButton, QWidget#preferencesDialog .QWidget,
QWidget#preferencesDialog QScrollArea, QWidget#preferencesDialog QScrollArea > QWidget > QWidget,
QWidget#preferencesDialog QStackedWidget, QWidget#preferencesDialog QSplitter, QWidget#preferencesDialog QLabel,
QWidget#preferencesDialog QCheckBox, QWidget#preferencesDialog QRadioButton { background-color: transparent; }
Helios--PreferencesDialog QGroupBox, QWidget#preferencesDialog QGroupBox, QDialog[glassDialog="true"] QGroupBox {
    background-color: rgba(28, 8, 14, 72); color: #FFE3E6; border: 1px solid #7B2536; border-radius: 12px;
    margin-top: 26px; padding-top: 8px;
}
Helios--PreferencesDialog QGroupBox::title,
QWidget#preferencesDialog QGroupBox::title,
QDialog[glassDialog="true"] QGroupBox::title {
    subcontrol-origin: margin; subcontrol-position: top left;
    position: relative; top: -3px; left: 0px;
    background-color: transparent; color: #FFE3E6;
    border: none; padding: 0px 6px; margin-left: 5px; font-weight: 700;
}
QListWidget#preferencesCategoryList { background-color: rgba(28, 8, 14, 72); color: #FFE3E6; border: 1px solid #7B2536; border-radius: 6px; }

QToolTip { background-color: rgba(18, 4, 10, 204); color: #FFE3E6; border: 1px solid #E21D48; border-radius: 6px; padding: 5px 8px; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background-color: #E21D48; border-radius: 6px; min-height: 28px; min-width: 28px; }
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background-color: #FF6875; }

/* =============================================================================
   HELIOS II WIDGET CORNER + EXTERNAL TITLE GUTTER COMPATIBILITY
   Geometry-only final override: preserves this theme's palette and artwork.
   ============================================================================= */

QDockWidget,
QGroupBox,
QFrame[card="true"], QWidget[card="true"], QLabel[card="true"],
QFrame[panel="true"], QWidget[panel="true"],
QWidget#accountLoginCard,
QFrame[class="memory-slot"],
QFrame#managedSelectorPopup, QFrame[managedSelectorPopup="true"],
QFrame#loadingFrame {
    border-radius: 11px;
}

QTabWidget::pane {
    border-radius: 11px;
}

QWidget#dockTitleBar {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

QTabBar::tab {
    border-radius: 9px;
}

QGroupBox {
    margin-top: 26px;
    padding-top: 8px;
    padding-right: 6px;
    padding-bottom: 4px;
    padding-left: 6px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    position: relative;
    top: -6px;
    left: 0;
    margin-left: 6px;
    padding: 0 7px 4px 7px;
    background-color: transparent;
    border: none;
}

/* Image/resource cards are titleless and must retain their fitted image geometry. */
QGroupBox#onlineResourceCard {
    margin-top: 0;
    padding-top: 1px;
    padding-right: 2px;
    padding-bottom: 1px;
    padding-left: 1px;
    border-radius: 11px;
}

QGroupBox[titleless="true"] {
    margin-top: 0;
    padding-top: 6px;
    border-radius: 11px;
}

QGroupBox#onlineResourceCard > QLabel,
QGroupBox#onlineResourceCard QLabel[card="true"] {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

/* Preserve the complete glyph box and keep plugin text vertically centered. */
QLabel#dockTitleLabel, QWidget#dockTitleBar QLabel,
QLabel#onlineResourceTitle, QLabel[class="plugin-name"],
QLabel[class="script-name"], QLabel[class="device-name"],
QLabel[role="plugin-title"], QLabel[pluginTitle="true"],
QLabel[role="heading"] {
    padding-top: 0;
    padding-bottom: 0;
}

QDockWidget::title {
    padding-top: 3px;
    padding-right: 8px;
    padding-bottom: 7px;
    padding-left: 8px;
}

/* Preferences needs a slightly larger title gutter than compact plugin cards. */
Helios--PreferencesDialog QGroupBox,
QWidget#preferencesDialog QGroupBox,
QDialog[glassDialog="true"] QGroupBox {
    margin-top: 30px;
    padding-top: 9px;
    padding-right: 6px;
    padding-bottom: 4px;
    padding-left: 6px;
    border-radius: 11px;
}

Helios--PreferencesDialog QGroupBox::title,
QWidget#preferencesDialog QGroupBox::title,
QDialog[glassDialog="true"] QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    position: relative;
    top: -7px;
    left: 0;
    margin-left: 6px;
    padding: 0 7px 4px 7px;
    background-color: transparent;
    border: none;
}

/* Standard interactive surfaces should never fall back to square native corners. */
QPushButton, QToolButton, QLineEdit, QComboBox,
QSpinBox, QDoubleSpinBox, QDateTimeEdit {
    border-radius: 8px;
}

QTextEdit, QPlainTextEdit,
QListView, QTreeView, QTableView,
QListWidget, QTreeWidget, QTableWidget,
QMenu, QComboBox QAbstractItemView {
    border-radius: 9px;
}


/* Center-only gradient boundary cues for splitters and dock separators. */
QSplitter::handle { background-color: transparent; }
QSplitter::handle:horizontal {
    min-width: 5px;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 transparent, stop:.30 transparent, stop:.30 rgba(123, 37, 54, 55),
        stop:.40 #7B2536, stop:.50 #E21D48, stop:.60 #FFB0C0,
        stop:.70 rgba(255, 176, 192, 55), stop:.70 transparent, stop:1 transparent);
}
QSplitter::handle:vertical {
    min-height: 5px;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 transparent, stop:.30 transparent, stop:.30 rgba(123, 37, 54, 55),
        stop:.40 #7B2536, stop:.50 #E21D48, stop:.60 #FFB0C0,
        stop:.70 rgba(255, 176, 192, 55), stop:.70 transparent, stop:1 transparent);
}
QSplitter::handle:horizontal:hover, QSplitter::handle:horizontal:pressed {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 transparent, stop:.26 transparent, stop:.26 rgba(123, 37, 54, 90),
        stop:.38 #7B2536, stop:.50 #E21D48, stop:.62 #FFB0C0,
        stop:.74 rgba(255, 176, 192, 90), stop:.74 transparent, stop:1 transparent);
}
QSplitter::handle:vertical:hover, QSplitter::handle:vertical:pressed {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 transparent, stop:.26 transparent, stop:.26 rgba(123, 37, 54, 90),
        stop:.38 #7B2536, stop:.50 #E21D48, stop:.62 #FFB0C0,
        stop:.74 rgba(255, 176, 192, 90), stop:.74 transparent, stop:1 transparent);
}
QMainWindow::separator, QMainWindow::separator:hover {
    background: transparent;
    width: 5px;
    height: 5px;
}
QMainWindow::separator:horizontal {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 transparent, stop:.30 transparent, stop:.30 rgba(123, 37, 54, 55),
        stop:.40 #7B2536, stop:.50 #E21D48, stop:.60 #FFB0C0,
        stop:.70 rgba(255, 176, 192, 55), stop:.70 transparent, stop:1 transparent);
}
QMainWindow::separator:vertical {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 transparent, stop:.30 transparent, stop:.30 rgba(123, 37, 54, 55),
        stop:.40 #7B2536, stop:.50 #E21D48, stop:.60 #FFB0C0,
        stop:.70 rgba(255, 176, 192, 55), stop:.70 transparent, stop:1 transparent);
}
QMainWindow::separator:horizontal:hover {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 transparent, stop:.26 transparent, stop:.26 rgba(123, 37, 54, 90),
        stop:.38 #7B2536, stop:.50 #E21D48, stop:.62 #FFB0C0,
        stop:.74 rgba(255, 176, 192, 90), stop:.74 transparent, stop:1 transparent);
}
QMainWindow::separator:vertical:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 transparent, stop:.26 transparent, stop:.26 rgba(123, 37, 54, 90),
        stop:.38 #7B2536, stop:.50 #E21D48, stop:.62 #FFB0C0,
        stop:.74 rgba(255, 176, 192, 90), stop:.74 transparent, stop:1 transparent);
}

/* Final Helios shell curve and proportional arrow calibration. */
QComboBox::drop-down, QComboBox:disabled::drop-down,
QComboBox:hover::drop-down, QComboBox:on::drop-down {
    width: 24px;
    height: 24px;
    border-radius: 12px;
}

QComboBox::down-arrow, QComboBox:disabled::down-arrow,
QComboBox:hover::down-arrow, QComboBox:on::down-arrow,
QComboBox::down-arrow:hover, QComboBox::down-arrow:on,
QComboBox::down-arrow:open, QComboBox::down-arrow:pressed {
    width: 22px;
    height: 22px;
}

QDockWidget,
QFrame,
QGroupBox,
QStackedWidget,
QScrollArea,
QAbstractScrollArea,
QWidget[panel="true"], QFrame[panel="true"],
QWidget[card="true"], QFrame[card="true"],
QWidget[container="true"], QFrame[container="true"] {
    border-radius: 12px;
}

QTabWidget,
QTabWidget::pane,
Helios--TitanBridgeWidget QTabWidget,
Helios--TitanBridgeWidget QTabWidget::pane,
Helios--DSCaptureWidget QTabWidget,
Helios--DSCaptureWidget QTabWidget::pane,
Helios--MFCaptureWidget QTabWidget,
Helios--MFCaptureWidget QTabWidget::pane,
Helios--OnlineResourcesWidget QTabWidget,
Helios--OnlineResourcesWidget QTabWidget::pane {
    border-radius: 14px;
}

QWidget#dockTitleBar {
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

QTabBar::tab {
    border-radius: 9px;
}

/* Final live-widget title baseline correction: retain the title gutter but
   move the text below the clipping edge used by Helios plugin group boxes. */
QGroupBox::title {
    position: relative;
    top: 1px;
}

Helios--PreferencesDialog QGroupBox::title,
QWidget#preferencesDialog QGroupBox::title,
QDialog[glassDialog="true"] QGroupBox::title {
    position: relative;
    top: 1px;
}

/* Titan Bridge nested tab-surface correction. The pane and its internal
   stacked page must both be rounded; otherwise the page paints square
   pixels over the pane's lower corners. */
Helios--TitanBridgeWidget QTabWidget,
Helios--TitanBridgeWidget QTabWidget::pane,
Helios--TitanBridgeWidget QStackedWidget#qt_tabwidget_stackedwidget,
Helios--TitanBridgeWidget QStackedWidget#qt_tabwidget_stackedwidget > QWidget {
    border-radius: 14px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

Helios--TitanBridgeWidget QStackedWidget#qt_tabwidget_stackedwidget,
Helios--TitanBridgeWidget QStackedWidget#qt_tabwidget_stackedwidget > QWidget {
    background-color: transparent;
    border: none;
}

/* Live-verified Titan pane replacement: Qt paints the native tab-pane border
   square, so suppress it and place the themed rounded outline on the stacked
   page surface that occupies the same geometry. */
Helios--TitanBridgeWidget QTabWidget::pane {
    background-color: transparent;
    border: none;
}

Helios--TitanBridgeWidget QStackedWidget#qt_tabwidget_stackedwidget {
    background-color: transparent;
    border: 1px solid #7B2536;
    border-radius: 14px;
}

/* =============================================================================
   HACKER-REFERENCE WIDGET TEXT FIT OVERRIDE
   Matches the known-good Hacker by Kem text metrics and control spacing.
   Palette, borders, corner styling, images, and theme-specific artwork remain intact.
   ============================================================================= */

QWidget {
    font-family: "Consolas", "Courier New", monospace;
    font-size: 9pt;
}

QDockWidget::title {
    padding-top: 5px;
    padding-right: 8px;
    padding-bottom: 5px;
    padding-left: 8px;
}

QLabel#dockTitleLabel,
QWidget#dockTitleBar QLabel,
QLabel#onlineResourceTitle,
QLabel[class="plugin-name"],
QLabel[class="script-name"],
QLabel[class="device-name"],
QLabel[role="plugin-title"],
QLabel[pluginTitle="true"],
QLabel[role="heading"] {
    padding-top: 0px;
    padding-bottom: 0px;
}

QToolButton#dockFloatButton,
QToolButton#dockCloseButton {
    padding: 1px;
}

QMenu,
QFrame[managedSelectorPopup="true"],
