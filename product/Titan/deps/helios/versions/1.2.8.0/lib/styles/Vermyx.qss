    padding-right: 31px;
    padding-bottom: 4px;
    padding-left: 8px;
    min-height: 24px;
}

QComboBox QAbstractItemView::item {
    padding: 2px 4px;
}

QListView::item,
QTreeView::item,
QTableView::item,
QListWidget::item,
QTreeWidget::item,
QTableWidget::item {
    padding: 2px 3px;
}

QHeaderView::section {
    padding: 4px;
    font-size: 8pt;
}

QTabBar::tab {
    padding: 7px 13px;
    min-height: 0px;
}

QGroupBox {
    margin-top: 22px;
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    position: relative;
    top: 0px;
    left: 0px;
    margin-left: 0px;
    margin-bottom: -20px;
    padding-top: 0px;
    padding-right: 5px;
