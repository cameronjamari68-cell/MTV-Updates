QLabel[overlay="true"] {
    background-color: rgba(0, 0, 0, 130);
    color: #ffffff;
    padding: 2px 8px;
    border-radius: 4px;
}QWidget[overlay="scrim"] {
    background-color: rgba(8, 12, 16, 155);
