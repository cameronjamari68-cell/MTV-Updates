    padding-top: 0px;
    padding-bottom: 0px;
}QToolButton#dockFloatButton,
QToolButton#dockCloseButton {
    padding: 1px;
}QMenu {
    padding: 4px;
}QMenu::item {
    padding: 6px 24px;
}QToolButton {
    padding: 6px 6px;
}QToolBar#activityBar QToolButton {
    padding: 7px 8px;
    min-height: 40px;
}QPushButton {
    padding: 4px 12px;
    min-height: 22px;
}QLineEdit,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit,
