    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}/* Preserve the complete glyph box and keep plugin text vertically centered. */
QLabel#dockTitleLabel,
QWidget#dockTitleBar QLabel,
QLabel#onlineResourceTitle,
QLabel[class="plugin-name"],
QLabel[class="script-name"],
QLabel[class="device-name"],
QLabel[role="plugin-title"],
QLabel[pluginTitle="true"],
QLabel[role="heading"] {
    padding-top: 0;
    padding-bottom: 0;
}QDockWidget::title {
    padding-top: 3px;
    padding-right: 8px;
    padding-bottom: 7px;
    padding-left: 8px;
}/* Preferences needs a slightly larger title gutter than compact plugin cards. */
Helios--PreferencesDialog QGroupBox,
QWidget#preferencesDialog QGroupBox,
QDialog[glassDialog="true"] QGroupBox {
    margin-top: 30px;
    padding-top: 9px;
    padding-right: 6px;
    padding-bottom: 4px;
    padding-left: 6px;
    border-radius: 11px;
}Helios--PreferencesDialog QGroupBox::title,
QWidget#preferencesDialog QGroupBox::title,
QDialog[glassDialog="true"] QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    position: relative;
    top: -7px;
    left: 0;
    margin-left: 6px;
    padding: 0 7px 4px 7px;
    background-color: transparent;
    border: none;
}/* Standard interactive surfaces should never fall back to square native corners. */
QPushButton,
QToolButton,
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit {
    border-radius: 8px;
}QTextEdit,
QPlainTextEdit,
QListView,
QTreeView,
QTableView,
QListWidget,
QTreeWidget,
QTableWidget,
QMenu {
    border-radius: 9px;
}/* Center-only gradient boundary cues for splitters and dock separators. */
QSplitter::handle { background-color: transparent; }QSplitter::handle:horizontal {
    min-width: 5px;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 transparent, stop:.30 transparent, stop:.30 rgba(127, 147, 136, 55),
        stop:.40 #7F9388, stop:.50 #A7D8C0, stop:.60 #F0FFF8,
        stop:.70 rgba(240, 255, 248, 55), stop:.70 transparent, stop:1 transparent);
}QSplitter::handle:vertical {
    min-height: 5px;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 transparent, stop:.30 transparent, stop:.30 rgba(127, 147, 136, 55),
        stop:.40 #7F9388, stop:.50 #A7D8C0, stop:.60 #F0FFF8,
        stop:.70 rgba(240, 255, 248, 55), stop:.70 transparent, stop:1 transparent);
}QSplitter::handle:horizontal:hover,
QSplitter::handle:horizontal:pressed {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 transparent, stop:.26 transparent, stop:.26 rgba(127, 147, 136, 90),
        stop:.38 #7F9388, stop:.50 #A7D8C0, stop:.62 #F0FFF8,
        stop:.74 rgba(240, 255, 248, 90), stop:.74 transparent, stop:1 transparent);
}QSplitter::handle:vertical:hover,
QSplitter::handle:vertical:pressed {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 transparent, stop:.26 transparent, stop:.26 rgba(127, 147, 136, 90),
        stop:.38 #7F9388, stop:.50 #A7D8C0, stop:.62 #F0FFF8,
        stop:.74 rgba(240, 255, 248, 90), stop:.74 transparent, stop:1 transparent);
}QMainWindow::separator,
QMainWindow::separator:hover {
    background: transparent;
    width: 5px;
    height: 5px;
}QMainWindow::separator:horizontal {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 transparent, stop:.30 transparent, stop:.30 rgba(127, 147, 136, 55),
        stop:.40 #7F9388, stop:.50 #A7D8C0, stop:.60 #F0FFF8,
        stop:.70 rgba(240, 255, 248, 55), stop:.70 transparent, stop:1 transparent);
}QMainWindow::separator:vertical {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 transparent, stop:.30 transparent, stop:.30 rgba(127, 147, 136, 55),
        stop:.40 #7F9388, stop:.50 #A7D8C0, stop:.60 #F0FFF8,
        stop:.70 rgba(240, 255, 248, 55), stop:.70 transparent, stop:1 transparent);
}QMainWindow::separator:horizontal:hover {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 transparent, stop:.26 transparent, stop:.26 rgba(127, 147, 136, 90),
        stop:.38 #7F9388, stop:.50 #A7D8C0, stop:.62 #F0FFF8,
        stop:.74 rgba(240, 255, 248, 90), stop:.74 transparent, stop:1 transparent);
}QMainWindow::separator:vertical:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 transparent, stop:.26 transparent, stop:.26 rgba(127, 147, 136, 90),
        stop:.38 #7F9388, stop:.50 #A7D8C0, stop:.62 #F0FFF8,
        stop:.74 rgba(240, 255, 248, 90), stop:.74 transparent, stop:1 transparent);
}/* Final Helios shell curve and proportional arrow calibration. */
QDockWidget,
QFrame,
QGroupBox,
QStackedWidget,
QScrollArea,
QAbstractScrollArea,
QWidget[panel="true"],
QFrame[panel="true"],
QWidget[card="true"],
