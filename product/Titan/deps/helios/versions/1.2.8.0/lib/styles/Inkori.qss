}QLineEdit,
QSpinBox,
QDoubleSpinBox,
QTextEdit,
QPlainTextEdit {
    min-height: 18px;
}/* HELIOS ROUND COMBO ARROW BUTTON */
/* The drop-down is an independent Qt subcontrol, so it needs its own
   inset geometry and radius instead of inheriting the combo box shape. */
/* =============================================================================
   INKORI DESIGN LAYER
   Airy sumi-washi composition: black ink, rice paper, quiet celadon washes.
   ============================================================================= */
QWidget {
    background-color: transparent;
    color: #f1eee4;
    font-family: "Yu Gothic UI", "Meiryo UI", "Segoe UI";
    font-size: 9.5pt;
    selection-background-color: #a7d8c0;
    selection-color: #101613;
}QWidget:disabled { color: #8d928c; }QMainWindow { background-color: #111312; }QDialog { background-color: #151816; color: #f1eee4; }QMainWindow::separator,
QSplitter::handle { background-color: rgba(167, 216, 192, 105); width: 7px; height: 7px; }QMainWindow::separator:hover,
QSplitter::handle:hover { background-color: #a7d8c0; }QDockWidget,
QDockWidget[panelDock="true"] {
    background-color: rgba(16, 19, 17, 232);
    border: 1px solid #6f8278;
    border-radius: 18px;
}QDockWidget::title,
QWidget#dockTitleBar {
    background-color: rgba(241, 238, 228, 22);
    color: #f1eee4;
    border: none;
    border-bottom: 1px solid #82988d;
    border-top-left-radius: 17px;
    border-top-right-radius: 17px;
    padding: 8px 14px;
    font-weight: 500;
}QLabel#dockTitleLabel { color: #f1eee4; font-weight: 500; }QToolButton#dockFloatButton,
QToolButton#dockCloseButton { background-color: transparent; border: none; border-radius: 10px; padding: 5px; }QToolButton#dockFloatButton:hover,
QToolButton#dockCloseButton:hover { background-color: rgba(167, 216, 192, 52); color: #ffffff; }QMenuBar {
    background-color: rgba(12, 14, 13, 238);
    border: none;
    border-bottom: 1px solid #66776e;
    padding: 5px 10px;
}QMenuBar::item { background-color: transparent; color: #e8e5dc; padding: 6px 12px; border-radius: 10px; }QMenuBar::item:selected { background-color: rgba(167, 216, 192, 42); color: #ffffff; }QMenuBar::item:pressed { background-color: #a7d8c0; color: #101613; }QMenu,
QMenu[glassMenu="true"] {
    background-color: rgba(16, 20, 18, 230);

    border: 1px solid #82988d;
    border-radius: 16px;
    color: #f1eee4;
    padding: 9px;
}QMenu::item { background-color: transparent; color: #f1eee4; padding: 9px 30px 9px 14px; border-radius: 9px; }QMenu::item:selected { background-color: rgba(167, 216, 192, 52); color: #ffffff; border-left: 3px solid #a7d8c0; }QMenu::item:pressed,
QMenu::item:checked { background-color: #a7d8c0; color: #101613; }QMenu::item:disabled { color: #8d928c; }QMenu::separator { background-color: #63746b; height: 1px; margin: 7px 14px; }QToolBar,
QToolBar#activityBar {
    background-color: rgba(13, 16, 14, 230);
    border: none;
    border-bottom: 1px solid #66776e;
    spacing: 5px;
    padding: 5px 10px;
}QToolBar#activityBar QToolButton { background-color: transparent; border: none; border-radius: 10px; color: #d9ddd7; padding: 7px 15px; }QToolBar#activityBar QToolButton:hover { background-color: rgba(167, 216, 192, 40); color: #ffffff; }QToolBar#activityBar QToolButton:checked { background-color: rgba(167, 216, 192, 68); color: #d9ffe9; border-bottom: 2px solid #a7d8c0; }QPushButton,
QToolButton {
    background-color: rgba(241, 238, 228, 14);
    color: #f1eee4;
    border: 1px solid #778a80;
    border-radius: 10px;
    padding: 8px 18px;
    min-height: 24px;
    font-weight: 500;
}QPushButton:hover,
QToolButton:hover { background-color: rgba(167, 216, 192, 36); color: #ffffff; border-color: #c3ead7; }QPushButton:pressed,
QToolButton:pressed { background-color: #a7d8c0; color: #101613; border-color: #e7fff3; }QPushButton:checked,
QToolButton:checked { background-color: #cddbd4; color: #111814; border-color: #f1eee4; }QPushButton:default,
QPushButton[class="primary"],
