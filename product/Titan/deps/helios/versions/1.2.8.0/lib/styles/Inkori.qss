    padding: 0px; background-color: rgba(14, 23, 18, 66); border: 1px solid #7F9388; border-radius: 9px;
 qproperty-iconSize: 18px 18px; }Helios--FileExplorerWidget Helios--ThemedToolButton:hover { background-color: rgba(167, 216, 192, 30); border-color: #A7D8C0;
 }QGroupBox#onlineResourceCard { margin: 0px; padding: 1px 2px 1px 1px; border-left: 1px solid #7F9388; border-right: 2px solid #7F9388; border-radius: 18px; }QGroupBox#onlineResourceCard .QWidget { background-color: transparent; border: none; }QGroupBox#onlineResourceCard:hover { background-color: rgba(167, 216, 192, 30); border-color: #A7D8C0; }QGroupBox#onlineResourceCard > QLabel,
QGroupBox#onlineResourceCard QLabel[card="true"] { margin: 0px; padding: 0px 1px 0px 0px;
