}QListWidget#preferencesCategoryList { background-color: rgba(14, 23, 18, 66); color: #F1EEE4; border: 1px solid #7F9388; border-radius: 9px; }QToolTip { background-color: rgba(10, 18, 14, 190); color: #F1EEE4; border: 1px solid #A7D8C0; border-radius: 9px; padding: 5px 8px; }QScrollBar::handle:vertical,
QScrollBar::handle:horizontal { background-color: #A7D8C0; border-radius: 9px; min-height: 28px; min-width: 28px; }QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover { background-color: #E0FFF0; }QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:pressed { background-color: #59806d; }/* =============================================================================
   HELIOS II WIDGET CORNER + EXTERNAL TITLE GUTTER COMPATIBILITY
   Geometry-only final override: preserves this theme's palette and artwork.
   ============================================================================= */
QDockWidget,
QGroupBox,
QFrame[card="true"],
QWidget[card="true"],
QLabel[card="true"],
QFrame[panel="true"],
QWidget[panel="true"],
QWidget#accountLoginCard,
QFrame[class="memory-slot"],
QFrame#loadingFrame {
    border-radius: 11px;
}QTabWidget::pane {
    border-radius: 11px;
}QWidget#dockTitleBar {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}QTabBar::tab {
    border-radius: 9px;
}QGroupBox {
    margin-top: 26px;
    padding-top: 8px;
    padding-right: 6px;
    padding-bottom: 4px;
    padding-left: 6px;
}QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    position: relative;
    top: -6px;
    left: 0;
    margin-left: 6px;
    padding: 0 7px 4px 7px;
    background-color: transparent;
    border: none;
}/* Image/resource cards are titleless and must retain their fitted image geometry. */
QGroupBox#onlineResourceCard {
    margin-top: 0;
    padding-top: 1px;
    padding-right: 2px;
    padding-bottom: 1px;
    padding-left: 1px;
    border-radius: 11px;
}QGroupBox[titleless="true"] {
    margin-top: 0;
    padding-top: 6px;
    border-radius: 11px;
}QGroupBox#onlineResourceCard > QLabel,
