/* =============================================================================
   Inkori (New) — sumi ink and washi interface
   Canonical Helios contract + an airy ink-wash design layer.
   ============================================================================= */
/* @token content-padding: 18 */
/* @token wallpaper: assets/inkori.png */
/* @token wallpaper-mode: fill */
/* @token glass: dark */
/* @token icon-color: #dbdee1 */
/* @token selection-icon-color: #c3ead7 */
/* @token active-icon-color: #a7d8c0 */
/* @token error-icon-color: #de4b50 */

QLabel[logLevel="debug"] { color: #8d928c; }
QLabel[logLevel="info"] { color: #8d928c; }
QLabel[logLevel="warning"] { color: #f0b232; font-weight: 600; }
QLabel[logLevel="error"] { color: #de4b50; font-weight: 600; }
QLabel[logLevel="critical"] { color: #de4b50; font-weight: 700; }
/* =============================================================================
   Global
   ============================================================================= */
QWidget {
    background-color: #262c28;
    color: #dbdee1;
    font-family: "Segoe UI", "Roboto", "Helvetica Neue", sans-serif;
    font-size: 9pt;
}QWidget:disabled {
    color: #6d6f78;
}QWidget:focus {
    outline: none;
}QDialog {
    background-color: #262c28;
    color: #dbdee1;
}QWidget#loadingScreen {
    background: transparent;
    border: none;
}QFrame#loadingFrame {
    background-color: #212724;
    border: none;
    border-radius: 16px;
}QLabel,
QCheckBox,
QRadioButton {
    background-color: transparent;
}/* =============================================================================
   Main Window
   ============================================================================= */
QMainWindow {
    background-color: #262c28;
}QMainWindow::separator {
    background: #14181a;
    width: 5px;
    height: 5px;
}QMainWindow::separator:hover {
    background: #405047;
}QSplitter::handle {
    background-color: #262c28;
}QSplitter::handle:hover {
    background-color: #405047;
}/* =============================================================================
   Dock Widgets
   ============================================================================= */
QDockWidget {
    background-color: #212724;
    border: 1px solid #14181a;
    border-radius: 8px;
    titlebar-close-icon: url(:/icons/close.svg);
    titlebar-normal-icon: url(:/icons/float.svg);
}QDockWidget[panelDock="true"] {
    background-color: #212724;
    border-color: #14181a;
}QDockWidget::title {
    background-color: #212724;
    color: #f1eee4;
    padding: 5px 8px;
    font-weight: 600;
    border-bottom: 1px solid #14181a;
}QWidget#dockTitleBar {
    background-color: #191e1f;
    border-bottom: 1px solid #14181a;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
}QLabel#dockTitleLabel {
    background-color: transparent;
    color: #f1eee4;
    font-weight: 600;
}QToolButton#dockFloatButton,
QToolButton#dockCloseButton {
    background-color: transparent;
    border: none;
    border-radius: 5px;
    padding: 4px;
}QToolButton#dockFloatButton:hover,
QToolButton#dockCloseButton:hover {
    background-color: #2e3a33;
    color: #f1eee4;
}QToolButton#dockFloatButton:pressed,
QToolButton#dockCloseButton:pressed {
    background-color: #35443b;
}QDockWidget::close-button,
QDockWidget::float-button {
    background-color: transparent;
    border-radius: 4px;
    padding: 2px;
}QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #2e3a33;
}/* =============================================================================
   Menus and Toolbars
   ============================================================================= */
QMenuBar {
    background-color: #14181a;
    padding: 2px;
    border-bottom: 1px solid #14181a;
}QMenuBar::item {
    padding: 4px 8px;
    background: transparent;
    border-radius: 4px;
}QMenuBar::item:selected {
    background-color: #2e3a33;
    color: #f1eee4;
}QMenuBar::item:pressed {
    background-color: #35443b;
    color: #ffffff;
}QMenu {
    background-color: #212724;
    border: 1px solid #14181a;
    border-radius: 8px;
    padding: 6px;
}QMenu[glassMenu="true"] {
    background-color: rgba(20, 21, 23, 93);
}QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
}QMenu::item:selected {
    background-color: #346750;
    color: #ffffff;
}QMenu::item:pressed {
    background-color: #3f7a5e;
    color: #ffffff;
}QMenu::item:disabled {
    background-color: transparent;
    color: #6d6f78;
}QMenu::item:checked {
    color: #f1eee4;
    font-weight: 600;
}QMenu::separator {
    height: 1px;
    background-color: #333d37;
    margin: 4px 8px;
}QToolBar {
    background-color: #212724;
    border: none;
    border-bottom: 1px solid #14181a;
    padding: 3px;
    spacing: 3px;
}QToolBar::separator {
    background-color: #333d37;
    width: 1px;
    height: 1px;
    margin: 4px;
}QToolButton {
    background-color: transparent;
    border-radius: 6px;
    padding: 7px 8px;
    color: #ffffff;
}QToolButton:hover {
    background-color: #2e3a33;
    color: #ffffff;
}QToolButton:pressed {
    background-color: #35443b;
    color: #ffffff;
}QToolButton:checked {
    background-color: #35443b;
    color: #ffffff;
}QToolButton:checked:hover {
    background-color: #405047;
    color: #ffffff;
}QToolButton:checked:pressed {
    background-color: #3f7a5e;
    color: #ffffff;
}QToolButton:disabled {
    background-color: transparent;
    color: #6d6f78;
}/* =============================================================================
   Category Bar
   ============================================================================= */
QToolBar#activityBar {
    padding: 8px 6px;
    spacing: 8px;
}QToolBar#activityBar QToolButton {
    border-radius: 8px;
    padding: 7px 8px;
    min-width: 68px;
    min-height: 40px;
    color: #ffffff;
}QToolBar#activityBar QToolButton:hover {
    background-color: #2e3a33;
    color: #ffffff;
}QToolBar#activityBar QToolButton:checked {
    background-color: #35443b;
    color: #ffffff;
}QToolBar#activityBar QToolButton:checked:hover {
    background-color: #405047;
    color: #ffffff;
}QToolBar#activityBar QToolButton[statusPlaceholder="true"] {
    background-color: rgba(30, 31, 34, 190);
    color: #8d928c;
    border: 1px solid #333d37;
}QToolBar#activityBar QToolButton[statusPlaceholder="true"]:hover {
    background-color: rgba(57, 60, 65, 220);
    color: #dbdee1;
}QToolBar#activityBar QToolButton[statusPlaceholder="true"]::menu-indicator {
    image: none;
}/* =============================================================================
   Run Controls
   ============================================================================= */
QToolButton[runControl="start"],
QToolBar#activityBar QToolButton[runControl="start"] {
    background-color: #3f7a5e;
    color: #ffffff;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    padding: 0px;
}QToolButton[runControl="start"]:hover,
QToolBar#activityBar QToolButton[runControl="start"]:hover {
    background-color: #346750;
    color: #ffffff;
}QToolButton[runControl="start"]:pressed,
QToolBar#activityBar QToolButton[runControl="start"]:pressed {
    background-color: #2a5642;
    color: #ffffff;
}QToolButton[runControl="stop"],
QToolBar#activityBar QToolButton[runControl="stop"] {
    background-color: #da373c;
    border: none;
    border-radius: 8px;
    padding: 0px;
}QToolButton[runControl="stop"]:hover,
QToolBar#activityBar QToolButton[runControl="stop"]:hover {
    background-color: #a12828;
}QToolButton[runControl="stop"]:pressed,
QToolBar#activityBar QToolButton[runControl="stop"]:pressed {
    background-color: #8f2022;
}QToolButton[runControl]:disabled,
QToolBar#activityBar QToolButton[runControl]:disabled {
    background-color: rgba(64, 80, 71, 90);
    color: rgba(255, 255, 255, 70);
}QToolBar#activityBar QToolButton[runGroup="idle"] {
    background-color: #3f7a5e;
    color: #ffffff;
    border: none;
}QToolBar#activityBar QToolButton[runGroup="idle"]:hover {
    background-color: #346750;
    color: #ffffff;
}QToolBar#activityBar QToolButton[runGroup="running"] {
    background-color: #da373c;
    color: #000000;
    border: none;
}QToolBar#activityBar QToolButton[runGroup="running"]:hover {
    background-color: #a12828;
    color: #ffffff;
}/* =============================================================================
   Buttons
   ============================================================================= */
QPushButton {
    background-color: #46544c;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 6px 13px;
    min-height: 22px;
}QPushButton:hover {
    background-color: #6d6f78;
    color: #ffffff;
}QPushButton:pressed {
    background-color: #7f9388;
    color: #000000;
}QPushButton:checked {
    background-color: #3f7a5e;
    color: #ffffff;
}QPushButton:checked:hover {
    background-color: #346750;
    color: #ffffff;
}QPushButton:default,
QPushButton[class="primary"] {
    background-color: #3f7a5e;
    color: #ffffff;
}QPushButton:default:hover,
QPushButton[class="primary"]:hover {
    background-color: #346750;
    color: #ffffff;
}QPushButton:default:pressed,
QPushButton[class="primary"]:pressed,
QPushButton:checked:pressed {
    background-color: #2a5642;
    color: #ffffff;
}QPushButton:disabled {
    background-color: #2b332e;
    color: #6d6f78;
}/* =============================================================================
   Inputs
   ============================================================================= */
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #14181a;
    border: none;
    border-radius: 8px;
    padding: 4px 9px;
    selection-background-color: #3f7a5e;
    selection-color: #ffffff;
    color: #dbdee1;
    min-height: 18px;
}QTextEdit#outputLog {
    background-color: #14181a;
    color: #dbdee1;
}QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateTimeEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    background-color: #191e1f;
}QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateTimeEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #3f7a5e;
    padding: 3px 8px;
}QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QDateTimeEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: #2b332e;
    color: #6d6f78;
}QSpinBox::up-button,
QDoubleSpinBox::up-button,
QDateTimeEdit::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button,
QDateTimeEdit::down-button {
    background-color: transparent;
    border: none;
    width: 16px;
}QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QDateTimeEdit::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover,
QDateTimeEdit::down-button:hover {
    background-color: #2e3a33;
}QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow,
QDateTimeEdit::up-arrow {
    image: url(:/icons/spinbox-up-arrow.svg);
    width: 10px;
    height: 10px;
}QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow,
QDateTimeEdit::down-arrow {
    image: url(:/icons/spinbox-down-arrow.svg);
    width: 10px;
    height: 10px;
}/* =============================================================================
   Lists, Trees, and Tables
   ============================================================================= */
QListView,
QTreeView,
QTableView {
    background-color: #212724;
    border: none;
    border-radius: 8px;
    outline: none;
    alternate-background-color: #262c28;
}QListView:focus,
QTreeView:focus,
QTableView:focus {
    border: 1px solid #3f7a5e;
}QListView::item,
QTreeView::item,
QTableView::item {
    padding: 3px 4px;
    border: none;
    border-radius: 4px;
}QListView::item:hover,
QTreeView::item:hover,
QTableView::item:hover {
    background-color: #2e3a33;
}QListView::item:selected,
QTreeView::item:selected,
QTableView::item:selected {
    background-color: #35443b;
    color: #ffffff;
}QListView::item:disabled,
QTreeView::item:disabled,
QTableView::item:disabled {
    color: #6d6f78;
}QTableView {
    gridline-color: #333d37;
}QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/icons/tree-expand.svg);
}QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/icons/tree-collapse.svg);
}QHeaderView::section {
    background-color: #212724;
    color: #8d928c;
    border: none;
    border-bottom: 1px solid #14181a;
    padding: 4px;
    font-weight: 600;
    font-size: 8pt;
}/* =============================================================================
   Scrollbars
   ============================================================================= */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}QScrollBar::handle:vertical {
    background: rgba(128, 132, 142, 95);
    min-height: 20px;
    border-radius: 3px;
    margin: 2px;
}QScrollBar::handle:vertical:hover {
    background: rgba(128, 132, 142, 150);
}QScrollBar::handle:vertical:pressed {
    background: rgba(128, 132, 142, 190);
}QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0px;
}QScrollBar::handle:horizontal {
    background: rgba(128, 132, 142, 95);
    min-width: 20px;
    border-radius: 3px;
    margin: 2px;
}QScrollBar::handle:horizontal:hover {
    background: rgba(128, 132, 142, 150);
}QScrollBar::handle:horizontal:pressed {
    background: rgba(128, 132, 142, 190);
}QScrollBar::handle:vertical:disabled,
QScrollBar::handle:horizontal:disabled {
    background: rgba(128, 132, 142, 45);
}QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}/* =============================================================================
   Tabs
   ============================================================================= */
QTabWidget::pane {
    border: none;
    border-top: 1px solid #14181a;
    background-color: #262c28;
}QTabWidget::tab-bar {
    alignment: left;
}QTabBar::tab {
    background-color: transparent;
    color: #8d928c;
    border: none;
    padding: 7px 13px;
    margin-right: 2px;
    border-bottom: 2px solid transparent;
}QTabBar::tab:hover {
    color: #dbdee1;
    background-color: #2e3a33;
}QTabBar::tab:selected {
    color: #f1eee4;
    border-bottom: 2px solid #3f7a5e;
    background-color: #262c28;
}QTabBar::tab:selected:hover {
    background-color: #2e3a33;
}QTabBar::tab:disabled {
    color: #6d6f78;
}/* =============================================================================
   Selection and Progress Controls
   ============================================================================= */
QGroupBox {
    border: 1px solid #26282c;
    border-radius: 8px;
    margin-top: 22px;
    padding: 4px;
    font-weight: bold;
}QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    margin-bottom: -20px;
    background-color: #262c28;
    color: #f1eee4;
}QGroupBox::title:disabled {
    color: #6d6f78;
}QCheckBox {
    spacing: 6px;
}QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: transparent;
    border: 1px solid #7f9388;
    border-radius: 5px;
}QCheckBox::indicator:hover {
    border-color: #c5cfc4;
}QCheckBox::indicator:pressed {
    background-color: #35443b;
}QCheckBox::indicator:checked {
    background-color: #3f7a5e;
    border-color: #3f7a5e;
    image: url(:/icons/check.svg);
}QCheckBox::indicator:checked:hover {
    background-color: #346750;
    border-color: #346750;
}QCheckBox::indicator:disabled {
    border-color: #46544c;
}QCheckBox::indicator:checked:disabled {
    background-color: #46544c;
    border-color: #46544c;
}QRadioButton {
    spacing: 6px;
}QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background-color: transparent;
    border: 1px solid #7f9388;
    border-radius: 9px;
}QRadioButton::indicator:hover {
    border-color: #c5cfc4;
}QRadioButton::indicator:pressed {
    background-color: #35443b;
}QRadioButton::indicator:checked {
    background-color: #3f7a5e;
    border-color: #3f7a5e;
    image: url(:/icons/radio-dot.svg);
}QRadioButton::indicator:checked:hover {
    background-color: #346750;
    border-color: #346750;
}QRadioButton::indicator:disabled {
    border-color: #46544c;
}QRadioButton::indicator:checked:disabled {
    background-color: #46544c;
    border-color: #46544c;
}QSlider::groove:horizontal {
    background: #46544c;
    height: 6px;
    border-radius: 3px;
}QSlider::sub-page:horizontal {
    background: #3f7a5e;
    border-radius: 3px;
}QSlider::handle:horizontal {
    background: #ffffff;
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
}QSlider::handle:horizontal:hover {
    background: #f1eee4;
    border: 2px solid #3f7a5e;
}QSlider::groove:vertical {
    background: #46544c;
    width: 6px;
    border-radius: 3px;
}QSlider::sub-page:vertical {
    background: #3f7a5e;
    border-radius: 3px;
}QSlider::handle:vertical {
    background: #f1eee4;
    width: 14px;
    height: 14px;
    margin: 0 -4px;
    border-radius: 7px;
}QSlider::handle:vertical:hover {
    background: #f1eee4;
    border: 2px solid #3f7a5e;
}QSlider::groove:horizontal:disabled,
QSlider::groove:vertical:disabled {
    background: #2b332e;
}QSlider::handle:horizontal:disabled,
QSlider::handle:vertical:disabled {
    background: #6d6f78;
}QProgressBar {
    background-color: #14181a;
    border: none;
    border-radius: 6px;
    text-align: center;
    color: #f1eee4;
}QProgressBar::chunk {
    background-color: #3f7a5e;
    border-radius: 6px;
}QToolTip {
    background-color: #111214;
    color: #dbdee1;
    border: none;
    border-radius: 6px;
    padding: 5px 8px;
}/* =============================================================================
   Status and Application Chrome
   ============================================================================= */
QLabel[status="active"] {
    color: #23a55a;
    font-weight: bold;
}QLabel[status="loaded"],
QLabel[status="connected"] {
    color: #23a55a;
    font-weight: 600;
}QLabel[status="inactive"] {
    color: #8d928c;
    font-weight: 600;
}QLabel[status="error"] {
    color: #de4b50;
    font-weight: bold;
}QLabel[status="warning"] {
    color: #f0b232;
    font-weight: bold;
}QLabel[status="info"],
QLabel[status="empty"] {
    color: #8d928c;
    font-size: 7pt;
}QLabel[updateLabelClickable="true"] {
    color: #3f7a5e;
    font-weight: 600;
}QLabel[updateLabelClickable="true"]:hover {
    color: #346750;
}QStatusBar {
    background-color: #14181a;
    color: #8d928c;
}QWidget#appStatusBar {
    background-color: #14181a;
    color: #8d928c;
}QWidget#appStatusBar QLabel[statusBarLabel="true"] {
    background-color: transparent;
    padding: 2px 4px;
    font-size: 11px;
}QLabel#appMetricsLabel {
    color: #8d928c;
}QListWidget#preferencesCategoryList {
    background-color: transparent;
    border: none;
}QListWidget#preferencesCategoryList::item {
    padding-top: 11px;
    padding-bottom: 11px;
}QListWidget#preferencesCategoryList::item:hover {
    background-color: rgba(255, 255, 255, 22);
}QListWidget#preferencesCategoryList::item:selected {
    background-color: rgba(167, 216, 192, 72);
    color: #f1eee4;
    border-left: 3px solid #3f7a5e;
}QPushButton#preferencesConfirmButton {
    padding-left: 21px;
    padding-right: 21px;
}/* =============================================================================
   Semantic Components
   ============================================================================= */
QLabel[role="heading"] {
    font-size: 13pt;
    font-weight: 600;
    color: #f1eee4;
    background: transparent;
}QLabel[role="subheading"] {
    font-size: 10pt;
    font-weight: 600;
    color: #f1eee4;
    background: transparent;
}QLabel[role="caption"] {
    font-size: 8pt;
    color: #8d928c;
    background: transparent;
}QLabel[role="muted"] {
    color: #c5cfc4;
    background: transparent;
}QLabel[accent="true"] {
    color: #3f7a5e;
    background: transparent;
}QFrame[card="true"],
QLabel[card="true"] {
    background-color: #212724;
    border: none;
    border-radius: 10px;
}QGroupBox#onlineResourceCard {
    background-color: #212724;
    border: 1px solid #555861;
    border-radius: 12px;
    margin: 0px;
    padding: 0px;
}QGroupBox#onlineResourceCard:hover {
    border-color: #6d78f5;
}QGroupBox#onlineResourceCard .QWidget {
    background: transparent;
    border: none;
}QLabel#onlineResourceTitle {
    font-size: 12pt;
    font-weight: 600;
}QLabel[card="true"] {
    padding: 10px;
}QWidget#accountLoginCard {
    background-color: #212724;
    border: 1px solid #333d37;
    border-radius: 16px;
}QFrame[card="true"] QLabel {
    background: transparent;
    border: none;
}QLabel[chip="true"] {
    background-color: #35443b;
    border-radius: 10px;
    padding: 2px 8px;
    font-weight: 600;
}QGroupBox[titleless="true"] {
    margin-top: 0px;
    padding-top: 0px;
}QTabWidget[compactTabs="true"]::pane {
    border-radius: 0px 0px 6px 6px;
}QTabWidget[compactTabs="true"] QTabBar::tab {
    padding: 4px 10px;
    font-size: 11px;
    border-radius: 6px 6px 0px 0px;
}QWidget[statusChip] {
    border-radius: 8px;
    font-weight: 600;
}QWidget[statusChip="ok"] {
    background-color: rgba(46, 160, 67, 40);
    border: 1px solid rgba(46, 160, 67, 110);
}QWidget[statusChip="error"] {
    background-color: rgba(229, 83, 75, 40);
    border: 1px solid rgba(229, 83, 75, 110);
}QWidget[statusChip="warning"] {
    background-color: rgba(240, 180, 41, 40);
    border: 1px solid rgba(240, 180, 41, 110);
}QWidget[statusChip="info"] {
    background-color: rgba(88, 101, 242, 40);
    border: 1px solid rgba(88, 101, 242, 110);
}QWidget[statusChip="neutral"] {
    background-color: rgba(148, 155, 164, 40);
    border: 1px solid rgba(148, 155, 164, 110);
}QWidget[statusChip] QLabel {
    background: transparent;
    border: none;
}QFrame[class="memory-slot"] {
    background-color: #191e1f;
    border: 1px solid #333d37;
    border-radius: 8px;
